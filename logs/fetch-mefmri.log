import re
import sys
import xml.etree.ElementTree as ET
from datetime import datetime

esummary_path, efetch_path, out_path = sys.argv[1:4]

with open(esummary_path, 'r', encoding='utf-8') as f:
    es = json.load(f)

# Parse abstracts from efetch XML
abstract_by_pmid = {}
try:
    tree = ET.parse(efetch_path)
    root = tree.getroot()
    for art in root.findall('.//PubmedArticle'):
        pmid_el = art.find('.//MedlineCitation/PMID')
        if pmid_el is None or not (pmid_el.text or '').strip():
            continue
        pmid = pmid_el.text.strip()
        texts = []
        for ab in art.findall('.//Abstract/AbstractText'):
            label = ab.attrib.get('Label') or ab.attrib.get('NlmCategory')
            body = ''.join(ab.itertext()).strip()
            if not body:
                continue
            if label and label not in ('UNASSIGNED',):
                texts.append(f\"{label}: {body}\")
            else:
                texts.append(body)
        if texts:
            abstract_by_pmid[pmid] = '\\n'.join(texts)
except Exception:
    abstract_by_pmid = {}

result = es.get('result', {})
uids = result.get('uids', [])
articles = []

def normalize_date(raw: str) -> str:
    raw = (raw or '').strip()
    if not raw:
        return ''
    m = re.match(r'"'^('"\\d{4})/(\\d{2})/(\\d{2})', raw)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    m2 = re.match(r'"'^('"\\d{4})[-/](\\d{2})[-/](\\d{2})', raw)
    if m2:
        return f\"{m2.group(1)}-{m2.group(2)}-{m2.group(3)}\"
    for fmt in ('%Y %b %d', '%Y %B %d', '%Y %b', '%Y %B', '%Y'):
        try:
            dt = datetime.strptime(raw, fmt)
            if fmt == '%Y':
                return f\"{dt.year:04d}-01-01\"
            if fmt in ('%Y %b', '%Y %B'):
                return f\"{dt.year:04d}-{dt.month:02d}-01\"
            return dt.strftime('%Y-%m-%d')
        except ValueError:
            pass
    return ''

for uid in uids:
    rec = result.get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    edat = rec.get('edat') or ''
    pubdate = rec.get('pubdate') or ''
    published_date = normalize_date(edat) or normalize_date(pubdate) or '1970-01-01'
    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = (abstract_by_pmid.get(str(uid)) or '').strip() or 'No abstract available in source.'

    articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Multi-Echo fMRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': '2026-03-22'
    })

# Deduplicate in new batch by URL while preserving order
seen = set()
deduped = []
for a in articles:
    u = a.get('url', '')
    if not u or u in seen:
        continue
    seen.add(u)
    deduped.append(a)

payload = {'date': '2026-03-22', 'articles': deduped}
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(payload, f, ensure_ascii=False, indent=2)
PY
fi

# Merge with existing file if present, dedupe by url
if [ -f \""'$out_file" ]; then
  jq -s '"'
    def norm("'$d): if ($d|type)=="object" and ($d.articles|type)=="array" then $d else {date:"2026-03-22",articles:[]} end;
    (norm(.[0])) as $old |
    (norm(.[1])) as $new |
    {date:"2026-03-22", articles: (($old.articles + $new.articles) | unique_by(.url))}
  '"' \""'$out_file" "$tmpdir/new.json" > "$tmpdir/merged.json"
  mv "$tmpdir/merged.json" "$out_file"
else
  mv "$tmpdir/new.json" "$out_file"
fi

# Ensure top-level structure exactly required
jq '"'{date: .date, articles: .articles}' \""'$out_file" > "$tmpdir/final.json"
mv "$tmpdir/final.json" "$out_file"

# Print quick stats
