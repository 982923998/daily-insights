/bin/zsh -lc "python3 - <<'PY'
import json
import re
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY = '2026-02-28'
YESTERDAY = '2026-02-27'
ALLOWED = {TODAY, YESTERDAY}
CATEGORY = 'Brain MRI'
OUTPUT = Path('/Users/chenmayao/Projects/daily-insights/data/2026-02-28-brainmri.json')

esummary_path = Path('/tmp/brainmri_search/esummary.json')
efet_path = Path('/tmp/brainmri_search/efetch.xml')

month_map = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}

def parse_pubdate(pubdate: str) -> str:
    if not pubdate:
        return ''
    s = ' '.join(pubdate.replace(',', ' ').split())
    m = re.search(r'(\\d{4})(?:\\s+([A-Za-z]{3,9}))?(?:\\s+(\\d{1,2}))?', s)
    if not m:
        return ''
    year = int(m.group(1))
    mon_txt = (m.group(2) or '').lower()
    day_txt = m.group(3)
    month = month_map.get(mon_txt, 1)
    day = int(day_txt) if day_txt and day_txt.isdigit() else 1
    if day < 1:
        day = 1
    if day > 31:
        day = 31
    return f'{year:04d}-{month:02d}-{day:02d}'

def clean_text(text: str) -> str:
    return re.sub(r'\\s+', ' ', text or '').strip()

# Parse abstracts from efetch XML
abstract_map = {}
root = ET.parse(efet_path).getroot()
for article in root.findall('.//PubmedArticle'):
    pmid_node = article.find('.//MedlineCitation/PMID')
    if pmid_node is None or not (pmid_node.text and pmid_node.text.strip()):
        continue
    pmid = pmid_node.text.strip()
    sections = []
    for node in article.findall('.//Abstract/AbstractText'):
        text = ''.join(node.itertext()).strip()
        if not text:
            continue
        label = (node.attrib.get('Label') or '').strip()
        if label:
            sections.append(f'{label}: {text}')
        else:
            sections.append(text)
    abstract = clean_text(' '.join(sections))
    abstract_map[pmid] = abstract

summary_data = json.loads(esummary_path.read_text())
result = summary_data.get('result', {})
uids = result.get('uids', [])

new_articles = []
for uid in uids:
    item = result.get(uid, {})
    published_date = parse_pubdate(item.get('pubdate', ''))
    if published_date not in ALLOWED:
        continue
    title = clean_text(item.get('title', ''))
    journal = clean_text(item.get('source', ''))
    url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
    summary = abstract_map.get(uid, '')
    if not summary:
        summary = 'No abstract available in source.'
    article = {
        'title': title,
        'summary': summary,
        'url': url,
        'category': CATEGORY,
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': TODAY,
    }
    new_articles.append(article)

# De-duplicate by URL within new articles
