    'Jul': '07', 'Aug': '08', 'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'
}

def parse_pubdate(s: str) -> str:
    if not s:
        return ''
    s = s.strip()
    # Already ISO-ish prefix
    m = re.match(r'"'^('"\\d{4})[-/](\\d{2})(?:[-/](\\d{2}))?"'$'"', s)
    if m:
        y, mo, d = m.group(1), m.group(2), m.group(3) or '01'
        return f'{y}-{mo}-{d}'

    # Formats like: 2026 Mar 24 / 2026 Mar / 2026
    parts = s.split()
    if len(parts) >= 1 and re.fullmatch(r'\\d{4}', parts[0]):
        y = parts[0]
        if len(parts) == 1:
            return f'{y}-01-01'
        mon_raw = parts[1][:3]
        mo = month_map.get(mon_raw.capitalize())
        if mo:
            if len(parts) >= 3 and re.fullmatch(r'\\d{1,2}', parts[2]):
                d = f\"{int(parts[2]):02d}\"
                return f'{y}-{mo}-{d}'
            return f'{y}-{mo}-01'

    # Fallback: try find y-m-d anywhere
    m = re.search(r'(\\d{4})\\D(\\d{1,2})\\D(\\d{1,2})', s)
    if m:
        return f\"{m.group(1)}-{int(m.group(2)):02d}-{int(m.group(3)):02d}\"

    return ''

uids = es.get('result', {}).get('uids', [])
new_articles = []
for uid in uids:
    rec = es['result'].get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    published_date = parse_pubdate(rec.get('pubdate') or '')

    # Mandatory secondary filter: today or previous day only
    if published_date not in allowed:
        continue

    summary = abstract_by_pmid.get(uid, '').strip() or 'No abstract available in source.'
    article = {
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': TARGET_DATE.isoformat(),
    }
    new_articles.append(article)

# Load existing file if present and valid
existing = []
if os.path.exists(out_path):
    try:
        with open(out_path, 'r', encoding='utf-8') as f:
            obj = json.load(f)
            if isinstance(obj, dict) and isinstance(obj.get('articles'), list):
                existing = obj['articles']
    except Exception:
        existing = []

merged = []
seen = set()
for a in existing + new_articles:
