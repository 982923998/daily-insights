with open(esummary_path, '"'r', encoding='utf-8') as f:
    es = json.load(f)

# Build abstract map by PMID
abstract_map = {}
try:
    root = ET.parse(efetch_path).getroot()
    for art in root.findall('.//PubmedArticle'):
        pmid_el = art.find('.//MedlineCitation/PMID')
        if pmid_el is None or not (pmid_el.text and pmid_el.text.strip()):
            continue
        pmid = pmid_el.text.strip()
        parts = []
        for ab in art.findall('.//Abstract/AbstractText'):
            label = ab.attrib.get('Label', '').strip()
            text = ''.join(ab.itertext()).strip()
            if not text:
                continue
            parts.append(f\"{label}: {text}\" if label else text)
        abstract_map[pmid] = '\\n'.join(parts).strip()
except Exception:
    abstract_map = {}

month_map = {
    'jan':'01','feb':'02','mar':'03','apr':'04','may':'05','jun':'06',
    'jul':'07','aug':'08','sep':'09','oct':'10','nov':'11','dec':'12'
}

def norm_date(pubdate: str) -> str:
    if not pubdate:
        return ''
    s = pubdate.strip()
    # Already YYYY-MM-DD
    if re.match(r'"'^'"\\d{4}-\\d{2}-\\d{2}"'$'"', s):
        return s
    # YYYY/MM/DD
    m = re.match(r'"'^('"\\d{4})[\\/-](\\d{1,2})[\\/-](\\d{1,2})"'$'"', s)
    if m:
        y, mo, d = m.groups()
        return f\"{y}-{int(mo):02d}-{int(d):02d}\"
    # YYYY Mon DD
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})', s)
    if m:
        y, mon, d = m.groups()
        mo = month_map.get(mon.lower(), '')
        if mo:
            return f\"{y}-{mo}-{int(d):02d}\"
    # YYYY Mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})"'$'"', s)
    if m:
        y, mon = m.groups()
        mo = month_map.get(mon.lower(), '')
        if mo:
            return f\"{y}-{mo}-01\"
    # Mon DD, YYYY
    for fmt in ('%b %d, %Y','%B %d, %Y'):
        try:
            return datetime.strptime(s, fmt).strftime('%Y-%m-%d')
        except ValueError:
            pass
    # YYYY
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return f\"{m.group(1)}-01-01\"
    # fallback: extract first valid yyyy-mm-dd-like tokens
    m = re.search(r'(\\d{4})\\D(\\d{1,2})\\D(\\d{1,2})', s)
    if m:
        y, mo, d = m.groups()
        return f\"{y}-{int(mo):02d}-{int(d):02d}\"
    return ''

uids = es.get('result', {}).get('uids', [])
articles = []
for uid in uids:
    rec = es.get('result', {}).get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    pubdate = norm_date(rec.get('pubdate', ''))
    if pubdate not in (target_date, yesterday):
        continue
    summary = (abstract_map.get(uid) or '').strip() or 'No abstract available in source.'
    articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pubdate,
        'date': target_date,
    })

# Dedup by URL while preserving first occurrence
seen = set()
out = []
for a in articles:
    u = a.get('url', '')
    if not u or u in seen:
        continue
    seen.add(u)
    out.append(a)

with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
