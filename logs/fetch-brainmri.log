month_map = {
    'jan':1,'january':1,'feb':2,'february':2,'mar':3,'march':3,'apr':4,'april':4,
    'may':5,'jun':6,'june':6,'jul':7,'july':7,'aug':8,'august':8,'sep':9,'sept':9,
    'september':9,'oct':10,'october':10,'nov':11,'november':11,'dec':12,'december':12
}

def normalize_pubdate(s: str) -> str:
    s = (s or '').strip()
    if not s:
        return ''
    s = re.sub(r'\\s+', ' ', s)
    # Keep only first segment before ranges or punctuation
    s = re.split(r'[;]|\\b[Ee]pub\\b', s)[0].strip()
    s = s.replace('/', '-')

    for fmt in ('%Y-%m-%d', '%Y %b %d', '%Y %B %d'):
        try:
            return datetime.strptime(s, fmt).strftime('%Y-%m-%d')
        except ValueError:
            pass

    m = re.search(r'(\\d{4})-(\\d{1,2})-(\\d{1,2})', s)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return datetime(y, mo, d).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    m = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})', s)
    if m:
        y = int(m.group(1))
        mo = month_map.get(m.group(2).lower())
        d = int(m.group(3))
        if mo:
            try:
                return datetime(y, mo, d).strftime('%Y-%m-%d')
            except ValueError:
                return ''

    m = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})', s)
    if m:
        y = int(m.group(1))
        mo = month_map.get(m.group(2).lower())
        if mo:
            return f'{y:04d}-{mo:02d}-01'

    m = re.search(r'(\\d{4})', s)
    if m:
        return f'{int(m.group(1)):04d}-01-01'
    return ''

uids = es.get('result', {}).get('uids', []) or []
seen = set()
articles = []
for uid in uids:
    item = es.get('result', {}).get(uid, {}) or {}
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    published_date = normalize_pubdate(item.get('pubdate') or '')
    if published_date not in {today, yday}:
        continue
    url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
    if url in seen:
        continue
    seen.add(url)
    summary = (pmid_to_abs.get(str(uid)) or '').strip() or 'No abstract available in source.'
    articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': today,
    })

with open(out_path, 'w', encoding='utf-8') as f:
    json.dump({'date': today, 'articles': articles}, f, ensure_ascii=False, indent=2)
