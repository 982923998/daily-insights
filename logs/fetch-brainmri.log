curl -s \""'$ESEARCH_URL" > "$TMPDIR/esearch.json"
IDS="$(jq -r '"'.esearchresult.idlist[]?' \""'$TMPDIR/esearch.json" | paste -sd, -)"

if [ -z "$IDS" ]; then
  printf '"'{\"date\":\"%s\",\"articles\":[]}\\n' \""'$TODAY" > "$OUT"
  echo "WROTE_EMPTY"
  exit 0
fi

# Step 2: esummary
curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&id=${IDS}&retmode=json" > "$TMPDIR/esummary.json"

# Step 3: efetch abstract XML
curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=${IDS}&retmode=xml&rettype=abstract" > "$TMPDIR/efetch.xml"

# Parse abstract text per PMID
COUNT_RAW="$(xmllint --xpath '"'count(/PubmedArticleSet/PubmedArticle)' \""'$TMPDIR/efetch.xml" 2>/dev/null || echo 0)"
COUNT="${COUNT_RAW%.*}"
: "${COUNT:=0}"
> "$TMPDIR/abstracts.tsv"
if [ "$COUNT" -gt 0 ] 2>/dev/null; then
  i=1
  while [ "$i" -le "$COUNT" ]; do
    PMID="$(xmllint --xpath "string((/PubmedArticleSet/PubmedArticle)[$i]/MedlineCitation/PMID)" "$TMPDIR/efetch.xml" 2>/dev/null || true)"
    if [ -n "$PMID" ]; then
      ABS_XML="$(xmllint --xpath "(/PubmedArticleSet/PubmedArticle)[$i]/MedlineCitation/Article/Abstract" "$TMPDIR/efetch.xml" 2>/dev/null || true)"
      ABS_TXT="$(printf '"'%s' \""'$ABS_XML" | perl -0777 -pe '"'s/<["'^>]+>/ /g; s/&lt;/</g; s/&gt;/>/g; s/&amp;/&/g; s/['"\\t\\r\\n]+/ /g; s/\\s+/ /g; s/"'^'"\\s+|\\s+"'$//g'"')\"
      if [ -z \""'$ABS_TXT" ]; then
        ABS_TXT='"'No abstract available in source.'
      fi
      printf '%s\\t%s\\n' \""'$PMID" "$ABS_TXT" >> "$TMPDIR/abstracts.tsv"
    fi
    i=$((i+1))
  done
fi

jq -Rn '"'
  reduce inputs as "'$line ({};
    if ($line | length) == 0 then .
    else ($line | capture("''^(?<k>[''^'"\\\\t]+)\\\\t(?<v>.*)"'$")) as $m | .[$m.k] = $m.v
    end
  )
'"' < \""'$TMPDIR/abstracts.tsv" > "$TMPDIR/abstracts.json"

jq --arg today "$TODAY" --arg yesterday "$YESTERDAY" --argjson absMap "$(cat "$TMPDIR/abstracts.json")" '"'
  def mon: {Jan:\"01\",Feb:\"02\",Mar:\"03\",Apr:\"04\",May:\"05\",Jun:\"06\",Jul:\"07\",Aug:\"08\",Sep:\"09\",Oct:\"10\",Nov:\"11\",Dec:\"12\"};
  def pad2: tostring | if length==1 then \"0\" + . else . end;
  def norm_date("'$s):
    if ($s|type) != "string" then ""
    elif ($s|test("''^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) then ($s[0:10])
    elif (try ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3}) (?<d>[0-9]{1,2})")) catch null) then
      ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3}) (?<d>[0-9]{1,2})") | .y + "-" + (mon[.m] // "01") + "-" + (.d|pad2))
    elif (try ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3})")) catch null) then
      ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3})") | .y + "-" + (mon[.m] // "01") + "-01")
    elif (try ($s|capture("''^(?<y>[0-9]{4})")) catch null) then
      ($s|capture("''^(?<y>[0-9]{4})") | .y + "-01-01")
    else "" end;

  .result as $r
  | ($r.uids // [])
  | map(
      . as $id
      | $r[$id] as $it
      | {
          title: ($it.title // ""),
          summary: ($absMap[$id] // "No abstract available in source."),
          url: ("https://pubmed.ncbi.nlm.nih.gov/" + $id + "/"),
          category: "Brain MRI",
          source: "pubmed",
          journal: ($it.source // ""),
          published_date: norm_date($it.pubdate // ""),
          date: $today
        }
    )
  | map(select(.published_date == $today or .published_date == $yesterday))
