python3 - <<'PY'
import json
import re
from datetime import datetime
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY = \"2026-03-25\"
YESTERDAY = \"2026-03-24\"
ALLOWED_DATES = {TODAY, YESTERDAY}

esummary_path = Path('/tmp/brainmri_esummary.json')
efet_path = Path('/tmp/brainmri_efetch.xml')
out_path = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-25-brainmri.json')

with esummary_path.open('r', encoding='utf-8') as f:
    esummary = json.load(f)
result = esummary.get('result', {})
uids = result.get('uids', [])

month_map = {
    'jan': 1, 'january': 1, 'feb': 2, 'february': 2, 'mar': 3, 'march': 3,
    'apr': 4, 'april': 4, 'may': 5, 'jun': 6, 'june': 6, 'jul': 7, 'july': 7,
    'aug': 8, 'august': 8, 'sep': 9, 'sept': 9, 'september': 9, 'oct': 10,
    'october': 10, 'nov': 11, 'november': 11, 'dec': 12, 'december': 12,
}

def parse_pubdate(raw: str) -> str:
    if not raw:
        return ''
    s = raw.strip()
    m = re.search(r'(\\d{4})-(\\d{2})-(\\d{2})', s)
    if m:
        try:
            return datetime(*map(int, m.groups())).strftime('%Y-%m-%d')
        except ValueError:
            return ''
    m = re.search(r'(\\d{4})/(\\d{1,2})/(\\d{1,2})', s)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return datetime(y, mo, d).strftime('%Y-%m-%d')
        except ValueError:
            return ''
    m = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})', s)
    if m:
        y = int(m.group(1)); mo = month_map.get(m.group(2).lower()); d = int(m.group(3))
        if mo:
            try:
                return datetime(y, mo, d).strftime('%Y-%m-%d')
            except ValueError:
                return ''
    m = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})', s)
    if m:
        y = int(m.group(1)); mo = month_map.get(m.group(2).lower())
        if mo:
            try:
                return datetime(y, mo, 1).strftime('%Y-%m-%d')
            except ValueError:
                return ''
    m = re.search(r'(\\d{4})-(\\d{1,2})', s)
    if m:
        y, mo = map(int, m.groups())
        try:
            return datetime(y, mo, 1).strftime('%Y-%m-%d')
        except ValueError:
            return ''
    return ''

abstract_map = {}
if efet_path.exists() and efet_path.stat().st_size > 0:
    root = ET.parse(efet_path).getroot()
    for article in root.findall('.//PubmedArticle'):
        pmid_node = article.find('.//MedlineCitation/PMID')
        if pmid_node is None or not (pmid_node.text and pmid_node.text.strip()):
            continue
        pmid = pmid_node.text.strip()
        parts = []
        for ab in article.findall('.//Article/Abstract/AbstractText'):
            txt = ''.join(ab.itertext()).strip()
            if not txt:
                continue
            label = (ab.attrib.get('Label') or '').strip()
            if label and not txt.lower().startswith(label.lower() + ':'):
                parts.append(f'{label}: {txt}')
            else:
                parts.append(txt)
        if parts:
            abstract_map[pmid] = '\\n'.join(parts)

new_articles = []
for uid in uids:
    meta = result.get(uid, {})
    published_date = parse_pubdate((meta.get('pubdate') or '').strip())
    if published_date not in ALLOWED_DATES:
        continue
    summary = (abstract_map.get(uid) or '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': (meta.get('title') or '').strip(),
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': (meta.get('source') or '').strip(),
        'published_date': published_date,
        'date': TODAY,
    })

def normalize(a):
    pd = (a.get('published_date') or '').strip()
    if pd not in ALLOWED_DATES:
        return None
    s = (a.get('summary') or '').strip() or 'No abstract available in source.'
    return {
        'title': (a.get('title') or '').strip(),
        'summary': s,
        'url': (a.get('url') or '').strip(),
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': (a.get('journal') or '').strip(),
        'published_date': pd,
        'date': TODAY,
    }

existing_articles = []
if out_path.exists():
    try:
        with out_path.open('r', encoding='utf-8') as f:
            existing = json.load(f)
        if isinstance(existing, dict) and isinstance(existing.get('articles'), list):
            existing_articles = existing['articles']
    except Exception:
        existing_articles = []

merged = {}
for a in existing_articles:
    if isinstance(a, dict):
        n = normalize(a)
        if n and n['url']:
            merged[n['url']] = n

for a in new_articles:
    n = normalize(a)
    if n and n['url']:
        merged[n['url']] = n

articles = sorted(merged.values(), key=lambda x: (x['published_date'], x['title']), reverse=True)

with out_path.open('w', encoding='utf-8') as f:
    json.dump({'date': TODAY, 'articles': articles}, f, ensure_ascii=False, indent=2)

print(f'articles={len(articles)}')
