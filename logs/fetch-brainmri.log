import json
import xml.etree.ElementTree as ET
from datetime import datetime
import re

# Read esummary output
with open('/Users/chenmayao/.local/share/opencode/tool-output/tool_c975af22d001vctPS0nfYxAAlo', 'r') as f:
    summary_data = json.load(f)

# Parse efetch XML for abstracts
tree = ET.parse('/tmp/brainmri_abstracts.xml')
root = tree.getroot()

# Build abstracts dict
abstracts = {}
for article in root.findall('.//PubmedArticle'):
    pmid = article.find('.//PMID').text
    abstract_texts = article.findall('.//AbstractText')
    abstract = ' '.join([a.text for a in abstract_texts if a.text])
    abstracts[pmid] = abstract

# Process articles
articles = []
today = datetime(2026, 2, 26)
yesterday = today.replace(day=25)  # 2026-02-25
valid_dates = ['2026-02-26', '2026-02-25']

result = summary_data.get('result', {})

for pmid in result.get('uids', []):
    if pmid not in result:
        continue
    item = result[pmid]
    pubdate = item.get('pubdate', '')
    
    # Parse date: "2026 Feb 25" -> "2026-02-25"
    try:
        if pubdate:
            # Try full date format
            match = re.match(r'(\d{4})\s+(\w+)\s+(\d+)', pubdate)
            if match:
                year, month, day = match.groups()
                month_map = {'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04', 'May': '05', 'Jun': '06',
                            'Jul': '07', 'Aug': '08', 'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'}
                published_date = f"{year}-{month_map.get(month, '01')}-{int(day):02d}"
            else:
                # Handle year-month format
                parts = pubdate.split()
                if len(parts) == 2:
                    year, month = parts
                    month_map = {'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04', 'May': '05', 'Jun': '06',
                                'Jul': '07', 'Aug': '08', 'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'}
                    published_date = f"{year}-{month_map.get(month, '01')}-01"
                else:
                    published_date = pubdate
        else:
            published_date = ''
    except Exception as e:
        published_date = pubdate
    
    # Filter: only keep articles published today or yesterday
    if published_date not in valid_dates:
        continue
    
    article = {
        'title': item.get('title', ''),
        'summary': abstracts.get(pmid, '')[:500],
        'url': f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': item.get('source', ''),
        'published_date': published_date,
        'date': '2026-02-26'
    }
    articles.append(article)

print(json.dumps({'date': '2026-02-26', 'articles': articles}, indent=2))
