import json
import os
import re
import sys
import xml.etree.ElementTree as ET

esummary_path, efetch_path, out_file, today, yesterday = sys.argv[1:6]

with open(esummary_path, '"'r', encoding='utf-8') as f:
    esummary = json.load(f)

abstract_map = {}
try:
    tree = ET.parse(efetch_path)
    root = tree.getroot()
    for article in root.findall('.//PubmedArticle'):
        pmid_elem = article.find('.//MedlineCitation/PMID')
        if pmid_elem is None or pmid_elem.text is None:
            continue
        pmid = pmid_elem.text.strip()
        parts = []
        for abs_text in article.findall('.//Abstract/AbstractText'):
            text = ''.join(abs_text.itertext()).strip()
            if not text:
                continue
            label = abs_text.attrib.get('Label', '').strip()
            text = ' '.join(text.split())
            if label and not text.lower().startswith(label.lower() + ':'):
                text = f\"{label}: {text}\"
            parts.append(text)
        if parts:
            abstract_map[pmid] = ' '.join(parts)
except ET.ParseError:
    pass

month_map = {
    'jan': '01', 'january': '01',
    'feb': '02', 'february': '02',
    'mar': '03', 'march': '03',
    'apr': '04', 'april': '04',
    'may': '05',
    'jun': '06', 'june': '06',
    'jul': '07', 'july': '07',
    'aug': '08', 'august': '08',
    'sep': '09', 'sept': '09', 'september': '09',
    'oct': '10', 'october': '10',
    'nov': '11', 'november': '11',
    'dec': '12', 'december': '12',
}
season_map = {
    'spring': '03',
    'summer': '06',
    'fall': '09',
    'autumn': '09',
    'winter': '12',
}

def parse_pubdate(pubdate: str, sortpubdate: str) -> str:
    if sortpubdate:
        m = re.match(r'"'^('"\\d{4})/(\\d{2})/(\\d{2})', sortpubdate)
        if m:
            return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"

    s = (pubdate or '').strip().replace(',', ' ')
    s = re.sub(r'\\s+', ' ', s)
    if not s:
        return ''

    year_match = re.search(r'\\b(19|20)\\d{2}\\b', s)
    if not year_match:
        return ''
    year = year_match.group(0)

    tokens = s.split()
    try:
        yidx = tokens.index(year)
    except ValueError:
        yidx = 0

    month = None
    day = '01'

    if yidx + 1 < len(tokens):
        mtok = tokens[yidx + 1].split('-')[0].strip('.').lower()
        month = month_map.get(mtok) or season_map.get(mtok)

    if month and yidx + 2 < len(tokens):
        dtok = tokens[yidx + 2].split('-')[0]
        if re.fullmatch(r'\\d{1,2}', dtok):
            day = f\"{int(dtok):02d}\"

    if month:
        return f\"{year}-{month}-{day}\"

    return f\"{year}-01-01\"

result = esummary.get('result', {})
uids = result.get('uids', [])
new_articles = []
for uid in uids:
    rec = result.get(uid, {})
    published_date = parse_pubdate(rec.get('pubdate', ''), rec.get('sortpubdate', ''))
    if published_date not in {today, yesterday}:
        continue

    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    summary = (abstract_map.get(uid) or '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': today,
    })

existing_articles = []
if os.path.exists(out_file):
    try:
        with open(out_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
            if isinstance(data, dict) and isinstance(data.get('articles'), list):
                existing_articles = data['articles']
    except Exception:
        existing_articles = []

merged = []
seen = {}
for article in new_articles + existing_articles:
    url = article.get('url', '').strip()
    if not url:
        continue
    if url not in seen:
        seen[url] = len(merged)
        merged.append(article)
    else:
        idx = seen[url]
        old_summary = merged[idx].get('summary', '')
        new_summary = article.get('summary', '')
        if old_summary == 'No abstract available in source.' and new_summary "'!= '"'No abstract available in source.':
            merged[idx] = article

merged.sort(key=lambda x: (x.get('published_date', ''), x.get('title', '')), reverse=True)

output = {
    'date': today,
    'articles': merged,
}

with open(out_file, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f\"ID_COUNT={len(uids)}\")
print(f\"FILTERED_NEW={len(new_articles)}\")
print(f\"MERGED_TOTAL={len(merged)}\")
PY

