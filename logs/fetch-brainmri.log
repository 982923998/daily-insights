import json
import os
import re
import sys
import xml.etree.ElementTree as ET
from datetime import datetime

esummary_path, efetch_path, target_path, today, yesterday = sys.argv[1:6]

MONTHS = {
    '"'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}


def normalize_pubdate(pubdate: str) -> str:
    if not pubdate:
        return \"\"
    s = pubdate.strip()
    s = s.split(';')[0].strip()
    s = s.split('(')[0].strip()
    s = re.sub(r'\\s+', ' ', s)

    for fmt in (\"%Y-%m-%d\", \"%Y/%m/%d\", \"%Y %b %d\", \"%Y %B %d\"):
        try:
            return datetime.strptime(s, fmt).strftime(\"%Y-%m-%d\")
        except ValueError:
            pass

    for fmt in (\"%Y %b\", \"%Y %B\"):
        try:
            dt = datetime.strptime(s, fmt)
            return dt.strftime(\"%Y-%m-01\")
        except ValueError:
            pass

    if re.fullmatch(r\"\\d{4}\", s):
        return f\"{s}-01-01\"

    m = re.match(r\""'^('"\\d{4})\\s+([A-Za-z]{3,9})(?:\\s+(\\d{1,2}))?\", s)
    if m:
        year = int(m.group(1))
        month_name = m.group(2).lower()
        day = int(m.group(3)) if m.group(3) else 1
        month = MONTHS.get(month_name)
        if month:
            try:
                return datetime(year, month, day).strftime(\"%Y-%m-%d\")
            except ValueError:
                return \"\"

    m2 = re.match(r\""'^('"\\d{4})[-/](\\d{1,2})(?:[-/](\\d{1,2}))?\", s)
    if m2:
        year = int(m2.group(1))
        month = int(m2.group(2))
        day = int(m2.group(3)) if m2.group(3) else 1
        try:
            return datetime(year, month, day).strftime(\"%Y-%m-%d\")
        except ValueError:
            return \"\"

    return \"\"


def load_esummary(path: str):
    with open(path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    result = data.get('result', {})
    uids = result.get('uids', [])
    entries = []
    for uid in uids:
        item = result.get(uid, {})
        title = (item.get('title') or '').strip()
        journal = (item.get('source') or '').strip()
        published_date = normalize_pubdate((item.get('pubdate') or '').strip())
        url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
        entries.append({
            'uid': uid,
            'title': title,
            'journal': journal,
            'published_date': published_date,
            'url': url,
        })
    return entries


def load_abstracts(path: str):
    abstracts = {}
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        return abstracts
    try:
        tree = ET.parse(path)
    except ET.ParseError:
        return abstracts
    root = tree.getroot()

    for article in root.findall('.//PubmedArticle'):
        pmid_el = article.find('.//MedlineCitation/PMID')
        if pmid_el is None or pmid_el.text is None:
            continue
        pmid = pmid_el.text.strip()
        texts = []
        for abst in article.findall('.//Abstract/AbstractText'):
            txt = ''.join(abst.itertext()).strip()
            if txt:
                texts.append(txt)
        if texts:
            abstracts[pmid] = ' '.join(texts)

    for article in root.findall('.//PubmedBookArticle'):
        pmid_el = article.find('.//BookDocument/PMID')
        if pmid_el is None or pmid_el.text is None:
            continue
        pmid = pmid_el.text.strip()
        texts = []
        for abst in article.findall('.//Abstract/AbstractText'):
            txt = ''.join(abst.itertext()).strip()
            if txt:
                texts.append(txt)
        if texts:
            abstracts[pmid] = ' '.join(texts)

    return abstracts


def normalize_existing_article(a: dict, today_value: str):
    url = (a.get('url') or '').strip()
    title = (a.get('title') or '').strip()
    summary = (a.get('summary') or '').strip() or 'No abstract available in source.'

    source = (a.get('source') or '').strip()
    journal = (a.get('journal') or '').strip()
    if not journal and source and source.lower() "'!= '"'pubmed':
        journal = source
    source = 'pubmed'

    published_date = (a.get('published_date') or '').strip()

    return {
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Brain MRI',
        'source': source,
        'journal': journal,
        'published_date': published_date,
        'date': today_value,
    }


summary_entries = load_esummary(esummary_path)
abstract_map = load_abstracts(efetch_path)

allowed_dates = {today, yesterday}
new_articles = []
for e in summary_entries:
    if e['published_date'] not in allowed_dates:
        continue

    summary = abstract_map.get(e['uid'], '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': e['title'],
        'summary': summary,
        'url': e['url'],
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': e['journal'],
        'published_date': e['published_date'],
        'date': today,
    })

existing_articles = []
if os.path.exists(target_path):
    try:
        with open(target_path, 'r', encoding='utf-8') as f:
            existing = json.load(f)
        if isinstance(existing, dict):
            existing_articles = existing.get('articles', []) or []
    except Exception:
        existing_articles = []

merged = []
seen_urls = set()
for item in existing_articles + new_articles:
    if not isinstance(item, dict):
        continue
    normalized = normalize_existing_article(item, today)
    url = normalized['url']
    if not url or url in seen_urls:
        continue
    if normalized['published_date'] not in allowed_dates:
        continue
    seen_urls.add(url)
    merged.append(normalized)

output = {
    'date': today,
    'articles': merged,
}

os.makedirs(os.path.dirname(target_path), exist_ok=True)
with open(target_path, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(json.dumps({'written': target_path, 'count': len(merged)}, ensure_ascii=False))
