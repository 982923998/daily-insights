import json
import os
import re
import sys
import xml.etree.ElementTree as ET
from datetime import date

today, prev_day, esummary_path, efetch_path, out_file = sys.argv[1:6]
allowed_dates = {today, prev_day}

month_map = {
    '"'Jan': 1, 'Feb': 2, 'Mar': 3, 'Apr': 4, 'May': 5, 'Jun': 6,
    'Jul': 7, 'Aug': 8, 'Sep': 9, 'Oct': 10, 'Nov': 11, 'Dec': 12,
}

def parse_pubdate(raw):
    if not raw:
        return ''
    text = raw.strip()
    text = text.split(';')[0].strip()
    text = text.replace(',', ' ')
    text = re.sub(r'\\s+', ' ', text)
    tokens = text.split(' ')
    if not tokens or not re.fullmatch(r'\\d{4}', tokens[0]):
        return ''
    year = int(tokens[0])
    if len(tokens) == 1:
        try:
            return date(year, 1, 1).isoformat()
        except ValueError:
            return ''

    month_tok = tokens[1].split('-')[0][:3].title()
    if month_tok.isdigit():
        month = int(month_tok)
    else:
        month = month_map.get(month_tok)
    if not month or month < 1 or month > 12:
        return ''

    day = 1
    if len(tokens) >= 3:
        day_tok = tokens[2].split('-')[0]
        day_digits = ''.join(ch for ch in day_tok if ch.isdigit())
        if day_digits:
            day = int(day_digits)

    try:
        return date(year, month, day).isoformat()
    except ValueError:
        return ''

# Parse abstracts by PMID
abstract_map = {}
try:
    root = ET.parse(efetch_path).getroot()
except ET.ParseError:
    root = ET.Element('PubmedArticleSet')

for article in root.findall('.//PubmedArticle'):
    pmid = article.findtext('.//MedlineCitation/PMID')
    if not pmid:
        continue
    parts = []
    for abs_text in article.findall('.//Abstract/AbstractText'):
        txt = ''.join(abs_text.itertext()).strip()
        if not txt:
            continue
        label = abs_text.attrib.get('Label', '').strip()
        if label and not txt.lower().startswith(label.lower() + ':'):
            parts.append(f\"{label}: {txt}\")
        else:
            parts.append(txt)
    abstract_map[pmid] = ' '.join(parts).strip()

# Parse esummary metadata
with open(esummary_path, 'r', encoding='utf-8') as f:
    try:
        summary_data = json.load(f)
    except json.JSONDecodeError:
        summary_data = {}

result = summary_data.get('result', {}) if isinstance(summary_data, dict) else {}
uids = result.get('uids', []) if isinstance(result, dict) else []

new_articles = []
seen_new = set()
for uid in uids:
    rec = result.get(str(uid), {})
    if not isinstance(rec, dict):
        continue
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    published_date = parse_pubdate((rec.get('pubdate') or '').strip())
    if published_date not in allowed_dates:
        continue

    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    if url in seen_new:
        continue
    seen_new.add(url)

    abstract = (abstract_map.get(str(uid)) or '').strip()
    if not abstract:
        abstract = 'No abstract available in source.'

    new_articles.append({
        'title': title,
        'summary': abstract,
        'url': url,
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': today,
    })

# Merge with existing output (if any) and dedupe by url
existing_articles = []
if os.path.exists(out_file):
    try:
        with open(out_file, 'r', encoding='utf-8') as f:
            existing_data = json.load(f)
        if isinstance(existing_data, dict) and isinstance(existing_data.get('articles'), list):
            existing_articles = existing_data['articles']
    except Exception:
        existing_articles = []

merged = []
seen_urls = set()
for article in new_articles + existing_articles:
    if not isinstance(article, dict):
        continue
    url = article.get('url', '')
    if not url or url in seen_urls:
        continue
    # normalize required fields
    normalized = {
        'title': str(article.get('title', '') or ''),
        'summary': str(article.get('summary', '') or 'No abstract available in source.'),
        'url': url,
        'category': 'Brain MRI',
        'source': str(article.get('source', '') or 'pubmed'),
        'journal': str(article.get('journal', '') or ''),
        'published_date': str(article.get('published_date', '') or ''),
        'date': today,
    }
    if not normalized['summary'].strip():
        normalized['summary'] = 'No abstract available in source.'
    seen_urls.add(url)
    merged.append(normalized)

out = {
    'date': today,
    'articles': merged,
}

os.makedirs(os.path.dirname(out_file), exist_ok=True)
with open(out_file, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(f\"new_articles={len(new_articles)}\")
print(f\"merged_articles={len(merged)}\")
print(out_file)
