import json
import re
from datetime import datetime
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY = \"2026-03-25\"
YESTERDAY = \"2026-03-24\"
ALLOWED_DATES = {TODAY, YESTERDAY}

esummary_path = Path('/tmp/brainmri_esummary.json')
efet_path = Path('/tmp/brainmri_efetch.xml')
out_path = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-25-brainmri.json')

with esummary_path.open('r', encoding='utf-8') as f:
    esummary = json.load(f)

result = esummary.get('result', {})
uids = result.get('uids', [])

month_map = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}

def parse_pubdate(raw: str) -> str:
    if not raw:
        return ''
    s = raw.strip()

    iso = re.search(r'(\\d{4})-(\\d{2})-(\\d{2})', s)
    if iso:
        y, m, d = map(int, iso.groups())
        try:
            return datetime(y, m, d).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    slash = re.search(r'(\\d{4})/(\\d{1,2})/(\\d{1,2})', s)
    if slash:
        y, m, d = map(int, slash.groups())
        try:
            return datetime(y, m, d).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    m1 = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})', s)
    if m1:
        y = int(m1.group(1))
        mon = month_map.get(m1.group(2).lower())
        d = int(m1.group(3))
        if mon:
            try:
                return datetime(y, mon, d).strftime('%Y-%m-%d')
            except ValueError:
                return ''

    m2 = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})', s)
    if m2:
        y = int(m2.group(1))
        mon = month_map.get(m2.group(2).lower())
        if mon:
            try:
                return datetime(y, mon, 1).strftime('%Y-%m-%d')
            except ValueError:
                return ''

    m3 = re.search(r'(\\d{4})-(\\d{1,2})', s)
    if m3:
        y = int(m3.group(1))
        mon = int(m3.group(2))
        try:
            return datetime(y, mon, 1).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    return ''

# Build PMID -> abstract map
abstract_map = {}
if efet_path.exists() and efet_path.stat().st_size > 0:
    tree = ET.parse(efet_path)
    root = tree.getroot()

    for article in root.findall('.//PubmedArticle'):
        pmid_node = article.find('.//MedlineCitation/PMID')
        if pmid_node is None or not (pmid_node.text and pmid_node.text.strip()):
            continue
        pmid = pmid_node.text.strip()

        texts = []
        for ab in article.findall('.//Article/Abstract/AbstractText'):
            raw_text = ''.join(ab.itertext()).strip()
            if not raw_text:
                continue
            label = (ab.attrib.get('Label') or '').strip()
            if label and not raw_text.lower().startswith(label.lower() + ':'):
                texts.append(f\"{label}: {raw_text}\")
            else:
                texts.append(raw_text)

        if texts:
            abstract_map[pmid] = '\\n'.join(texts)

new_articles = []
for uid in uids:
    meta = result.get(uid, {})
    title = (meta.get('title') or '').strip()
    journal = (meta.get('source') or '').strip()
    pubdate_raw = (meta.get('pubdate') or '').strip()
    published_date = parse_pubdate(pubdate_raw)

    # Required secondary filter: keep only today or previous day
    if published_date not in ALLOWED_DATES:
        continue

    summary = (abstract_map.get(uid) or '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': TODAY,
    })

def normalize_article(a: dict) -> dict:
    summary = (a.get('summary') or '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    journal = (a.get('journal') or '').strip()

    return {
        'title': (a.get('title') or '').strip(),
        'summary': summary,
        'url': (a.get('url') or '').strip(),
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': (a.get('published_date') or '').strip(),
        'date': TODAY,
    }

existing_articles = []
if out_path.exists():
    try:
        with out_path.open('r', encoding='utf-8') as f:
