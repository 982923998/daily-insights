exec
/bin/zsh -lc 'set -euo pipefail
TODAY="2026-03-27"
YESTERDAY="2026-03-26"
OUT="/Users/chenmayao/Projects/daily-insights/data/2026-03-27-brainmri.json"
TMPDIR="/tmp/brainmri-$$"
mkdir -p "$TMPDIR"

TERM_ENC='"'(%22Brain%22%5BMesh%5D+OR+brain*%5BTitle%2FAbstract%5D+OR+cerebr*%5BTitle%2FAbstract%5D+OR+encephalon%5BTitle%2FAbstract%5D+OR+intracranial%5BTitle%2FAbstract%5D)+AND+(%22Magnetic+Resonance+Imaging%22%5BMesh%5D+OR+%22MRI%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance%22%5BTitle%2FAbstract%5D+OR+%22fMRI%22%5BTitle%2FAbstract%5D+OR+%22DTI%22%5BTitle%2FAbstract%5D+OR+%22diffusion+tensor%22%5BTitle%2FAbstract%5D+OR+%22VBM%22%5BTitle%2FAbstract%5D+OR+%22voxel-based+morphometry%22%5BTitle%2FAbstract%5D+OR+%22connectome%22%5BTitle%2FAbstract%5D+OR+%22arterial+spin+labeling%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance+spectroscopy%22%5BTitle%2FAbstract%5D)'

# Step 1: esearch
curl -s \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term="'${TERM_ENC}&reldate=2&datetype=crdt&retmax=100&retmode=json" > "$TMPDIR/esearch.json"
IDS_CSV=$(jq -r '"'.esearchresult.idlist | join(\",\")' \""'$TMPDIR/esearch.json")

if [ -z "$IDS_CSV" ]; then
  echo '"'[]' > \""'$TMPDIR/new_articles.json"
else
  # Step 2: esummary
  curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&id=${IDS_CSV}&retmode=json" > "$TMPDIR/esummary.json"

  # Step 3: efetch (xml abstracts)
  curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=${IDS_CSV}&retmode=xml&rettype=abstract" > "$TMPDIR/efetch.xml"

  # Build PMID->abstract map from XML
  : > "$TMPDIR/abstracts.tsv"
  COUNT=$(xmllint --xpath '"'count(//PubmedArticle)' \""'$TMPDIR/efetch.xml" 2>/dev/null | awk -F. '"'{print "'$1}'"')
  if [ -z \""'$COUNT" ]; then COUNT=0; fi
  if [ "$COUNT" -gt 0 ]; then
    for i in $(seq 1 "$COUNT"); do
      PMID=$(xmllint --xpath "normalize-space(string(//PubmedArticle[$i]/MedlineCitation/PMID))" "$TMPDIR/efetch.xml" 2>/dev/null || true)
      ABSTRACT=$(xmllint --xpath "normalize-space(string(//PubmedArticle[$i]/MedlineCitation/Article/Abstract))" "$TMPDIR/efetch.xml" 2>/dev/null || true)
      ABSTRACT=$(printf '"'%s' \""'$ABSTRACT" | tr '"'\\t\\r\\n' '   ' | sed 's/  */ /g;s/"'^ //;s/ $//'"')
      if [ -n \""'$PMID" ]; then
        printf '"'%s\\t%s\\n' \""'$PMID" "$ABSTRACT" >> "$TMPDIR/abstracts.tsv"
      fi
    done
  fi

  jq -Rn '"'reduce inputs as "'$line ({}; ($line | split("'"\\t\")) as "'$p | if ($p|length)>=2 and ($p[0]|length)>0 then . + {($p[0]): $p[1]} else . end)'"' \""'$TMPDIR/abstracts.tsv" > "$TMPDIR/abstracts.json"

  jq --arg today "$TODAY" --arg y "$YESTERDAY" --arg date "$TODAY" --slurpfile abs "$TMPDIR/abstracts.json" '"'
    def parse_date:
      . as "'$d |
      (try ($d | strptime("%Y-%m-%d") | strftime("%Y-%m-%d")) catch
       try ($d | strptime("%Y %b %d") | strftime("%Y-%m-%d")) catch
       try ($d | strptime("%Y %B %d") | strftime("%Y-%m-%d")) catch
       try ($d | strptime("%Y %b") | strftime("%Y-%m-01")) catch
       try ($d | strptime("%Y %B") | strftime("%Y-%m-01")) catch
       try ($d | strptime("%Y") | strftime("%Y-01-01")) catch
       null);

    .result as $r
    | [ $r.uids[] as $id
        | $r[$id] as $it
        | (($it.pubdate // "") | parse_date) as $pd
        | select($pd == $today or $pd == $y)
        | {
            title: ($it.title // ""),
            summary: ((($abs[0][$id] // "") | gsub("'"\\\\s+\"; \" \") | ltrimstr(\" \") | rtrimstr(\" \")) as "'$s | if $s == "" then "No abstract available in source." else $s end),
            url: ("https://pubmed.ncbi.nlm.nih.gov/" + $id + "/"),
            category: "Brain MRI",
            source: "pubmed",
            journal: ($it.source // ""),
            published_date: $pd,
            date: $date
          }
      ]
  '"' \""'$TMPDIR/esummary.json" > "$TMPDIR/new_articles.json"
fi

if [ ! -f "$OUT" ]; then
  printf '"'{\"date\":\"%s\",\"articles\":[]}' \""'$TODAY" > "$OUT"
fi

jq --arg today "$TODAY" --slurpfile new "$TMPDIR/new_articles.json" '"'
  {
    date: "'$today,
    articles: (((.articles // []) + ($new[0] // [])) | unique_by(.url))
  }
'"' \""'$OUT" > "$TMPDIR/merged.json"

mv "$TMPDIR/merged.json" "$OUT"

# Print short stats for verification
jq '"'{date, count:(.articles|length), sample:(.articles[0] // null)}' \""'$OUT"
