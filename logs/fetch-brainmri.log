'"' \""'$TMPDIR/esummary.json" > "$TMPDIR/new_articles.json"

if [ -f "$OUT" ]; then
  jq -s --arg today "$TODAY" '"'
    (.[0].articles // []) as "'$old
    | (.[1] // []) as $new
    | {date:$today, articles: (($old + $new) | unique_by(.url))}
  '"' \""'$OUT" "$TMPDIR/new_articles.json" > "$TMPDIR/final.json"
else
  jq -n --arg today "$TODAY" --argjson items "$(cat "$TMPDIR/new_articles.json")" '"'{date:"'$today, articles:$items}'"' > \""'$TMPDIR/final.json"
fi

mv "$TMPDIR/final.json" "$OUT"

