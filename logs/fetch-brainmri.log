import json
import re
from datetime import datetime, timedelta

# Load esummary data
with open('/Users/chenmayao/.local/share/opencode/tool-output/tool_c93556387001rCDX9mYU71hgrE', 'r') as f:
    summary_data = json.load(f)

# Load efetch XML data
with open('/Users/chenmayao/.local/share/opencode/tool-output/tool_c9355c0ca0011s7L2uVFyDBU4k', 'r') as f:
    xml_data = f.read()

# Extract abstracts from XML using regex
abstract_pattern = re.compile(r'<PubmedArticle>.*?<PMID[^>]*>([^<]+)</PMID>.*?<AbstractText[^>]*>([^<]*(?:<[^>]*>[^<]*)*?)</AbstractText>', re.DOTALL)
abstracts = {}
for match in abstract_pattern.finditer(xml_data):
    pmid = match.group(1)
    abstract = match.group(2).strip()
    abstract = re.sub(r'<[^>]+>', '', abstract)  # Remove any remaining XML tags
    abstract = abstract.replace('  ', ' ')
    abstracts[pmid] = abstract

# Process summary data
articles = []
uids = summary_data['result']['uids']

for uid in uids:
    article = summary_data['result'].get(uid, {})
    if not article:
        continue
    
    # Get pubdate and convert to YYYY-MM-DD
    pubdate = article.get('pubdate', '')
    if not pubdate:
        continue
    
    # Parse pubdate (format: '2026 Feb 24' or '2026 Feb')
    match = re.match(r'(\d{4})\s+(\w+)\s*(\d+)?', pubdate)
    if match:
        year = match.group(1)
        month = match.group(2)
        day = match.group(3) if match.group(3) else '01'
        published_date = f'{year}-{month[:3].title()}-{int(day):02d}'
        # Convert month abbreviation to number
        month_map = {'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04', 'May': '05', 'Jun': '06',
                     'Jul': '07', 'Aug': '08', 'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'}
        published_date = f'{year}-{month_map.get(month[:3].title(), \"01\")}-{int(day):02d}'
    else:
        continue
    
    # Filter: only keep articles from today (2026-02-25) or yesterday (2026-02-24)
    if published_date not in ['2026-02-25', '2026-02-24']:
        continue
    
    # Get abstract
    summary = abstracts.get(uid, '')[:500]  # Limit to 500 chars
    
    article_data = {
        'title': article.get('title', ''),
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'published_date': published_date,
        'date': '2026-02-25'
    }
    articles.append(article_data)

# Remove duplicates by url
seen = set()
unique_articles = []
for a in articles:
    if a['url'] not in seen:
        seen.add(a['url'])
        unique_articles.append(a)

output = {
    'date': '2026-02-25',
    'articles': unique_articles
}

print(json.dumps(output, indent=2, ensure_ascii=False))
