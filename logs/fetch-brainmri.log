my ("'$esummary_path, $efetch_path, $today, $yesterday, $out_path) = @ARGV;

sub read_file {
  my ($path) = @_;
  open my $fh, '"'<', "'$path or die "Cannot open $path: $!";
  local $/;
  my $content = <$fh>;
  close $fh;
  return $content;
}

sub trim {
  my ($text) = @_;
  $text //= '"'';
  "'$text =~ s/''^'"\\s+|\\s+"'$//g;
  $text =~ s/'"\\s+/ /g;
  return "'$text;
}

sub month_to_num {
  my ($month) = @_;
  my %map = (
    jan => 1, january => 1,
    feb => 2, february => 2,
    mar => 3, march => 3,
    apr => 4, april => 4,
    may => 5,
    jun => 6, june => 6,
    jul => 7, july => 7,
    aug => 8, august => 8,
    sep => 9, sept => 9, september => 9,
    oct => 10, october => 10,
    nov => 11, november => 11,
    dec => 12, december => 12,
  );
  return $map{lc($month)};
}

sub parse_pubdate {
  my ($raw) = @_;
  $raw = trim($raw);
  return '"'' if "'$raw eq '"'';

  "'$raw =~ s/'"\\s*\\[.*"'$//;
  $raw =~ s/'"\\s*;.*"'$//;
  $raw =~ s/,//g;
  $raw =~ s/'"\\s+/ /g;
  "'$raw = trim($raw);

  if ($raw =~ /''^('"\\d{4})-(\\d{2})-(\\d{2})"'$/) {
    return sprintf('"'%04d-%02d-%02d', "'$1, $2, $3);
  }

  if ($raw =~ /''^('"\\d{4})-(\\d{2})"'$/) {
    return sprintf('"'%04d-%02d-01', "'$1, $2);
  }

  if ($raw =~ /''^('"\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})"'$/) {
    my ($y, $m_txt, $d) = ($1, $2, $3);
    my $m = month_to_num($m_txt);
    return '"'' unless defined "'$m;
    return sprintf('"'%04d-%02d-%02d', "'$y, $m, $d);
  }

  if ($raw =~ /''^('"\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})-\\d{1,2}"'$/) {
    my ($y, $m_txt, $d) = ($1, $2, $3);
    my $m = month_to_num($m_txt);
    return '"'' unless defined "'$m;
    return sprintf('"'%04d-%02d-%02d', "'$y, $m, $d);
  }

  if ($raw =~ /''^('"\\d{4})\\s+([A-Za-z]{3,9})-[A-Za-z]{3,9}"'$/) {
    my ($y, $m_txt) = ($1, $2);
    my $m = month_to_num($m_txt);
    return '"'' unless defined "'$m;
    return sprintf('"'%04d-%02d-01', "'$y, $m);
  }

  if ($raw =~ /''^('"\\d{4})\\s+([A-Za-z]{3,9})"'$/) {
    my ($y, $m_txt) = ($1, $2);
    my $m = month_to_num($m_txt);
    return '"'' unless defined "'$m;
    return sprintf('"'%04d-%02d-01', "'$y, $m);
  }

  if ($raw =~ /''^('"\\d{4})"'$/) {
    return sprintf('"'%04d-01-01', "'$1);
  }

  return '"'';
}

my "'$summary_data = decode_json(read_file($esummary_path));
my $uids = $summary_data->{result}->{uids} || [];

my %abstract_by_pmid;
my $parser = XML::LibXML->new(recover => 2, no_network => 1);
my $doc = $parser->parse_file($efetch_path);

for my $article ($doc->findnodes('"'//PubmedArticle')) {
  my "'$pmid = trim($article->findvalue('"'./MedlineCitation/PMID'));
  next if "'$pmid eq '"'';

  my @parts;
  for my "'$node ($article->findnodes('"'.//Article/Abstract/AbstractText')) {
    my "'$text = trim($node->textContent // '"'');
    next if "'$text eq '"'';
    my "'$label = trim($node->getAttribute('"'Label') // '');
    if ("'$label ne '"'' && "'$text !~ /''^'"\\Q"'$label'"\\E[:\\s]/i) {
      "'$text = "$label: $text";
