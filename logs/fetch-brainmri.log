import json, re
from datetime import datetime
import xml.etree.ElementTree as ET

esum_path='/tmp/brainmri_esummary_20260309.json'
xml_path='/tmp/brainmri_efetch_20260309.xml'

def parse_pubdate(pubdate, sortpubdate=''):
    if pubdate is None:
        pubdate=''
    pubdate=pubdate.strip()
    month_map={
        'Jan':1,'Feb':2,'Mar':3,'Apr':4,'May':5,'Jun':6,
        'Jul':7,'Aug':8,'Sep':9,'Oct':10,'Nov':11,'Dec':12
    }
    # direct YYYY-MM-DD
    m=re.search(r'(\\d{4})-(\\d{2})-(\\d{2})', pubdate)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    # direct YYYY/MM/DD
    m=re.search(r'(\\d{4})/(\\d{2})/(\\d{2})', pubdate)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    # YYYY Mon DD
    m=re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})\\b', pubdate)
    if m and m.group(2).title()[:3] in month_map:
        y=int(m.group(1)); mo=month_map[m.group(2).title()[:3]]; d=int(m.group(3))
        return f\"{y:04d}-{mo:02d}-{d:02d}\"
    # YYYY Mon-Mon or YYYY Mon
    m=re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3})\\b', pubdate)
    if m and m.group(2).title()[:3] in month_map:
        y=int(m.group(1)); mo=month_map[m.group(2).title()[:3]]
        return f\"{y:04d}-{mo:02d}-01\"
    # year only
    m=re.search(r'\\b(\\d{4})\\b', pubdate)
    if m:
        return f\"{int(m.group(1)):04d}-01-01\"
    if sortpubdate:
        m=re.search(r'(\\d{4})/(\\d{2})/(\\d{2})', sortpubdate)
        if m:
            return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    return ''

with open(esum_path) as f:
    es=json.load(f)

abstracts={}
root=ET.parse(xml_path).getroot()
for pa in root.findall('.//PubmedArticle'):
    pmid_node=pa.find('./MedlineCitation/PMID')
    if pmid_node is None or pmid_node.text is None:
        continue
    pmid=pmid_node.text.strip()
    texts=[]
    for ab in pa.findall('./MedlineCitation/Article/Abstract/AbstractText'):
        label=(ab.attrib.get('Label') or '').strip()
        txt=''.join(ab.itertext()).strip()
        if not txt:
            continue
        if label:
            texts.append(f\"{label}: {txt}\")
        else:
            texts.append(txt)
    abstracts[pmid]=' '.join(texts).strip()

