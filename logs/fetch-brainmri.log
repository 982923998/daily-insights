import json
import os
import re
import xml.etree.ElementTree as ET
from datetime import datetime

workdir = \"/tmp/brainmri-2026-03-04\"
out_file = \"/Users/chenmayao/Projects/daily-insights/data/2026-03-04-brainmri.json\"
today = \"2026-03-04\"
yesterday = \"2026-03-03\"
allowed_dates = {today, yesterday}

with open(os.path.join(workdir, \"esummary.json\"), \"r\", encoding=\"utf-8\") as f:
    esummary = json.load(f)

with open(os.path.join(workdir, \"esearch.json\"), \"r\", encoding=\"utf-8\") as f:
    esearch = json.load(f)

idlist = esearch.get(\"esearchresult\", {}).get(\"idlist\", []) or []

# Parse abstracts from efetch XML
abstract_by_pmid = {}
xml_path = os.path.join(workdir, \"efetch.xml\")
if os.path.exists(xml_path) and os.path.getsize(xml_path) > 0:
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()
        for article in root.findall(\".//PubmedArticle\"):
            pmid_node = article.find(\".//MedlineCitation/PMID\")
            if pmid_node is None or not (pmid_node.text and pmid_node.text.strip()):
                continue
            pmid = pmid_node.text.strip()
            parts = []
            for abstract_text in article.findall(\".//MedlineCitation/Article/Abstract/AbstractText\"):
                text = \" \".join((abstract_text.itertext() or [])) if abstract_text is not None else \"\"
                text = re.sub(r\"\\s+\", \" \", text).strip()
                label = (abstract_text.attrib.get(\"Label\") or \"\").strip() if abstract_text is not None else \"\"
                if text:
                    if label and not text.lower().startswith(label.lower() + \":\"):
                        parts.append(f\"{label}: {text}\")
                    else:
                        parts.append(text)
            joined = re.sub(r\"\\s+\", \" \", \" \".join(parts)).strip()
            if joined:
                abstract_by_pmid[pmid] = joined
    except ET.ParseError:
        pass

month_map = {
    \"jan\": 1, \"january\": 1,
    \"feb\": 2, \"february\": 2,
    \"mar\": 3, \"march\": 3,
    \"apr\": 4, \"april\": 4,
    \"may\": 5,
    \"jun\": 6, \"june\": 6,
    \"jul\": 7, \"july\": 7,
    \"aug\": 8, \"august\": 8,
    \"sep\": 9, \"sept\": 9, \"september\": 9,
    \"oct\": 10, \"october\": 10,
    \"nov\": 11, \"november\": 11,
    \"dec\": 12, \"december\": 12,
}

def parse_pubdate(pubdate_raw: str) -> str:
    if not pubdate_raw:
        return \"\"
    s = pubdate_raw.strip()
    if not s:
        return \"\"
    s = re.sub(r\"\\s+\", \" \", s)
    s = s.replace(\",\", \"\")
    s = s.split(\";\")[0].strip()
    s = re.sub(r\""'^(Epub|Print)'"\\s+\", \"\", s, flags=re.IGNORECASE)

    # Direct ISO-like
    for fmt in (\"%Y-%m-%d\", \"%Y/%m/%d\"):
        try:
            return datetime.strptime(s, fmt).strftime(\"%Y-%m-%d\")
        except ValueError:
            pass

    # YYYY Mon DD or YYYY Month DD with optional day range
    m = re.match(r\""'^('"\\d{4})\\s+([A-Za-z]+)\\s+(\\d{1,2})(?:-\\d{1,2})?"'$", s)
    if m:
        year = int(m.group(1))
        mon_txt = m.group(2).lower()
        day = int(m.group(3))
        mon = month_map.get(mon_txt)
        if mon:
            try:
                return datetime(year, mon, day).strftime("%Y-%m-%d")
            except ValueError:
                return ""

    # YYYY Mon or YYYY Mon-Mon
    m = re.match(r"''^('"\\d{4})\\s+([A-Za-z]+)(?:-[A-Za-z]+)?"'$", s)
    if m:
        year = int(m.group(1))
        mon_txt = m.group(2).lower()
        mon = month_map.get(mon_txt)
        if mon:
            return f"{year:04d}-{mon:02d}-01"

    # YYYY only
    m = re.match(r"''^('"\\d{4})"'$", s)
    if m:
        return f"{int(m.group(1)):04d}-01-01"

    # Try first three tokens fallback: YYYY Mon DD
    tokens = s.split()
    if len(tokens) >= 3 and re.fullmatch(r"'"\\d{4}\", tokens[0]):
        year = int(tokens[0])
        mon = month_map.get(tokens[1].lower())
        day_match = re.match(r\""'^('"\\d{1,2})\", tokens[2])
        if mon and day_match:
            day = int(day_match.group(1))
            try:
                return datetime(year, mon, day).strftime(\"%Y-%m-%d\")
            except ValueError:
                pass

    return \"\"

result = esummary.get(\"result\", {}) or {}

new_articles = []
for pmid in idlist:
    meta = result.get(str(pmid), {}) or {}
    title = (meta.get(\"title\") or \"\").strip()
    journal = (meta.get(\"source\") or \"\").strip()
    pubdate_raw = (meta.get(\"pubdate\") or \"\").strip()
    published_date = parse_pubdate(pubdate_raw)

    if published_date not in allowed_dates:
        continue

    summary = (abstract_by_pmid.get(str(pmid)) or \"\").strip()
    if not summary:
        summary = \"No abstract available in source.\"

    article = {
        \"title\": title,
        \"summary\": summary,
        \"url\": f\"https://pubmed.ncbi.nlm.nih.gov/{pmid}/\",
        \"category\": \"Brain MRI\",
        \"source\": \"pubmed\",
        \"journal\": journal,
        \"published_date\": published_date,
        \"date\": today,
    }
    new_articles.append(article)

# Existing merge
existing_articles = []
if os.path.exists(out_file):
    try:
        with open(out_file, \"r\", encoding=\"utf-8\") as f:
            old = json.load(f)
        if isinstance(old, dict) and isinstance(old.get(\"articles\"), list):
            existing_articles = old[\"articles\"]
    except Exception:
        existing_articles = []

combined = []
seen = set()
for item in new_articles + existing_articles:
    if not isinstance(item, dict):
        continue
    url = (item.get(\"url\") or \"\").strip()
    if not url or url in seen:
        continue
    seen.add(url)

    title = (item.get(\"title\") or \"\").strip()
    summary = (item.get(\"summary\") or \"\").strip() or \"No abstract available in source.\"
    journal = (item.get(\"journal\") or \"\").strip()

    published_date = (item.get(\"published_date\") or \"\").strip()
    if published_date not in allowed_dates:
        # keep only today's / yesterday's records by domain rule
        continue

    combined.append({
        \"title\": title,
        \"summary\": summary,
        \"url\": url,
        \"category\": \"Brain MRI\",
        \"source\": \"pubmed\",
        \"journal\": journal,
        \"published_date\": published_date,
        \"date\": today,
    })

payload = {
    \"date\": today,
    \"articles\": combined if combined else []
}

os.makedirs(os.path.dirname(out_file), exist_ok=True)
with open(out_file, \"w\", encoding=\"utf-8\") as f:
    json.dump(payload, f, ensure_ascii=False, indent=2)

print(f\"new_articles={len(new_articles)}\")
print(f\"existing_articles={len(existing_articles)}\")
print(f\"written_articles={len(payload['articles'])}\")
print(out_file)
