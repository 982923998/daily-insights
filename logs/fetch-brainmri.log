import json, sys, re
data = json.load(sys.stdin)
result = []
for uid, item in data.get('result', {}).items():
    if uid == 'uids' or 'pubdate' not in item:
        continue
    pubdate = item.get('pubdate', '')
    # Parse pubdate to YYYY-MM-DD
    match = re.match(r'(\d{4})(?:\s*(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s*(\d{1,2})?)?', pubdate)
    if match:
        year = match.group(1)
        month_map = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06','Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'}
        month = month_map.get(match.group(2), '01')
        day = match.group(3) if match.group(3) else '01'
        published_date = f'{year}-{month}-{int(day):02d}'
        if published_date == '2026-02-25':
            result.append({
                'uid': uid,
                'title': item.get('title', ''),
                'source': item.get('source', ''),
                'published_date': published_date
            })
print(json.dumps(result))
"


