/bin/zsh -lc "python3 - <<'PY'
import json, re
from pathlib import Path
from datetime import datetime, timedelta
import xml.etree.ElementTree as ET

base = Path('/tmp/brainmri_20260322')
out_path = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-22-brainmri.json')
out_path.parent.mkdir(parents=True, exist_ok=True)

today = datetime(2026,3,22).date()
yesterday = today - timedelta(days=1)
allowed = {today.isoformat(), yesterday.isoformat()}

# Load esummary
es = json.loads((base/'esummary.json').read_text()) if (base/'esummary.json').exists() else {\"result\": {\"uids\": []}}
result = es.get('result', {})
uids = result.get('uids', [])

# Parse efetch abstracts by PMID
abstracts = {}
if (base/'efetch.xml').exists() and (base/'efetch.xml').stat().st_size > 0:
    root = ET.fromstring((base/'efetch.xml').read_text())
    for art in root.findall('.//PubmedArticle'):
        pmid_el = art.find('.//MedlineCitation/PMID')
        if pmid_el is None or pmid_el.text is None:
            continue
        pmid = pmid_el.text.strip()
        parts = []
        for ab in art.findall('.//Abstract/AbstractText'):
            txt = ''.join(ab.itertext()).strip()
            if txt:
                label = ab.attrib.get('Label') or ab.attrib.get('NlmCategory')
                if label and txt.lower().startswith(label.lower()+':'):
                    parts.append(txt)
                elif label and label.lower() not in {'unassigned'}:
                    parts.append(f\"{label}: {txt}\")
                else:
                    parts.append(txt)
        abstracts[pmid] = ' '.join(parts).strip()

month_map = {m.lower(): i for i,m in enumerate(['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], start=1)}

def parse_pubdate(s: str):
    if not s:
        return None
    s = s.strip()
    # remove trailing punctuation/season markers
    s = s.replace('.', ' ')
    s = re.sub(r'\\s+', ' ', s).strip()

    # yyyy-mm-dd or yyyy/mm/dd
    m = re.match(r'"'^('"\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})"'$'"', s)
    if m:
        y,mo,d = map(int,m.groups())
        try:
            return datetime(y,mo,d).date().isoformat()
        except ValueError:
            return None
    # yyyy mon dd
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = m.group(2)[:3].lower(); d = int(m.group(3))
        mo = month_map.get(mon)
        if mo:
            try:
                return datetime(y,mo,d).date().isoformat()
            except ValueError:
                return None
    # yyyy mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = m.group(2)[:3].lower(); mo = month_map.get(mon)
        if mo:
            return f\"{y:04d}-{mo:02d}-01\"
    # yyyy season
    m = re.match(r'"'^('"\\d{4})\\s+(Spring|Summer|Fall|Autumn|Winter)"'$'"', s, flags=re.I)
    if m:
        y = int(m.group(1)); season = m.group(2).lower()
        mo = {'spring':3,'summer':6,'fall':9,'autumn':9,'winter':12}[season]
        return f\"{y:04d}-{mo:02d}-01\"
    # yyyy
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        y = int(m.group(1))
        return f\"{y:04d}-01-01\"
    return None

new_articles = []
for uid in uids:
    rec = result.get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    pubdate_raw = (rec.get('pubdate') or '').strip()
    published_date = parse_pubdate(pubdate_raw)
    if published_date not in allowed:
        continue
    summary = abstracts.get(uid, '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': today.isoformat(),
    })

# Merge existing if exists
existing = []
if out_path.exists():
    try:
        old = json.loads(out_path.read_text())
        if isinstance(old, dict) and isinstance(old.get('articles'), list):
            existing = old['articles']
    except Exception:
        existing = []

combined = []
seen = set()
for art in existing + new_articles:
    url = art.get('url','').strip()
    if not url or url in seen:
        continue
    seen.add(url)
    # normalize required fields
    art_out = {
        'title': art.get('title',''),
        'summary': art.get('summary','') or 'No abstract available in source.',
        'url': url,
        'category': 'Brain MRI',
        'source': art.get('source','pubmed') or 'pubmed',
        'journal': art.get('journal','') or '',
        'published_date': art.get('published_date',''),
        'date': today.isoformat(),
    }
