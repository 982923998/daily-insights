TERM_ENC='(%22Brain%22%5BMesh%5D+OR+brain*%5BTitle%2FAbstract%5D+OR+cerebr*%5BTitle%2FAbstract%5D+OR+encephalon%5BTitle%2FAbstract%5D+OR+intracranial%5BTitle%2FAbstract%5D)+AND+(%22Magnetic+Resonance+Imaging%22%5BMesh%5D+OR+%22MRI%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance%22%5BTitle%2FAbstract%5D+OR+%22fMRI%22%5BTitle%2FAbstract%5D+OR+%22DTI%22%5BTitle%2FAbstract%5D+OR+%22diffusion+tensor%22%5BTitle%2FAbstract%5D+OR+%22VBM%22%5BTitle%2FAbstract%5D+OR+%22voxel-based+morphometry%22%5BTitle%2FAbstract%5D+OR+%22connectome%22%5BTitle%2FAbstract%5D+OR+%22arterial+spin+labeling%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance+spectroscopy%22%5BTitle%2FAbstract%5D)'

# Step 1: esearch
curl -s \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term="'${TERM_ENC}&reldate=2&datetype=crdt&retmax=100&retmode=json" > "$TMPDIR/esearch.json"
jq -r '"'.esearchresult.idlist[]?' \""'$TMPDIR/esearch.json" > "$TMPDIR/pmids.txt"

if [ ! -s "$TMPDIR/pmids.txt" ]; then
  printf '"'{\"date\":\"%s\",\"articles\":[]}\\n' \""'$TODAY" > "$TMPDIR/new.json"
else
  IDS_CSV="$(paste -sd, "$TMPDIR/pmids.txt")"

  # Step 2: esummary
  curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&id=${IDS_CSV}&retmode=json" > "$TMPDIR/esummary.json"

  # Step 3: efetch
  curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=${IDS_CSV}&retmode=xml&rettype=abstract" > "$TMPDIR/efetch.xml"

  perl -0777 -ne '"'
    while (/<PubmedArticle\\b.*?<\\/PubmedArticle>/sg) {
      my "'$a = $&;
      my ($pmid) = $a =~ /<PMID[''^>]*>('"\\d+)<\\/PMID>/s;
      next unless "'$pmid;
      my @abs = $a =~ /<AbstractText[''^>]*>(.*?)<'"\\/AbstractText>/sg;
      my "'$txt = join(" ", @abs);
      $txt =~ s/<[''^>]+>/ /g;
      $txt =~ s/&lt;/</g; $txt =~ s/&gt;/>/g; $txt =~ s/&amp;/&/g;
      $txt =~ s/&quot;/"/g; $txt =~ s/&apos;/'"'\"'\"'/g;
      "'$txt =~ s/'"\\s+/ /g;
      "'$txt =~ s/''^'"\\s+|\\s+"'$//g;
      print "$pmid'"\\t"'$txt'"\\n\";
    }
  ' \""'$TMPDIR/efetch.xml" > "$TMPDIR/abstracts.tsv"

  jq -n '"\\
    --arg today \""'$TODAY" '"\\
    --arg yday \""'$YDAY" '"\\
    --slurpfile s \""'$TMPDIR/esummary.json" '"\\
    --rawfile abs_tsv \""'$TMPDIR/abstracts.tsv" '"'
      def mon2num(m):
        ({\"Jan\":\"01\",\"Feb\":\"02\",\"Mar\":\"03\",\"Apr\":\"04\",\"May\":\"05\",\"Jun\":\"06\",\"Jul\":\"07\",\"Aug\":\"08\",\"Sep\":\"09\",\"Oct\":\"10\",\"Nov\":\"11\",\"Dec\":\"12\"}[m] // null);

      def norm_pubdate:
        . as "'$p |
        if ($p|type)!="string" or ($p|length)==0 then ""
        elif ($p|test("''^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) then $p
        elif ($p|test("''^[0-9]{4} [A-Z][a-z]{2} [0-9]{1,2}$")) then
          ($p|capture("''^(?<y>[0-9]{4}) (?<m>[A-Z][a-z]{2}) (?<d>[0-9]{1,2})$") | .y + "-" + (mon2num(.m)//"01") + "-" + (.d|tonumber|tostring|if length==1 then "0"+ . else . end))
        elif ($p|test("''^[0-9]{4} [A-Z][a-z]{2}$")) then
          ($p|capture("''^(?<y>[0-9]{4}) (?<m>[A-Z][a-z]{2})$") | .y + "-" + (mon2num(.m)//"01") + "-01")
        elif ($p|test("''^[0-9]{4}$")) then
          ($p + "-01-01")
        else "" end;

      def split_once_tab:
        . as $line |
        ($line | index("'"\\t\")) as "'$i |
        if $i == null then [$line, ""] else [($line[0:$i]), ($line[$i+1:])] end;

      def abs_map_from_tsv(tsv):
        reduce (tsv|split("'"\\n\")[] | select(length>0)) as "'$line
          ({};
            ($line|split_once_tab) as $kv |
            . + { ($kv[0]): (($kv[1] // "")|gsub("'"\\\\s+\";\" \")|ltrimstr(\" \")|rtrimstr(\" \")) }
          );

      ("'$s[0].result // {}) as $r |
      ($r.uids // []) as $uids |
      (abs_map_from_tsv($abs_tsv)) as $absm |
      {
        date: $today,
        articles: [
          $uids[] as $id |
          ($r[$id] // {}) as $it |
          (($it.pubdate // "") | norm_pubdate) as $pd |
          select($pd == $today or $pd == $yday) |
          {
            title: ($it.title // ""),
            summary: (($absm[$id] // "") | if length>0 then . else "No abstract available in source." end),
            url: ("https://pubmed.ncbi.nlm.nih.gov/" + $id + "/"),
            category: "Brain MRI",
            source: "pubmed",
            journal: ($it.source // ""),
            published_date: $pd,
            date: $today
          }
        ]
      }
    '"' > \""'$TMPDIR/new.json"
fi

if [ -f "$OUT" ]; then
  jq -s --arg today "$TODAY" '"'
    (.[0].articles // []) as "'$old |
    (.[1].articles // []) as $new |
    {
      date: $today,
      articles: (($old + $new) | map(select(.url != null and .url != "")) | unique_by(.url))
    }
  '"' \""'$OUT" "$TMPDIR/new.json" > "$TMPDIR/merged.json"
else
  cp "$TMPDIR/new.json" "$TMPDIR/merged.json"
fi

jq '"'.' \""'$TMPDIR/merged.json" > "$OUT"
jq '"'{date, count:(.articles|length)}' \""'$OUT"
