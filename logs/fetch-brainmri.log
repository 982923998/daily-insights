import json
import os
import re
import datetime as dt
import xml.etree.ElementTree as ET

TODAY_STR = '2026-03-03'
TODAY = dt.date.fromisoformat(TODAY_STR)
ALLOWED_DATES = {TODAY.isoformat(), (TODAY - dt.timedelta(days=1)).isoformat()}
ESUM_PATH = '/tmp/brainmri_esummary.json'
EFETCH_PATH = '/tmp/brainmri_efetch.xml'
OUT_PATH = '/Users/chenmayao/Projects/daily-insights/data/2026-03-03-brainmri.json'

MONTHS = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}

def parse_pubdate(pubdate: str) -> str:
    if not pubdate:
        return ''
    text = pubdate.strip()
    year_match = re.search(r'\\b(19|20)\\d{2}\\b', text)
    if not year_match:
        return ''
    year = int(year_match.group(0))

    month = 1
    day = 1

    tokens = re.split(r'\\s+', text)
    month_found = False
    for tok in tokens:
        t = tok.strip(' ,.;()[]{}').lower()
        if not t:
            continue
        if '-' in t:
            t = t.split('-')[0]
        if t in MONTHS:
            month = MONTHS[t]
            month_found = True
            break

    if month_found:
        day_match = re.search(r'\\b([0-2]?\\d|3[0-1])\\b', text)
        if day_match:
            d = int(day_match.group(1))
            # Avoid treating year fragments as day
            if d "'!= year and 1 <= d <= 31:
                day = d

    try:
        parsed = dt.date(year, month, day)
        return parsed.isoformat()
    except ValueError:
        return '"''

# Load abstracts from efetch XML
abstract_map = {}
root = ET.parse(EFETCH_PATH).getroot()
for article in root.findall('.//PubmedArticle'):
    pmid = article.findtext('.//MedlineCitation/PMID') or article.findtext('.//PMID')
    if not pmid:
        continue
    parts = []
    for node in article.findall('.//Abstract/AbstractText'):
        txt = ''.join(node.itertext()).strip()
        if txt:
            parts.append(txt)
    abstract_map[pmid] = ' '.join(parts).strip()

# Load summary metadata
with open(ESUM_PATH, 'r', encoding='utf-8') as f:
    esum = json.load(f)

result = esum.get('result', {})
uids = result.get('uids', [])
new_articles = []
for uid in uids:
    rec = result.get(uid, {})
    published_date = parse_pubdate(rec.get('pubdate', ''))
    if published_date not in ALLOWED_DATES:
        continue

    summary = abstract_map.get(uid, '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    article = {
        'title': (rec.get('title') or '').strip(),
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': rec.get('source') or '',
        'published_date': published_date,
        'date': TODAY_STR,
    }
    new_articles.append(article)

# Merge with existing file if present
existing_articles = []
if os.path.exists(OUT_PATH):
    try:
        with open(OUT_PATH, 'r', encoding='utf-8') as f:
            existing = json.load(f)
        existing_articles = existing.get('articles', []) if isinstance(existing, dict) else []
    except Exception:
        existing_articles = []

merged = new_articles + existing_articles
seen = set()
deduped = []
for art in merged:
    url = art.get('url', '')
    if not url or url in seen:
        continue
    seen.add(url)
    # Ensure required fields and non-empty summary fallback
    normalized = {
        'title': art.get('title', ''),
        'summary': art.get('summary', '') or 'No abstract available in source.',
        'url': url,
        'category': 'Brain MRI',
        'source': art.get('source', 'pubmed') or 'pubmed',
        'journal': art.get('journal', '') or '',
        'published_date': art.get('published_date', ''),
        'date': TODAY_STR,
    }
    deduped.append(normalized)

output = {
    'date': TODAY_STR,
    'articles': deduped,
}

os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
with open(OUT_PATH, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f'wrote {OUT_PATH} with {len(deduped)} articles (new fetched: {len(new_articles)})')
