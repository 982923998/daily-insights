EFETCH='/tmp/brainmri_efetch_20260309.xml'
OUT='/Users/chenmayao/Projects/daily-insights/data/2026-03-09-brainmri.json'

month_map={
    'Jan':1,'Feb':2,'Mar':3,'Apr':4,'May':5,'Jun':6,
    'Jul':7,'Aug':8,'Sep':9,'Oct':10,'Nov':11,'Dec':12
}

def parse_pubdate(pubdate, sortpubdate=''):
    pubdate=(pubdate or '').strip()
    # YYYY-MM-DD
    m=re.search(r'(\\d{4})-(\\d{2})-(\\d{2})', pubdate)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    # YYYY/MM/DD
    m=re.search(r'(\\d{4})/(\\d{2})/(\\d{2})', pubdate)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    # YYYY Mon DD
    m=re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})\\b', pubdate)
    if m:
        mon=m.group(2).title()[:3]
        if mon in month_map:
            return f\"{int(m.group(1)):04d}-{month_map[mon]:02d}-{int(m.group(3)):02d}\"
    # YYYY Mon (or YYYY Mon-...)
    m=re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3})\\b', pubdate)
    if m:
        mon=m.group(2).title()[:3]
        if mon in month_map:
            return f\"{int(m.group(1)):04d}-{month_map[mon]:02d}-01\"
    # YYYY only
    m=re.search(r'\\b(\\d{4})\\b', pubdate)
    if m:
        return f\"{int(m.group(1)):04d}-01-01\"
    # fallback to sortpubdate
    sp=(sortpubdate or '').strip()
    m=re.search(r'(\\d{4})/(\\d{2})/(\\d{2})', sp)
    if m:
        return f\"{m.group(1)}-{m.group(2)}-{m.group(3)}\"
    return ''

with open(ESUM, 'r', encoding='utf-8') as f:
    esummary=json.load(f)

abstracts={}
root=ET.parse(EFETCH).getroot()
for article in root.findall('.//PubmedArticle'):
    pmid_node=article.find('./MedlineCitation/PMID')
    if pmid_node is None or not pmid_node.text:
        continue
    pmid=pmid_node.text.strip()
    parts=[]
    for ab in article.findall('./MedlineCitation/Article/Abstract/AbstractText'):
        txt=''.join(ab.itertext()).strip()
        if not txt:
            continue
        label=(ab.attrib.get('Label') or '').strip()
        parts.append(f\"{label}: {txt}\" if label else txt)
    abstracts[pmid]=' '.join(parts).strip()

new_articles=[]
for uid in esummary.get('result', {}).get('uids', []):
    meta=esummary['result'].get(uid, {})
    published_date=parse_pubdate(meta.get('pubdate',''), meta.get('sortpubdate',''))
    if published_date not in TARGET_DATES:
        continue
    url=f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    abstract=abstracts.get(uid, '').strip()
    summary=abstract if abstract else 'No abstract available in source.'
    new_articles.append({
        'title': (meta.get('title') or '').strip(),
        'summary': summary,
        'url': url,
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': (meta.get('source') or '').strip(),
        'published_date': published_date,
        'date': TODAY
    })

existing=[]
if os.path.exists(OUT):
    try:
        with open(OUT, 'r', encoding='utf-8') as f:
            data=json.load(f)
            if isinstance(data, dict) and isinstance(data.get('articles'), list):
                existing=data['articles']
    except Exception:
        existing=[]

merged=[]
seen=set()
# keep newer fetch first, then append old unique
for item in new_articles + existing:
    if not isinstance(item, dict):
        continue
    url=(item.get('url') or '').strip()
    if not url or url in seen:
        continue
    seen.add(url)
    normalized={
        'title': item.get('title','') if isinstance(item.get('title',''), str) else '',
        'summary': item.get('summary','') if isinstance(item.get('summary',''), str) else '',
        'url': url,
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': item.get('journal','') if isinstance(item.get('journal',''), str) else '',
        'published_date': item.get('published_date','') if isinstance(item.get('published_date',''), str) else '',
        'date': TODAY,
    }
    if not normalized['summary'].strip():
        normalized['summary']='No abstract available in source.'
    merged.append(normalized)

# sort by published_date desc then title
merged.sort(key=lambda x: (x.get('published_date',''), x.get('title','')), reverse=True)

out={'date': TODAY, 'articles': merged}
with open(OUT, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(f\"written={OUT}\")
print(f\"new={len(new_articles)} merged={len(merged)}\")
