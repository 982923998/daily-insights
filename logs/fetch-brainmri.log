python3 - <<'PY'
import json
import re
from datetime import datetime
from pathlib import Path
import xml.etree.ElementTree as ET

base = Path('/Users/chenmayao/Projects/daily-insights')
tmp = Path('/var/folders/l7/fh7q_yld057f1pd9_pmfgpd40000gn/T/tmp.PHcM4vQG')
out_path = base / 'data/2026-03-16-brainmri.json'

today = '2026-03-16'
yesterday = '2026-03-15'
keep_dates = {today, yesterday}

esummary = json.loads((tmp / 'esummary.json').read_text()) if (tmp / 'esummary.json').exists() else {\"result\": {\"uids\": []}}

month_map = {
    'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06',
    'Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'
}

def parse_pubdate(s: str) -> str:
    s = (s or '').strip()
    if not s:
        return ''
    # Patterns commonly returned by esummary pubdate
    # YYYY Mon DD
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y, mon, d = m.groups()
        mon_num = month_map.get(mon[:3].title())
        if mon_num:
            return f'{y}-{mon_num}-{int(d):02d}'
    # YYYY Mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})"'$'"', s)
    if m:
        y, mon = m.groups()
        mon_num = month_map.get(mon[:3].title())
        if mon_num:
            return f'{y}-{mon_num}-01'
    # YYYY
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return f'{m.group(1)}-01-01'
    # Try dateutil-like fallback via datetime for formats like YYYY-MM-DD
    for fmt in ('%Y-%m-%d', '%Y/%m/%d', '%Y %b %d', '%Y %B %d', '%Y %b', '%Y %B'):
        try:
            dt = datetime.strptime(s, fmt)
            if fmt in ('%Y %b', '%Y %B'):
                return dt.strftime('%Y-%m-01')
            return dt.strftime('%Y-%m-%d')
        except Exception:
            pass
    # If contains day-less month text like \"2026 Spring\" -> cannot normalize reliably
    return ''

# Parse abstracts from efetch XML
abstract_map = {}
xml_path = tmp / 'efetch.xml'
if xml_path.exists() and xml_path.stat().st_size > 0:
    root = ET.parse(xml_path).getroot()
    for article in root.findall('.//PubmedArticle'):
        pmid_el = article.find('.//PMID')
        if pmid_el is None or not (pmid_el.text and pmid_el.text.strip()):
            continue
        pmid = pmid_el.text.strip()
        parts = []
        for ab in article.findall('.//Abstract/AbstractText'):
            txt = ''.join(ab.itertext()).strip()
            label = (ab.attrib.get('Label') or '').strip()
            if not txt:
                continue
            if label:
                parts.append(f'{label}: {txt}')
            else:
                parts.append(txt)
        summary = ' '.join(parts).strip()
        abstract_map[pmid] = summary

new_articles = []
result = esummary.get('result', {})
for uid in result.get('uids', []):
    rec = result.get(uid, {})
    published_date = parse_pubdate(rec.get('pubdate', ''))
    if published_date not in keep_dates:
        continue
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
    summary = (abstract_map.get(uid) or '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Brain MRI',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': today,
    })

# dedupe within new by url
seen = set()
dedup_new = []
for a in new_articles:
    if a['url'] in seen:
        continue
    seen.add(a['url'])
    dedup_new.append(a)

existing = {'date': today, 'articles': []}
if out_path.exists():
    try:
        existing = json.loads(out_path.read_text())
    except Exception:
        existing = {'date': today, 'articles': []}

merged = []
seen_url = set()
for a in existing.get('articles', []):
    u = a.get('url')
    if not u or u in seen_url:
        continue
    seen_url.add(u)
    merged.append(a)
for a in dedup_new:
    u = a.get('url')
    if not u or u in seen_url:
        continue
    seen_url.add(u)
    merged.append(a)

final_obj = {'date': today, 'articles': merged}
out_path.parent.mkdir(parents=True, exist_ok=True)
out_path.write_text(json.dumps(final_obj, ensure_ascii=False, indent=2))
print(f'wrote={out_path}')
print(f'new_articles={len(dedup_new)}')
print(f'merged_articles={len(merged)}')
