        elif ($p|test("''^[0-9]{4} [A-Z][a-z]{2}$")) then
          ($p|capture("''^(?<y>[0-9]{4}) (?<m>[A-Z][a-z]{2})$") | .y + "-" + (mon2num(.m)//"01") + "-01")
        elif ($p|test("''^[0-9]{4}$")) then
