python3 - <<'PY'
import json
import re
from datetime import date, timedelta
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY_STR = '2026-03-03'
TODAY = date.fromisoformat(TODAY_STR)
CUTOFF = TODAY - timedelta(days=3)

out_path = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-03-autism.json')
esummary_path = Path('/tmp/autism_search_2026_03_03/esummary.json')
efet_path = Path('/tmp/autism_search_2026_03_03/efetch.xml')

MONTHS = {
    'Jan':1,'Feb':2,'Mar':3,'Apr':4,'May':5,'Jun':6,
    'Jul':7,'Aug':8,'Sep':9,'Oct':10,'Nov':11,'Dec':12
}

def normalize_space(text: str) -> str:
    return re.sub(r'\\s+', ' ', text or '').strip()

def parse_pubdate(raw: str):
    if not raw:
        return None
    s = normalize_space(raw)
    s = s.split(';', 1)[0].strip()
    s = s.replace(',', ' ')

    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        y = int(m.group(1))
        return date(y, 1, 1)

    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})"'$'"', s)
    if m:
        y = int(m.group(1))
        mon = MONTHS.get(m.group(2).title())
        if mon:
            return date(y, mon, 1)

    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y = int(m.group(1))
        mon = MONTHS.get(m.group(2).title())
        d = int(m.group(3))
        if mon:
            try:
                return date(y, mon, d)
            except ValueError:
                return None

    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})-[A-Za-z]{3}(?:\\s+\\d{1,2})?"'$'"', s)
    if m:
        y = int(m.group(1))
        mon = MONTHS.get(m.group(2).title())
        if mon:
            return date(y, mon, 1)

    # fallback: take first recognizable year month day tokens
    tokens = s.split()
    y = None
    mon = None
    d = None
    for t in tokens:
        if y is None and re.fullmatch(r'\\d{4}', t):
            y = int(t)
            continue
        if mon is None and t[:3].title() in MONTHS:
            mon = MONTHS[t[:3].title()]
            continue
        if d is None and re.fullmatch(r'\\d{1,2}', t):
            d = int(t)
    if y is not None:
        if mon is None:
            mon = 1
        if d is None:
            d = 1
        try:
            return date(y, mon, d)
        except ValueError:
            return None
    return None

# Step 2 data
ess = json.loads(esummary_path.read_text())
result = ess.get('result', {})
uids = result.get('uids', [])

# Step 3 abstract extraction
root = ET.parse(efet_path).getroot()
abstract_map = {}
for article in root.findall('.//PubmedArticle'):
    pmid_node = article.find('.//MedlineCitation/PMID')
    if pmid_node is None or pmid_node.text is None:
        continue
    pmid = pmid_node.text.strip()
    parts = []
    for node in article.findall('.//Article/Abstract/AbstractText'):
        txt = ''.join(node.itertext())
        txt = normalize_space(txt)
        if not txt:
            continue
        label = normalize_space(node.attrib.get('Label', ''))
        if label:
            parts.append(f\"{label}: {txt}\")
        else:
            parts.append(txt)
    abstract_map[pmid] = normalize_space(' '.join(parts)) if parts else ''

new_articles = []
for uid in uids:
    rec = result.get(uid, {})
    title = normalize_space(rec.get('title', ''))
    journal = normalize_space(rec.get('source', ''))
    pub_raw = normalize_space(rec.get('pubdate', ''))
    pub_dt = parse_pubdate(pub_raw)
    if not pub_dt:
        continue
    if not (CUTOFF <= pub_dt <= TODAY):
        continue
    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = normalize_space(abstract_map.get(uid, ''))
    if not summary:
        summary = 'No abstract available in source.'

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Autism',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_dt.isoformat(),
        'date': TODAY_STR,
    })

# merge with existing file if present
existing_articles = []
if out_path.exists():
    try:
        old = json.loads(out_path.read_text())
        if isinstance(old, dict) and isinstance(old.get('articles'), list):
            for a in old['articles']:
                if isinstance(a, dict):
                    existing_articles.append({
                        'title': normalize_space(str(a.get('title', ''))),
                        'summary': normalize_space(str(a.get('summary', ''))) or 'No abstract available in source.',
                        'url': normalize_space(str(a.get('url', ''))),
                        'category': 'Autism',
                        'source': 'pubmed',
                        'journal': normalize_space(str(a.get('journal', ''))),
                        'published_date': normalize_space(str(a.get('published_date', ''))),
                        'date': TODAY_STR,
                    })
    except Exception:
        existing_articles = []

merged = []
seen = set()
for art in new_articles + existing_articles:
    u = art.get('url', '')
    if not u or u in seen:
        continue
    seen.add(u)
    merged.append(art)

# sort by published_date desc then title
merged.sort(key=lambda x: (x.get('published_date',''), x.get('title','')), reverse=True)

output = {
    'date': TODAY_STR,
    'articles': merged,
}

out_path.parent.mkdir(parents=True, exist_ok=True)
out_path.write_text(json.dumps(output, ensure_ascii=False, indent=2) + '\\n')

