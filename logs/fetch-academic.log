        "journal": (art.get("journal") or "").strip(),
        "published_date": (art.get("published_date") or "").strip(),
        "date": TODAY_STR,
    })

# 仅保留有 URL 的记录，并按 published_date 倒序、url 排序稳定输出
normalized = [a for a in normalized if a["url"]]
normalized.sort(key=lambda x: (x.get("published_date", ""), x.get("url", "")), reverse=True)

output = {
    "date": TODAY_STR,
    "articles": normalized,
}

os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
with open(OUT_PATH, "w", encoding="utf-8") as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f"new={len(new_articles)} merged={len(normalized)} out={OUT_PATH}")
