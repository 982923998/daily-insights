      next unless "'$pmid;
      my @abs = ($a =~ m{<AbstractText(?:'"\\s+["'^>]*)?>(.*?)</AbstractText>}sg);
      @abs = map { my $t=$_; $t =~ s/<[''^>]+>//g; $t =~ s/&lt;/</g; $t =~ s/&gt;/>/g; $t =~ s/&amp;/&/g; $t =~ s/'"\\s+/ /g; "'$t =~ s/''^'"\\s+|\\s+"'$//g; $t } @abs;
      my $joined = join(" ", grep { length($_) } @abs);
      push @out, { pmid=>$pmid, summary=>$joined };
