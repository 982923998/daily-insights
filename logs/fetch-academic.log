        | "'"\\("'$c.y)-'"\\(mon("'$c.m))-01"
      elif ($s|test("''^[0-9]{4}")) then
        ($s|capture("''^(?<y>[0-9]{4})")|.y) as $y
        | "'"\\("'$y)-01-01"
      else "" end;
  (.[0].result) as $r
  | (.[1]) as $abs
  | [ $r.uids[] as $id
      | $r[$id]
      | {
          title: (.title // ""),
          summary: (($abs[$id] // "") | if length>0 then . else "No abstract available in source." end),
          url: ("https://pubmed.ncbi.nlm.nih.gov/" + $id + "/"),
          category: "ADHD",
