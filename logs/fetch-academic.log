/bin/zsh -lc "python3 - <<'PY'
import datetime as dt
import json
import os
import re
import xml.etree.ElementTree as ET

TODAY = dt.date(2026, 3, 3)
START = TODAY - dt.timedelta(days=2)
TODAY_STR = TODAY.isoformat()
OUT_PATH = '/Users/chenmayao/Projects/daily-insights/data/2026-03-03-ad.json'

with open('/tmp/ad_esearch.json', 'r', encoding='utf-8') as f:
    esearch = json.load(f)
with open('/tmp/ad_esummary.json', 'r', encoding='utf-8') as f:
    esummary = json.load(f)

root = ET.parse('/tmp/ad_efetch.xml').getroot()

month_map = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}

def normalize_text(text: str) -> str:
    return ' '.join((text or '').split())

def parse_pubdate(pubdate: str, sortpubdate: str = ''):
    s = normalize_text(pubdate)
    if not s:
        s = normalize_text(sortpubdate)
    if not s:
        return None

    # Keep only left-most date-bearing segment
    for sep in [';', '(', '[']:
        if sep in s:
            s = s.split(sep, 1)[0].strip()

    # Direct YYYY/MM/DD fallback pattern
    m = re.match(r'"'^('"\\d{4})/(\\d{2})/(\\d{2})', s)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return dt.date(y, mo, d)
        except ValueError:
            return None

    # Year only
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return dt.date(int(m.group(1)), 1, 1)

    # Year + month range (e.g. 2026 Jan-Mar)
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]+)\\s*-\\s*[A-Za-z]+"'$'"', s)
    if m:
        y = int(m.group(1))
        mo = month_map.get(m.group(2).lower())
        if mo:
            return dt.date(y, mo, 1)

    # Year + month + day
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]+)\\s+(\\d{1,2})"'$'"', s)
    if m:
        y = int(m.group(1))
        mo = month_map.get(m.group(2).lower())
        d = int(m.group(3))
        if mo:
            try:
                return dt.date(y, mo, d)
            except ValueError:
                return None

    # Year + month (fill day=01)
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]+)"'$'"', s)
    if m:
        y = int(m.group(1))
        mo = month_map.get(m.group(2).lower())
        if mo:
            return dt.date(y, mo, 1)

    # Fallback to sortpubdate if available
    sp = normalize_text(sortpubdate)
    m = re.match(r'"'^('"\\d{4})/(\\d{2})/(\\d{2})', sp)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return dt.date(y, mo, d)
        except ValueError:
            return None
    return None

# Parse abstracts by PMID
abstract_by_pmid = {}
for article in root.findall('.//PubmedArticle'):
    pmid = article.findtext('.//MedlineCitation/PMID') or article.findtext('.//PMID')
    if not pmid:
        continue
    blocks = []
    for node in article.findall('.//Abstract/AbstractText'):
        text = normalize_text(''.join(node.itertext()))
        if not text:
            continue
        label = normalize_text(node.attrib.get('Label', ''))
        if label:
            blocks.append(f'{label}: {text}')
        else:
            blocks.append(text)
    summary = normalize_text(' '.join(blocks))
    abstract_by_pmid[str(pmid)] = summary

uids = esearch.get('esearchresult', {}).get('idlist', [])
res = esummary.get('result', {})

new_articles = []
for pmid in uids:
    item = res.get(str(pmid), {})
    if not item:
        continue

    pub = parse_pubdate(item.get('pubdate', ''), item.get('sortpubdate', ''))
    if pub is None:
        continue
    if not (START <= pub <= TODAY):
        continue

    title = normalize_text(item.get('title', ''))
    journal = normalize_text(item.get('source', ''))
    summary = abstract_by_pmid.get(str(pmid), '')
    if not summary:
        summary = 'No abstract available in source.'

    words = summary.split()
    if summary "'!= '"'No abstract available in source.' and len(words) > 200:
        summary = ' '.join(words[:200]).rstrip() + '...'

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{pmid}/',
        'category': 'Alzheimer',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub.isoformat(),
        'date': TODAY_STR,
    })

existing_articles = []
if os.path.exists(OUT_PATH):
    try:
        with open(OUT_PATH, 'r', encoding='utf-8') as f:
            old = json.load(f)
        if isinstance(old, dict) and isinstance(old.get('articles'), list):
            existing_articles = old['articles']
    except Exception:
        existing_articles = []

combined = existing_articles + new_articles
seen = set()
deduped = []
for art in combined:
    if not isinstance(art, dict):
        continue
    url = normalize_text(art.get('url', ''))
    key = url if url else normalize_text(art.get('title', ''))
    if not key or key in seen:
        continue
    seen.add(key)

    summary = normalize_text(art.get('summary', ''))
    if not summary:
        summary = 'No abstract available in source.'

    published_date = normalize_text(art.get('published_date', ''))
    # Keep only valid YYYY-MM-DD in final output
    if not re.match(r'"'^'"\\d{4}-\\d{2}-\\d{2}"'$'"', published_date):
        continue

    deduped.append({
        'title': normalize_text(art.get('title', '')),
        'summary': summary,
        'url': url,
        'category': 'Alzheimer',
        'source': 'pubmed',
        'journal': normalize_text(art.get('journal', art.get('source_name', art.get('journal_name', '')))),
        'published_date': published_date,
        'date': TODAY_STR,
    })

deduped.sort(key=lambda x: (x['published_date'], x['url']), reverse=True)

output = {
    'date': TODAY_STR,
    'articles': deduped,
}

os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
with open(OUT_PATH, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f'written: {OUT_PATH}')
print(f'new_articles: {len(new_articles)}')
print(f'final_articles: {len(deduped)}')
