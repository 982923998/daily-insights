python3 - <<'PY'
import json, re
from datetime import date, datetime, timedelta
import xml.etree.ElementTree as ET

TARGET_DATE = date(2026,3,18)
start_date = TARGET_DATE - timedelta(days=2)

with open('/tmp/ad_esummary.json','r',encoding='utf-8') as f:
    s = json.load(f)

# PMID -> abstract summary
pmid_to_abs = {}
try:
    tree = ET.parse('/tmp/ad_efetch.xml')
    root = tree.getroot()
    for art in root.findall('.//PubmedArticle'):
        pmid_el = art.find('.//MedlineCitation/PMID')
        if pmid_el is None or not (pmid_el.text or '').strip():
            continue
        pmid = pmid_el.text.strip()
        abstract_nodes = art.findall('.//Abstract/AbstractText')
        parts = []
        for n in abstract_nodes:
            text = ''.join(n.itertext()).strip()
            if text:
                parts.append(text)
        pmid_to_abs[pmid] = ' '.join(parts).strip()
except Exception:
    pass

months = {m:i for i,m in enumerate(['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],1)}

def parse_pubdate(raw:str):
    if not raw:
        return None
    raw = raw.strip()
    # normalize separators
    raw = raw.replace('/', ' ').replace('.', ' ')
    raw = re.sub(r'\\s+', ' ', raw)
    # common formats
    for fmt in ('%Y %b %d','%Y %B %d','%Y-%m-%d','%Y %m %d'):
        try:
            return datetime.strptime(raw, fmt).date()
        except Exception:
            pass
    # year month
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9}|\\d{1,2})(?:\\b.*)?"'$'"', raw)
    if m:
        y = int(m.group(1))
        mon = m.group(2)
        if mon.isdigit():
            mm = int(mon)
        else:
            mon3 = mon[:3].title()
            mm = months.get(mon3)
        if mm and 1 <= mm <= 12:
            return date(y, mm, 1)
    # year only
    m = re.match(r'"'^('"\\d{4})(?:\\b.*)?"'$'"', raw)
    if m:
        return date(int(m.group(1)), 1, 1)
    return None

articles = []
res = s.get('result', {})
for uid in res.get('uids', []):
    item = res.get(uid, {})
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    pub_raw = (item.get('pubdate') or '').strip()
    pub_dt = parse_pubdate(pub_raw)
    if pub_dt is None:
        continue
    if not (start_date <= pub_dt <= TARGET_DATE):
        continue
    pmid = str(item.get('uid') or uid)
    url = f'https://pubmed.ncbi.nlm.nih.gov/{pmid}/'
    summary = (pmid_to_abs.get(pmid) or '').strip() or 'No abstract available in source.'
    articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Alzheimer',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_dt.isoformat(),
        'date': TARGET_DATE.isoformat(),
    })

# dedup within new set by url
seen = set()
deduped = []
for a in articles:
    u = a['url']
    if u in seen:
        continue
    seen.add(u)
    deduped.append(a)

with open('/tmp/ad_new_articles.json','w',encoding='utf-8') as f:
    json.dump(deduped, f, ensure_ascii=False, indent=2)
