      if [[ "$norm_date" < "$START_DATE" || "$norm_date" > "$TODAY" ]]; then
        continue
      fi

      abstract=$(awk -F'"'\\t' -v id=\""'$uid" '"'"'$1==id {sub($1 FS,""); print; exit}'"' \""'$TMP_DIR/abstracts.tsv")
      if [[ -z "$abstract" ]]; then
        abstract='"'No abstract available in source.'
      fi

      article="'$(jq -cn '"\\
        --arg title \""'$title" '"\\
        --arg summary \""'$abstract" '"\\
        --arg url \"https://pubmed.ncbi.nlm.nih.gov/"'${uid}/" '"\\
        --arg category \"Alzheimer\" \\
        --arg source \"pubmed\" \\
        --arg journal \""'$journal" '"\\
        --arg published_date \""'$norm_date" '"\\
        --arg date \""'$TODAY" '"\\
        '{title:"'$title, summary:$summary, url:$url, category:$category, source:$source, journal:$journal, published_date:$published_date, date:$date}'"')

      if [[ "'$first -eq 1 ]]; then
        first=0
      else
        echo '"','
      fi
      echo \""'$article"
    done < <(jq -r '"'.result.uids[] as "'$id | [ $id, (.result[$id].title // ""), (.result[$id].source // ""), (.result[$id].pubdate // "") ] | @tsv'"' \""'$TMP_DIR/esummary.json")
    echo '"']'
  } > \""'$TMP_DIR/new_articles.json"
fi

if [[ -f "$TARGET" ]]; then
  jq -s --arg date "$TODAY" '"'
    ((.[1] // []) + (.[0].articles // [])) as "'$all
    | reduce $all[] as $a ([];
        if (($a.url // "") == "") then .
        elif any(.[]; .url == $a.url) then .
        else . + [$a]
        end
      )
    | {date:$date, articles:.}
  '"' \""'$TARGET" "$TMP_DIR/new_articles.json" > "$TMP_DIR/final.json"
else
  jq -n --arg date "$TODAY" --slurpfile arr "$TMP_DIR/new_articles.json" '"'{date:"'$date, articles:($arr[0] // [])}'"' > \""'$TMP_DIR/final.json"
fi

mv "$TMP_DIR/final.json" "$TARGET"
jq '"'{date, count:(.articles|length)}' \""'$TARGET"
