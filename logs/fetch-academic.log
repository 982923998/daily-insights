import json
import re
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta
from pathlib import Path

base = Path('/Users/chenmayao/Projects/daily-insights')
esummary_path = Path('/tmp/ad_esummary.json')
efet_path = Path('/tmp/ad_efetch.xml')
out_path = base / 'data/2026-03-24-ad.json'

today_str = '2026-03-24'
today = datetime.strptime(today_str, '%Y-%m-%d').date()
start = today - timedelta(days=2)

with esummary_path.open('r', encoding='utf-8') as f:
    es = json.load(f)

# Parse abstracts keyed by PMID
xml_text = efet_path.read_text(encoding='utf-8', errors='ignore')
root = ET.fromstring(xml_text)
abstract_by_pmid = {}
for article in root.findall('.//PubmedArticle'):
    pmid_el = article.find('.//MedlineCitation/PMID')
    if pmid_el is None or not (pmid_el.text or '').strip():
        continue
    pmid = (pmid_el.text or '').strip()
    parts = []
    for ab in article.findall('.//Article/Abstract/AbstractText'):
        text = ''.join(ab.itertext()).strip()
        if not text:
            continue
        label = (ab.attrib.get('Label') or '').strip()
        if label and not text.lower().startswith(label.lower()):
            parts.append(f'{label}: {text}')
        else:
            parts.append(text)
    summary = ' '.join(parts).strip()
    if summary:
        summary = re.sub(r'\\s+', ' ', summary)
    abstract_by_pmid[pmid] = summary

month_map = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}

def parse_pubdate(s: str):
    if not s:
        return None
    s = s.strip()
    s = re.sub(r'\\s+', ' ', s)

    # direct ISO-like first
    for pat in ('%Y-%m-%d', '%Y/%m/%d', '%Y %m %d'):
        try:
            return datetime.strptime(s, pat).date()
        except ValueError:
            pass

    # Extract first date-like chunk (e.g. \"2026 Mar 24\" from ranges)
    m = re.search(r'(\\d{4})[\\s\\-/]([A-Za-z]{3,9}|\\d{1,2})(?:[\\s\\-/](\\d{1,2}))?', s)
    if m:
        year = int(m.group(1))
        mon_raw = m.group(2)
        day_raw = m.group(3)

        if mon_raw.isdigit():
            month = int(mon_raw)
        else:
            month = month_map.get(mon_raw.lower().rstrip('.'))
        if not month:
            return None
        day = int(day_raw) if day_raw else 1
        try:
            return datetime(year, month, day).date()
        except ValueError:
            return None

    # year only
    m2 = re.fullmatch(r'(\\d{4})', s)
    if m2:
        return datetime(int(m2.group(1)), 1, 1).date()

    return None

articles = []
for uid in es.get('result', {}).get('uids', []):
    item = es['result'].get(uid, {})
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    pub_candidates = [
        item.get('pubdate') or '',
        item.get('sortpubdate') or '',
        item.get('epubdate') or '',
    ]

    pub_date = None
    for cand in pub_candidates:
        pub_date = parse_pubdate(cand)
        if pub_date:
            break

    # mandatory secondary filter: published_date within last 3 days
    if not pub_date or not (start <= pub_date <= today):
        continue

    pmid = str(item.get('uid') or uid)
    summary = abstract_by_pmid.get(pmid, '').strip() or 'No abstract available in source.'
    url = f'https://pubmed.ncbi.nlm.nih.gov/{pmid}/'

    articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Alzheimer',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_date.isoformat(),
        'date': today_str,
    })

# dedupe by url
seen = set()
new_dedup = []
for a in articles:
    u = a.get('url', '')
    if not u or u in seen:
        continue
    seen.add(u)
    new_dedup.append(a)

existing_articles = []
if out_path.exists():
    try:
        with out_path.open('r', encoding='utf-8') as f:
            existing = json.load(f)
            if isinstance(existing, dict) and isinstance(existing.get('articles'), list):
                existing_articles = existing['articles']
    except Exception:
        existing_articles = []

merged = []
seen_urls = set()
for a in existing_articles + new_dedup:
    u = a.get('url', '')
    if not u or u in seen_urls:
        continue
    seen_urls.add(u)
    # enforce required fields on merged entries too
    merged.append({
        'title': a.get('title', ''),
        'summary': (a.get('summary') or '').strip() or 'No abstract available in source.',
        'url': u,
        'category': 'Alzheimer',
        'source': a.get('source', 'pubmed') or 'pubmed',
        'journal': a.get('journal', ''),
        'published_date': a.get('published_date', ''),
        'date': a.get('date', today_str) or today_str,
    })

final_obj = {'date': today_str, 'articles': merged}
out_path.parent.mkdir(parents=True, exist_ok=True)
with out_path.open('w', encoding='utf-8') as f:
    json.dump(final_obj, f, ensure_ascii=False, indent=2)

print(f'wrote={out_path}')
print(f'new_after_filter={len(new_dedup)}')
print(f'merged_total={len(merged)}')
