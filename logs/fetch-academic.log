import json, re
from datetime import datetime, timedelta
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY = datetime(2026,3,21).date()
START = TODAY - timedelta(days=2)
out_file = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-21-autism.json')

esummary = json.loads(Path('/tmp/autism_esummary.json').read_text())
result = esummary.get('result', {})
uids = result.get('uids', [])

# parse abstracts from efetch xml
xml_text = Path('/tmp/autism_efetch.xml').read_text()
root = ET.fromstring(xml_text)
abstract_by_pmid = {}
for article in root.findall('.//PubmedArticle'):
    pmid_el = article.find('.//MedlineCitation/PMID')
    if pmid_el is None or pmid_el.text is None:
        continue
    pmid = pmid_el.text.strip()
    texts = []
    for ab in article.findall('.//Abstract/AbstractText'):
        t = ''.join(ab.itertext()).strip()
        if t:
            label = ab.attrib.get('Label')
            if label:
                t = f\"{label}: {t}\"
            texts.append(t)
    abstract_by_pmid[pmid] = '\\n'.join(texts).strip()

month_map = {
    'Jan':1,'Feb':2,'Mar':3,'Apr':4,'May':5,'Jun':6,
    'Jul':7,'Aug':8,'Sep':9,'Oct':10,'Nov':11,'Dec':12
}

def normalize_pubdate(pubdate: str) -> str:
    s = (pubdate or '').strip()
    if not s:
        return ''
    # common patterns from esummary: \"2026 Mar 20\", \"2026 Mar\", \"2026\", \"2026-03-20\"
    m = re.match(r'"'^('"\\d{4})-(\\d{2})-(\\d{2})"'$'"', s)
    if m:
        return s
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y, mon, d = int(m.group(1)), month_map.get(m.group(2).title()), int(m.group(3))
        if mon:
            return f\"{y:04d}-{mon:02d}-{d:02d}\"
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})"'$'"', s)
    if m:
        y, mon = int(m.group(1)), month_map.get(m.group(2).title())
        if mon:
            return f\"{y:04d}-{mon:02d}-01\"
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return f\"{int(m.group(1)):04d}-01-01\"
    # fallback: extract first YYYY-MM-DD if present
    m = re.search(r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', s)
    if m:
        y, mo, d = map(int, m.groups())
        return f\"{y:04d}-{mo:02d}-{d:02d}\"
    return ''

new_articles = []
for uid in uids:
    item = result.get(uid, {})
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    pub_raw = (item.get('pubdate') or '').strip()
    published_date = normalize_pubdate(pub_raw)

    # required second filter: keep only published_date within last 3 days
    keep = False
    if published_date:
        try:
            d = datetime.strptime(published_date, '%Y-%m-%d').date()
            keep = START <= d <= TODAY
        except ValueError:
            keep = False
    if not keep:
        continue

    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = (abstract_by_pmid.get(uid) or '').strip() or 'No abstract available in source.'

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Autism',
        'source': 'pubmed',
        'journal': journal,
