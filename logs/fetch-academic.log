TERM_ENCODED='(%22Depressive+Disorder%22%5BMesh%5D+OR+%22depression%22%5BTitle%2FAbstract%5D+OR+%22depressive%22%5BTitle%2FAbstract%5D+OR+%22MDD%22%5BTitle%2FAbstract%5D+OR+%22major+depressive%22%5BTitle%2FAbstract%5D)+AND+(%22MRI%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance+imaging%22%5BTitle%2FAbstract%5D+OR+%22brain+MRI%22%5BTitle%2FAbstract%5D+OR+%22structural+MRI%22%5BTitle%2FAbstract%5D+OR+%22fMRI%22%5BTitle%2FAbstract%5D+OR+%22functional+MRI%22%5BTitle%2FAbstract%5D+OR+%22resting-state%22%5BTitle%2FAbstract%5D+OR+%22resting+state+fMRI%22%5BTitle%2FAbstract%5D+OR+%22functional+connectivity%22%5BTitle%2FAbstract%5D+OR+%22BOLD%22%5BTitle%2FAbstract%5D+OR+%22DTI%22%5BTitle%2FAbstract%5D+OR+%22diffusion+tensor+imaging%22%5BTitle%2FAbstract%5D+OR+%22diffusion+MRI%22%5BTitle%2FAbstract%5D+OR+%22tractography%22%5BTitle%2FAbstract%5D+OR+%22VBM%22%5BTitle%2FAbstract%5D+OR+%22voxel-based+morphometry%22%5BTitle%2FAbstract%5D+OR+%22cortical+thickness%22%5BTitle%2FAbstract%5D+OR+%22brain+volume%22%5BTitle%2FAbstract%5D+OR+%22gray+matter%22%5BTitle%2FAbstract%5D+OR+%22white+matter%22%5BTitle%2FAbstract%5D+OR+%22neuroimaging%22%5BTitle%2FAbstract%5D+OR+%22brain+imaging%22%5BTitle%2FAbstract%5D+OR+%22brain+mapping%22%5BTitle%2FAbstract%5D+OR+%22connectome%22%5BTitle%2FAbstract%5D+OR+%22MRS%22%5BTitle%2FAbstract%5D+OR+%22magnetic+resonance+spectroscopy%22%5BTitle%2FAbstract%5D+OR+%22arterial+spin+labeling%22%5BTitle%2FAbstract%5D+OR+%22ASL%22%5BTitle%2FAbstract%5D+OR+%22perfusion+MRI%22%5BTitle%2FAbstract%5D)'

# Step 1: esearch
curl -s \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term="'${TERM_ENCODED}&reldate=3&datetype=crdt&retmax=100&retmode=json" > /tmp/depression_esearch.json

IDLIST=$(jq -r '"'.esearchresult.idlist | join(\",\")' /tmp/depression_esearch.json)

if [ -z \""'$IDLIST" ]; then
  echo '"'{\"date\":\"2026-03-06\",\"articles\":[]}' > /tmp/depression_new_articles.json
else
  # Step 2: esummary
  curl -s \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&id="'${IDLIST}&retmode=json" > /tmp/depression_esummary.json

  # Step 3: efetch
  curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=${IDLIST}&retmode=xml&rettype=abstract" > /tmp/depression_efetch.xml

  # Parse abstracts by PMID
  perl -MXML::LibXML -MJSON::PP -e '"'
    my "'$doc = XML::LibXML->load_xml(location => "/tmp/depression_efetch.xml");
    my %abs;
    for my $article ($doc->findnodes("//PubmedArticle | //PubmedBookArticle")) {
      my $pmid = $article->findvalue("./MedlineCitation/PMID | ./BookDocument/PMID");
      next unless $pmid;
      my @parts;
      for my $node ($article->findnodes(".//Abstract/AbstractText")) {
        my $label = $node->getAttribute("Label") // "";
        my $text = $node->textContent // "";
        $text =~ s/'"\\s+/ /g;
        "'$text =~ s/''^'"\\s+|\\s+"'$//g;
        next unless length $text;
        if (length $label) {
          push @parts, "$label: $text";
        } else {
          push @parts, $text;
        }
      }
      my $summary = join(" ", @parts);
      $summary =~ s/'"\\s+/ /g;
      "'$summary =~ s/''^'"\\s+|\\s+"'$//g;
      $abs{$pmid} = $summary if length $summary;
    }
    print encode_json('"\\%abs);
  ' > /tmp/depression_abstracts.json

  # Build new article array and apply secondary date filter
  jq --arg today \""'$TODAY" --arg cutoff "$CUTOFF" --slurpfile abs /tmp/depression_abstracts.json '"'
    def trimws: gsub(\"\\\\s+\";\" \") | sub(\""'^'"\\\\s+\";\"\") | sub(\"\\\\s+"'$";"");
    def norm_pubdate:
      trimws
      | split(";")[0]
      | split(":")[0]
      | trimws;
    def to_iso:
      . as $d
      | (
          try ($d | strptime("%Y-%m-%d") | strftime("%Y-%m-%d")) catch
          try ($d | strptime("%Y %b %d") | strftime("%Y-%m-%d")) catch
          try ($d | strptime("%Y %B %d") | strftime("%Y-%m-%d")) catch
          try ($d | strptime("%Y %b") | strftime("%Y-%m-01")) catch
          try ($d | strptime("%Y %B") | strftime("%Y-%m-01")) catch
          try ($d | strptime("%Y-%m") | strftime("%Y-%m-01")) catch
          try ($d | strptime("%Y") | strftime("%Y-01-01")) catch
          ""
        );

    .result as $r
    | [ $r.uids[] as $id
        | ($r[$id]) as $item
        | (($item.pubdate // "") | norm_pubdate | to_iso) as $published
        | select($published != "" and $published >= $cutoff and $published <= $today)
        | {
            title: (($item.title // "") | trimws),
            summary: ((($abs[0][$id] // "") | trimws) // ""),
            url: "https://pubmed.ncbi.nlm.nih.gov/'"\\("'$id)/",
            category: "Depression",
            source: "pubmed",
            journal: (($item.source // "") | trimws),
            published_date: $published,
            date: $today
          }
        | .summary = (if .summary == "" then "No abstract available in source." else .summary end)
      ]
  '"' /tmp/depression_esummary.json > /tmp/depression_new_articles.json
fi

# Prepare existing file for merge
if [ -f \""'$OUT" ]; then
