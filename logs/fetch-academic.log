import json
import os
import re
from datetime import date, datetime, timedelta
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY = datetime.strptime(os.environ['TODAY'], '%Y-%m-%d').date()
WINDOW_START = TODAY - timedelta(days=2)
OUTPUT_PATH = Path(os.environ['OUTPUT'])

NO_ABSTRACT = 'No abstract available in source.'

with open('/tmp/pd_esummary.json', 'r', encoding='utf-8') as f:
    esummary = json.load(f)

xml_text = Path('/tmp/pd_efetch.xml').read_text(encoding='utf-8', errors='ignore')

MONTH_MAP = {
    'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,
    'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12,
}


def parse_pubdate(raw: str) -> str:
    if not raw:
        return ''
    s = str(raw).strip()
    if not s:
        return ''
    s = s.split(';')[0].strip()

    m = re.search(r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', s)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return date(y, mo, d).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    m = re.search(r'\\b(\\d{4})[-/](\\d{1,2})\\b', s)
    if m:
        y, mo = map(int, m.groups())
        try:
            return date(y, mo, 1).strftime('%Y-%m-%d')
        except ValueError:
            return ''

    m = re.search(r'\\b(\\d{4})\\b', s)
    year = int(m.group(1)) if m else None

    m2 = re.search(r'(\\d{4})\\s+([A-Za-z]{3,9})(?:[-\\s]+(\\d{1,2}))?', s)
    if m2:
        y = int(m2.group(1))
        month_token = m2.group(2).split('-')[0][:3].lower()
        mo = MONTH_MAP.get(month_token)
        d = int(m2.group(3)) if m2.group(3) else 1
        if mo:
            try:
                return date(y, mo, d).strftime('%Y-%m-%d')
            except ValueError:
                return ''

    if year:
        try:
            return date(year, 1, 1).strftime('%Y-%m-%d')
        except ValueError:
            return ''
    return ''


def in_recent_three_days(yyyy_mm_dd: str) -> bool:
    try:
        d = datetime.strptime(yyyy_mm_dd, '%Y-%m-%d').date()
    except Exception:
        return False
    return WINDOW_START <= d <= TODAY


def clean_text(text: str) -> str:
    return re.sub(r'\\s+', ' ', (text or '')).strip()


# PMID -> abstract
abstract_map = {}
if xml_text.strip():
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError:
        root = None
    if root is not None:
        for article in root.findall('.//PubmedArticle'):
            pmid_el = article.find('./MedlineCitation/PMID')
            if pmid_el is None or not (pmid_el.text or '').strip():
                continue
            pmid = pmid_el.text.strip()
            abs_nodes = article.findall('.//Article/Abstract/AbstractText')
            parts = []
            for node in abs_nodes:
                txt = clean_text(''.join(node.itertext()))
                if not txt:
                    continue
                label = clean_text(node.attrib.get('Label', ''))
                if label:
                    parts.append(f'{label}: {txt}')
                else:
                    parts.append(txt)
            abstract_map[pmid] = clean_text(' '.join(parts))


# New articles from esummary + efetch
result = esummary.get('result', {}) if isinstance(esummary, dict) else {}
uids = result.get('uids', []) if isinstance(result, dict) else []
new_articles = []
for uid in uids:
    item = result.get(uid, {})
    if not isinstance(item, dict):
        continue

    published_date = parse_pubdate(item.get('pubdate', ''))
    if not published_date or not in_recent_three_days(published_date):
        continue

    title = clean_text(item.get('title', ''))
    url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
    journal = clean_text(item.get('source', ''))
    summary = clean_text(abstract_map.get(uid, ''))
    if not summary:
        summary = NO_ABSTRACT

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': 'Parkinson',
        'source': 'pubmed',
        'journal': journal,
        'published_date': published_date,
        'date': TODAY.strftime('%Y-%m-%d'),
    })


# Merge with existing file if present
existing_articles = []
if OUTPUT_PATH.exists():
    try:
        existing_obj = json.loads(OUTPUT_PATH.read_text(encoding='utf-8'))
        raw_existing = existing_obj.get('articles', []) if isinstance(existing_obj, dict) else []
    except Exception:
        raw_existing = []

    for a in raw_existing:
        if not isinstance(a, dict):
            continue
        url = clean_text(a.get('url', ''))
        if not url:
            continue
        published_date = clean_text(a.get('published_date', ''))
        if not published_date:
            continue
        summary = clean_text(a.get('summary', '')) or NO_ABSTRACT
        existing_articles.append({
            'title': clean_text(a.get('title', '')),
            'summary': summary,
            'url': url,
            'category': 'Parkinson',
            'source': 'pubmed',
            'journal': clean_text(a.get('journal', '')),
            'published_date': published_date,
            'date': TODAY.strftime('%Y-%m-%d'),
        })

combined = new_articles + existing_articles
seen = set()
deduped = []
for a in combined:
    u = a['url']
    if u in seen:
        continue
    seen.add(u)
    deduped.append(a)

deduped.sort(key=lambda x: (x['published_date'], x['url']), reverse=True)

output = {
    'date': TODAY.strftime('%Y-%m-%d'),
    'articles': deduped,
}

OUTPUT_PATH.write_text(json.dumps(output, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')
print(f'wrote {OUTPUT_PATH} with {len(deduped)} articles')
