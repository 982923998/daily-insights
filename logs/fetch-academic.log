import json
import re
from datetime import datetime, timedelta
from pathlib import Path
import xml.etree.ElementTree as ET

TODAY_STR = \"2026-03-06\"
TODAY = datetime.strptime(TODAY_STR, \"%Y-%m-%d\").date()
CUTOFF = TODAY - timedelta(days=2)  # 最近3天（含今天）

base = Path('/tmp/academic_search_adhd_20260306')
esummary_path = base / 'esummary.json'
efet_path = base / 'efetch.xml'
out_path = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-06-adhd.json')


def parse_pubdate(pubdate: str):
    if not pubdate:
        return None
    text = re.sub(r'\\s+', ' ', pubdate.strip())
    patterns = [
        '%Y %b %d',
        '%Y %B %d',
        '%Y-%m-%d',
        '%Y/%m/%d',
        '%Y %b',
        '%Y %B',
        '%Y-%m',
        '%Y/%m',
        '%Y',
    ]
    for pattern in patterns:
        try:
            dt = datetime.strptime(text, pattern)
            if pattern in ('%Y %b', '%Y %B', '%Y-%m', '%Y/%m'):
                dt = dt.replace(day=1)
            elif pattern == '%Y':
                dt = dt.replace(month=1, day=1)
            return dt.date()
        except ValueError:
            continue

    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})(?:\\s+(\\d{1,2}))?', text)
    if m:
        y, mon, day = m.groups()
        day = day or '1'
        for mp in ('%Y %b %d', '%Y %B %d'):
            try:
                return datetime.strptime(f'{y} {mon} {day}', mp).date()
            except ValueError:
                continue
    return None


def clean_text(text: str) -> str:
    return re.sub(r'\\s+', ' ', (text or '').strip())

abstracts = {}
if efet_path.exists() and efet_path.stat().st_size > 0:
    root = ET.parse(efet_path).getroot()
    for article in root.findall('.//PubmedArticle'):
        pmid_node = article.find('.//MedlineCitation/PMID')
        if pmid_node is None or not (pmid_node.text or '').strip():
            continue
        pmid = pmid_node.text.strip()
        parts = []
        for abst in article.findall('.//Abstract/AbstractText'):
            segment = clean_text(''.join(abst.itertext()))
            if not segment:
                continue
            label = clean_text(abst.attrib.get('Label', ''))
            if label:
                parts.append(f'{label}: {segment}')
            else:
                parts.append(segment)
        abstracts[pmid] = clean_text(' '.join(parts))

new_articles = []
if esummary_path.exists() and esummary_path.stat().st_size > 0:
    es = json.loads(esummary_path.read_text(encoding='utf-8'))
    result = es.get('result', {})
    for uid in result.get('uids', []):
        rec = result.get(uid, {})
        title = clean_text(rec.get('title', ''))
        journal = clean_text(rec.get('source', ''))
        pubdate_raw = clean_text(rec.get('pubdate', ''))
        pub_dt = parse_pubdate(pubdate_raw)
        if pub_dt is None:
            continue
        if not (CUTOFF <= pub_dt <= TODAY):
            continue

        summary = clean_text(abstracts.get(uid, ''))
        if not summary:
            summary = 'No abstract available in source.'

        new_articles.append({
            'title': title,
            'summary': summary,
            'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
            'category': 'ADHD',
            'source': 'pubmed',
            'journal': journal,
            'published_date': pub_dt.strftime('%Y-%m-%d'),
            'date': TODAY_STR,
        })

existing_articles = []
if out_path.exists():
    try:
        existing = json.loads(out_path.read_text(encoding='utf-8'))
        if isinstance(existing, dict) and isinstance(existing.get('articles'), list):
            existing_articles = existing['articles']
    except Exception:
        existing_articles = []

combined = []
combined.extend(existing_articles)
combined.extend(new_articles)

by_url = {}
for item in combined:
    if not isinstance(item, dict):
        continue
    url = clean_text(str(item.get('url', '')))
    if not url:
        continue
    fixed = {
        'title': clean_text(str(item.get('title', ''))),
        'summary': clean_text(str(item.get('summary', ''))) or 'No abstract available in source.',
        'url': url,
        'category': 'ADHD',
        'source': 'pubmed',
        'journal': clean_text(str(item.get('journal', ''))),
        'published_date': clean_text(str(item.get('published_date', ''))),
        'date': TODAY_STR,
    }
    by_url[url] = fixed

final_articles = list(by_url.values())


def sort_key(a):
    d = a.get('published_date', '')
    try:
        dd = datetime.strptime(d, '%Y-%m-%d').date()
    except Exception:
        dd = datetime.min.date()
    return (dd, a.get('title', ''))

