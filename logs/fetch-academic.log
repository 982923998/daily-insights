  print "{'"\\n\";
  my @keys = sort keys %m;
  for (my "'$i=0; $i<=$#keys; $i++) {
    my $k = $keys[$i];
    my $v = $m{$k};
    $v =~ s/'"\\\\/\\\\\\\\/g; "'$v =~ s/"/'"\\\\\"/g;
    print \"  \\\""'$k'"\\\": \\\""'$v'"\\\"\";
