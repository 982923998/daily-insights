import json
import re
from datetime import datetime, date, timedelta
import xml.etree.ElementTree as ET
from pathlib import Path

TODAY = date(2026, 3, 21)
START = TODAY - timedelta(days=2)  # 最近3天：today, today-1, today-2

esummary_path = Path('/tmp/ad_esummary.json')
efet_path = Path('/tmp/ad_efetch.xml')
target = Path('/Users/chenmayao/Projects/daily-insights/data/2026-03-21-ad.json')

if not esummary_path.exists() or esummary_path.stat().st_size == 0:
    new_articles = []
else:
    es = json.loads(esummary_path.read_text(encoding='utf-8'))

    # Parse abstracts from efetch XML by PMID
    abstracts = {}
    if efet_path.exists() and efet_path.stat().st_size > 0:
        root = ET.parse(efet_path).getroot()
        for art in root.findall('.//PubmedArticle'):
            pmid_el = art.find('.//MedlineCitation/PMID')
            if pmid_el is None or pmid_el.text is None:
                continue
            pmid = pmid_el.text.strip()
            parts = []
            for ab in art.findall('.//Abstract/AbstractText'):
                txt = ''.join(ab.itertext()).strip()
                if txt:
                    parts.append(txt)
            abstracts[pmid] = ' '.join(parts).strip()

    def norm_spaces(s: str) -> str:
        return re.sub(r'\\s+', ' ', s).strip()

    MONTHS = {
        'jan':1,'feb':2,'mar':3,'apr':4,'may':5,'jun':6,
        'jul':7,'aug':8,'sep':9,'sept':9,'oct':10,'nov':11,'dec':12
    }

    def parse_pubdate(raw: str):
        if not raw:
            return None
        s = raw.strip()
        s = s.replace('.', ' ')
        s = re.sub(r'\\s+', ' ', s)
        s = re.sub(r'\\b(\\d{4})\\s+[A-Za-z]{3,9}\\s+\\d{1,2}\\s*-\\s*\\d{1,2}\\b', lambda m: m.group(0).split('-')[0].strip(), s)
        s = re.sub(r'\\b(\\d{4})\\s+[A-Za-z]{3,9}\\s*-\\s*[A-Za-z]{3,9}\\b', lambda m: m.group(0).split('-')[0].strip(), s)

        # direct ISO
        m = re.search(r'\\b(\\d{4})-(\\d{2})-(\\d{2})\\b', s)
        if m:
            y, mo, d = map(int, m.groups())
            try:
                return date(y, mo, d)
            except ValueError:
                pass

        # YYYY Mon DD
        m = re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})\\b', s)
        if m:
            y = int(m.group(1))
            mon = MONTHS.get(m.group(2).lower()[:4].rstrip('.'), MONTHS.get(m.group(2).lower()[:3]))
            d = int(m.group(3))
            if mon:
                try:
                    return date(y, mon, d)
                except ValueError:
                    pass

        # YYYY Mon
        m = re.search(r'\\b(\\d{4})\\s+([A-Za-z]{3,9})\\b', s)
        if m:
            y = int(m.group(1))
            mon = MONTHS.get(m.group(2).lower()[:4].rstrip('.'), MONTHS.get(m.group(2).lower()[:3]))
            if mon:
                try:
                    return date(y, mon, 1)
                except ValueError:
                    pass

        # YYYY
        m = re.search(r'\\b(\\d{4})\\b', s)
        if m:
            y = int(m.group(1))
            try:
                return date(y, 1, 1)
            except ValueError:
                pass
        return None

    new_articles = []
    result = es.get('result', {})
    for uid in result.get('uids', []):
        it = result.get(uid, {})
        pub = parse_pubdate(it.get('pubdate', ''))
        if pub is None:
            continue
        if not (START <= pub <= TODAY):
            continue
        title = norm_spaces(it.get('title', '') or '')
        journal = norm_spaces(it.get('source', '') or '')
        url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
        summary = norm_spaces(abstracts.get(uid, '') or '')
        if not summary:
            summary = 'No abstract available in source.'
        new_articles.append({
            'title': title,
            'summary': summary,
            'url': url,
            'category': 'Alzheimer',
            'source': 'pubmed',
            'journal': journal,
            'published_date': pub.isoformat(),
            'date': '2026-03-21'
        })

# Merge with existing if exists, dedupe by url
existing_articles = []
if target.exists():
    try:
        existing = json.loads(target.read_text(encoding='utf-8'))
        if isinstance(existing, dict) and isinstance(existing.get('articles'), list):
            existing_articles = existing['articles']
    except Exception:
        existing_articles = []

by_url = {}
for a in existing_articles:
    u = a.get('url', '') if isinstance(a, dict) else ''
    if u:
        by_url[u] = a
for a in new_articles:
    by_url[a['url']] = a

final_articles = list(by_url.values())
# stable sort by published_date desc then title
final_articles.sort(key=lambda x: (x.get('published_date',''), x.get('title','')), reverse=True)

output = {
    'date': '2026-03-21',
    'articles': final_articles
}

target.parent.mkdir(parents=True, exist_ok=True)
target.write_text(json.dumps(output, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')
print(f'written={target}')
print(f'new_articles={len(new_articles)}')
print(f'final_articles={len(final_articles)}')
