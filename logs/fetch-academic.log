98</ArticleId><ArticleId IdType="doi">10.1016/j.ynirp.2026.100331</ArticleId><ArticleId IdType="pii">S2666-9560(26)00014-0</ArticleId></ArticleIdList></PubmedData></PubmedArticle><PubmedArticle><MedlineCitation Status="Publisher" Owner="NLM"><PMID Version="1">41782064</PMID><DateRevised><Year>2026</Year><Month>03</Month><Day>04</Day></DateRevised><Article PubModel="Print-Electronic"><Journal><ISSN IssnType="Electronic">1758-9193</ISSN><JournalIssue CitedMedium="Internet"><PubDate><Year>2026</Year><Month>Mar</Month><Day>04</Day></PubDate></JournalIssue><Title>Alzheimer's research &amp; therapy</Title><ISOAbbreviation>Alzheimers Res Ther</ISOAbbreviation></Journal><ArticleTitle>&#x3b1;-synuclein positivity is associated with decline in brain microstructure in the Alzheimer's disease spectrum.</ArticleTitle><ELocationID EIdType="doi" ValidYN="Y">10.1186/s13195-026-01995-9</ELocationID><AuthorList CompleteYN="Y"><Author ValidYN="Y"><LastName>Mak</LastName><ForeName>Elijah</ForeName><Initials>E</Initials><AffiliationInfo><Affiliation>Department of Radiology, Mayo Clinic, 200 1st St SW, Rochester, MN, 55905, USA. mak.elijah@mayo.edu.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Przybelski</LastName><ForeName>Scott A</ForeName><Initials>SA</Initials><AffiliationInfo><Affiliation>Department of Quantitative Health Sciences, Mayo Clinic, 200 1st St SW, Rochester, MN, 55905, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Reid</LastName><ForeName>Robert I</ForeName><Initials>RI</Initials><AffiliationInfo><Affiliation>Department of Information Technology, Mayo Clinic, 200 1st St SW, Rochester, MN, 55905, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Wiste</LastName><ForeName>Heather J</ForeName><Initials>HJ</Initials><AffiliationInfo><Affiliation>Department of Quantitative Health Sciences, Mayo Clinic, 200 1st St SW, Rochester, MN, 55905, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN