# Build PMID->abstract map from efetch XML
perl -MXML::LibXML -MJSON::PP -e '
  my "'$doc = XML::LibXML->load_xml(location => "/tmp/pd_efetch.xml");
  my %map;
  for my $article ($doc->findnodes("//PubmedArticle")) {
    my ($pmid_node) = $article->findnodes("./MedlineCitation/PMID");
    next unless $pmid_node;
    my $pmid = $pmid_node->textContent;
    my @texts = map { my $t = $_->textContent; $t =~ s/'"\\s+/ /gr =~ s/"'^'"\\s+|\\s+"'$//gr } $article->findnodes(".//Abstract/AbstractText");
    my $joined = join(" ", grep { length($_) } @texts);
    $joined =~ s/'"\\s+/ /g;
    "'$joined =~ s/''^'"\\s+|\\s+"'$//g;
    $map{$pmid} = $joined;
  }
  print encode_json('"\\%map);
' > /tmp/pd_abstracts.json

