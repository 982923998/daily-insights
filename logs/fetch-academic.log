else
  echo '"'{\"date\":\"2026-03-06\",\"articles\":[]}' > /tmp/depression_existing.json
fi

# Merge + dedupe by url + enforce schema
jq -n --arg today \""'$TODAY" '"\\
  --slurpfile old /tmp/depression_existing.json \\
  --slurpfile new /tmp/depression_new_articles.json '
  def trimws: gsub(\"\\\\s+\";\" \") | sub(\""'^'"\\\\s+\";\"\") | sub(\"\\\\s+"'$";"");
  {
    date: $today,
    articles: (
      (($old[0].articles // []) + ($new[0] // []))
      | map({
          title: ((.title // "") | trimws),
          summary: (((.summary // "") | trimws) as $s | if $s == "" then "No abstract available in source." else $s end),
          url: (.url // ""),
          category: "Depression",
          source: "pubmed",
          journal: ((.journal // "") | trimws),
          published_date: (.published_date // ""),
          date: $today
        })
      | map(select(.url != ""))
      | unique_by(.url)
    )
  }
'"' > \""'$OUT"

