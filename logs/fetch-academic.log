import json
import re
import sys
from datetime import datetime, timedelta, date
import xml.etree.ElementTree as ET
from pathlib import Path

esummary_path, efetch_path, out_path, today_s = sys.argv[1:]

today = datetime.strptime(today_s, "%Y-%m-%d").date()
start_date = today - timedelta(days=2)

month_map = {
    '"'Jan':1,'Feb':2,'Mar':3,'Apr':4,'May':5,'Jun':6,
    'Jul':7,'Aug':8,'Sep':9,'Oct':10,'Nov':11,'Dec':12
}

def parse_pubdate(pubdate: str):
    if not pubdate:
        return None
    s = pubdate.strip()
    s = s.split(';')[0].strip()
    s = s.split('(')[0].strip()
    s = re.sub(r'\\s+', ' ', s)

    # YYYY-MM-DD
    m = re.match(r'"'^('"\\d{4})-(\\d{2})-(\\d{2})"'$'"', s)
    if m:
        try:
            return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
        except ValueError:
            return None

    # YYYY Mon DD
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})"'$'"', s)
    if m and m.group(2).title() in month_map:
        try:
            return date(int(m.group(1)), month_map[m.group(2).title()], int(m.group(3)))
        except ValueError:
            return None

    # YYYY Mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})"'$'"', s)
    if m and m.group(2).title() in month_map:
        try:
            return date(int(m.group(1)), month_map[m.group(2).title()], 1)
        except ValueError:
            return None

    # YYYY
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        try:
            return date(int(m.group(1)), 1, 1)
        except ValueError:
            return None

    # YYYY Mon DD range etc.
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3})\\s+(\\d{1,2})\\b', s)
    if m and m.group(2).title() in month_map:
        try:
            return date(int(m.group(1)), month_map[m.group(2).title()], int(m.group(3)))
        except ValueError:
            return None

    return None

# Build abstract map PMID -> abstract text
abstract_map = {}
xml_text = Path(efetch_path).read_text(encoding='utf-8', errors='ignore').strip()
if xml_text:
    try:
        root = ET.fromstring(xml_text)
        for art in root.findall('.//PubmedArticle'):
            pmid_elem = art.find('.//MedlineCitation/PMID')
            if pmid_elem is None or pmid_elem.text is None:
                continue
            pmid = pmid_elem.text.strip()
            parts = []
            for ab in art.findall('.//Abstract/AbstractText'):
                txt = ''.join(ab.itertext()).strip()
                if txt:
                    label = ab.attrib.get('Label')
                    if label:
                        parts.append(f\"{label}: {txt}\")
                    else:
                        parts.append(txt)
            abstract_map[pmid] = ' '.join(parts).strip()
    except ET.ParseError:
        pass

summary_data = json.loads(Path(esummary_path).read_text(encoding='utf-8', errors='ignore'))
result = summary_data.get('result', {})
uids = result.get('uids', []) or []

new_articles = []
for uid in uids:
    rec = result.get(str(uid), {}) or {}
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    pubdate_raw = (rec.get('pubdate') or '').strip()
    pdate = parse_pubdate(pubdate_raw)
    if pdate is None:
        continue

    # Secondary filter: only published in recent 3 days
    if not (start_date <= pdate <= today):
        continue

    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = abstract_map.get(str(uid), '').strip() or \"No abstract available in source.\"

    new_articles.append({
        \"title\": title,
        \"summary\": summary,
        \"url\": url,
        \"category\": \"Parkinson\",
        \"source\": \"pubmed\",
        \"journal\": journal,
        \"published_date\": pdate.strftime('%Y-%m-%d'),
        \"date\": today_s,
    })

out_file = Path(out_path)
existing = []
if out_file.exists():
    try:
        old = json.loads(out_file.read_text(encoding='utf-8'))
        if isinstance(old, dict) and isinstance(old.get('articles'), list):
            existing = old['articles']
    except Exception:
        existing = []

merged = []
seen = set()
for item in existing + new_articles:
    if not isinstance(item, dict):
        continue
    url = item.get('url', '')
    if not url or url in seen:
        continue
    seen.add(url)

    # normalize required fields and defaults
    summary = (item.get('summary') or '').strip() or \"No abstract available in source.\"
    merged.append({
        \"title\": item.get('title', '') or '',
        \"summary\": summary,
        \"url\": url,
        \"category\": \"Parkinson\",
        \"source\": item.get('source', 'pubmed') or 'pubmed',
        \"journal\": item.get('journal', '') or '',
        \"published_date\": item.get('published_date', '') or '',
        \"date\": today_s,
    })

out = {\"date\": today_s, \"articles\": merged}
out_file.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding='utf-8')
print(f\"wrote {len(merged)} articles to {out_path}\")
PY

