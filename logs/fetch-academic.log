import json
import os
import re
from datetime import date, datetime, timedelta
import xml.etree.ElementTree as ET

TODAY_STR = \"2026-03-09\"
TODAY = date.fromisoformat(TODAY_STR)
START = TODAY - timedelta(days=2)  # recent 3 days inclusive

es_path = \"/tmp/2026-03-09-depression-esummary.json\"
xml_path = \"/tmp/2026-03-09-depression-efetch.xml\"
out_path = \"/Users/chenmayao/Projects/daily-insights/data/2026-03-09-depression.json\"

month_map = {
    \"jan\": 1, \"january\": 1,
    \"feb\": 2, \"february\": 2,
    \"mar\": 3, \"march\": 3,
    \"apr\": 4, \"april\": 4,
    \"may\": 5,
    \"jun\": 6, \"june\": 6,
    \"jul\": 7, \"july\": 7,
    \"aug\": 8, \"august\": 8,
    \"sep\": 9, \"sept\": 9, \"september\": 9,
    \"oct\": 10, \"october\": 10,
    \"nov\": 11, \"november\": 11,
    \"dec\": 12, \"december\": 12,
}


def normalize_pubdate(raw: str):
    if not raw:
        return None
    s = re.sub(r\"[\\.,]+\", \" \", raw).strip()
    s = re.sub(r\"\\s+\", \" \", s)

    m = re.search(r\"(\\d{4})[/-](\\d{1,2})(?:[/-](\\d{1,2}))?\", s)
    if m:
        y = int(m.group(1))
        mo = int(m.group(2))
        d = int(m.group(3) or 1)
        try:
            return date(y, mo, d)
        except ValueError:
            return None

    m = re.match(r\""'^('"\\d{4})"'$", s)
    if m:
        return date(int(m.group(1)), 1, 1)

    m = re.match(r"''^('"\\d{4})\\s+([A-Za-z]{3,9})(?:\\s+(\\d{1,2}))?\", s)
    if m:
        y = int(m.group(1))
        mon_text = m.group(2).lower()
        if mon_text in month_map:
            mo = month_map[mon_text]
            d = int(m.group(3) or 1)
            try:
                return date(y, mo, d)
            except ValueError:
                return None

    return None

# load esummary
if not os.path.exists(es_path):
    data = {\"date\": TODAY_STR, \"articles\": []}
    with open(out_path, \"w\", encoding=\"utf-8\") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(\"wrote_empty_no_esummary\")
    raise SystemExit(0)

with open(es_path, \"r\", encoding=\"utf-8\") as f:
    es = json.load(f)

uids = es.get(\"result\", {}).get(\"uids\", [])

# load abstracts from efetch xml
abstract_by_pmid = {}
if os.path.exists(xml_path):
    tree = ET.parse(xml_path)
    root = tree.getroot()
    for art in root.findall(\".//PubmedArticle\"):
        pmid = art.findtext(\".//MedlineCitation/PMID\")
        if not pmid:
            continue
        chunks = []
        for node in art.findall(\".//Abstract/AbstractText\"):
            txt = \"\".join(node.itertext()).strip()
            if not txt:
                continue
            label = (node.attrib.get(\"Label\") or \"\").strip()
            if label and not txt.lower().startswith(label.lower() + \":\"):
                txt = f\"{label}: {txt}\"
            chunks.append(txt)
        if chunks:
            abstract_by_pmid[pmid] = \"\\n\".join(chunks)

new_articles = []
for uid in uids:
    item = es.get(\"result\", {}).get(uid, {})
    title = (item.get(\"title\") or \"\").strip()
    journal = (item.get(\"source\") or \"\").strip()
    pub_raw = (item.get(\"pubdate\") or \"\").strip()
    parsed = normalize_pubdate(pub_raw)
    if parsed is None:
        continue
    if not (START <= parsed <= TODAY):
        continue

    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = (abstract_by_pmid.get(uid) or \"\").strip() or \"No abstract available in source.\"

    new_articles.append(
        {
            \"title\": title,
            \"summary\": summary,
            \"url\": url,
            \"category\": \"Depression\",
            \"source\": \"pubmed\",
