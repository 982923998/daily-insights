  my ($pmid)=$a=~m|<PMID[''^>]*>('"\\d+)</PMID>|s;
  next unless "'$pmid;
  my @abs=($a=~m|<AbstractText'"\\b["'^>]*>(.*?)</AbstractText>|sg);
  for (@abs) { s/<[''^>]+>/ /g; s/'"\\s+/ /g; s/"'^'"\\s+|\\s+"'$//g; }
  my $txt=join(" ", grep { length($_) } @abs);
  $txt =~ s/'"\\s+/ /g; "'$txt =~ s/''^'"\\s+|\\s+"'$//g;
  print "$pmid'"\\t"'$txt'"\\n\";
}
' \""'$TMP_DIR/efetch.xml" > "$TMP_DIR/abstracts.tsv"

jq -Rn '"'
