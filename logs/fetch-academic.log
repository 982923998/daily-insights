  def normdate(s):
    (s|gsub(\"\\\\s+\";\" \")|gsub(\""'^ +| +$";"")) as $s
    | if ($s|test("''^[0-9]{4} [A-Za-z]{3} [0-9]{1,2}$")) then
        ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3}) (?<d>[0-9]{1,2})$") ) as $c
        | "'"\\("'$c.y)-'"\\(mon("'$c.m))-'"\\(("'$c.d|tonumber|tostring)|if length==1 then "0"+. else . end)"
      elif ($s|test("''^[0-9]{4} [A-Za-z]{3}$")) then
        ($s|capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3})$") ) as $c
        | "'"\\("'$c.y)-'"\\(mon("'$c.m))-01"
      elif ($s|test("''^[0-9]{4}$")) then
        "'"\\("'$s)-01-01"
      elif ($s|test("''^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) then
        $s
      elif ($s|test("''^[0-9]{4} [A-Za-z]{3}-[A-Za-z]{3}$")) then
