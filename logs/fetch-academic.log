/bin/zsh -lc 'set -euo pipefail
base="/Users/chenmayao/Projects/daily-insights"
today="2026-03-21"
start_date=$(date -j -v-2d -f "%Y-%m-%d" "$today" "+%Y-%m-%d")

pmid_csv_file="$base/.tmp/depression_pmids.txt"
esummary_file="$base/.tmp/depression_esummary.json"
efetch_file="$base/.tmp/depression_efetch.xml"
abstract_tsv="$base/.tmp/depression_abstracts.tsv"
abstract_json="$base/.tmp/depression_abstracts.json"
new_articles="$base/.tmp/depression_new_articles.json"
outfile="$base/data/2026-03-21-depression.json"

: > "$abstract_tsv"
if [ -s "$pmid_csv_file" ]; then
  tr '"',' '\\n' < \""'$pmid_csv_file" | while IFS= read -r pmid; do
    [ -n "$pmid" ] || continue
    raw=$(xmllint --xpath "//PubmedArticle[MedlineCitation/PMID='"'"'${pmid}'"']/MedlineCitation/Article/Abstract/AbstractText\" \""'$efetch_file" 2>/dev/null || true)
    if [ -n "$raw" ]; then
      summary=$(printf '"'%s' \""'$raw" | perl -CS -MHTML::Entities -pe '"'decode_entities("'$_); s/<[''^>]+>/ /g; s/'"\\s+/ /g; s/"'^'"\\s+|\\s+"'$//g'"')
    else
      summary=\"\"
    fi
    printf '%s\\t%s\\n' \""'$pmid" "$summary" >> "$abstract_tsv"
  done
fi

jq -Rn '"'
  reduce inputs as "'$line ({};
    ($line | split("'"\\t\"; 2)) as "'$p
    | if ($p|length) >= 2 then . + {($p[0]): $p[1]} else . end
  )
'"' \""'$abstract_tsv" > "$abstract_json"

jq --arg today "$today" --arg start "$start_date" --slurpfile abs "$abstract_json" '"'
  def monthnum(m):
    ({Jan:\"01\",Feb:\"02\",Mar:\"03\",Apr:\"04\",May:\"05\",Jun:\"06\",Jul:\"07\",Aug:\"08\",Sep:\"09\",Oct:\"10\",Nov:\"11\",Dec:\"12\"}[m] // \"01\");
  def parse_pubdate(pub; sort):
    if (pub // \"\") | test(\""'^[0-9]{4}$") then
      "'"\\(pub)-01-01\"
    elif (pub // \"\") | test(\""'^[0-9]{4} [A-Za-z]{3}$") then
      (pub | capture("(?<y>[0-9]{4}) (?<m>[A-Za-z]{3})") | "'"\\(.y)-\\(monthnum(.m))-01\")
    elif (pub // \"\") | test(\""'^[0-9]{4} [A-Za-z]{3} [0-9]{1,2}$") then
      (pub | capture("(?<y>[0-9]{4}) (?<m>[A-Za-z]{3}) (?<d>[0-9]{1,2})") | "'"\\(.y)-\\(monthnum(.m))-\\(.d|tonumber|tostring|if length==1 then \"0\"+. else . end)\")
    elif (pub // \"\") | test(\""'^[0-9]{4}-[0-9]{2}-[0-9]{2}$") then
      pub
    elif (sort // "") | test("''^[0-9]{4}/[0-9]{2}/[0-9]{2}") then
      (sort[0:10] | gsub("/"; "-"))
    else
      ""
    end;

  .result as $r
  | ($abs[0] // {}) as $ab
  | [ $r.uids[] as $id
      | $r[$id] as $it
      | {
          title: ($it.title // ""),
          summary: (($ab[$id] // "") | if . == "" then "No abstract available in source." else . end),
          url: ("https://pubmed.ncbi.nlm.nih.gov/'"\\("'$it.uid)/"),
          category: "Depression",
          source: "pubmed",
          journal: ($it.source // ""),
          published_date: parse_pubdate($it.pubdate; $it.sortpubdate),
          date: $today
        }
    ]
  | map(select(.published_date >= $start and .published_date <= $today))
  | unique_by(.url)
'"' \""'$esummary_file" > "$new_articles"

if [ -f "$outfile" ]; then
  jq -s --arg d "$today" '"'{date:"'$d, articles: ((map(.articles // []) | add) | unique_by(.url))}'"' \""'$outfile" <(jq --arg d "$today" '"'{date:"'$d,articles:.}'"' \""'$new_articles") > "$outfile.tmp"
else
  jq --arg d "$today" '"'{date:"'$d,articles:.}'"' \""'$new_articles" > "$outfile.tmp"
fi

mv "$outfile.tmp" "$outfile"

jq '"'.articles | length' \""'$outfile"
