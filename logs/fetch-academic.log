  def month_num("'$m):
    {"Jan":"01","Feb":"02","Mar":"03","Apr":"04","May":"05","Jun":"06","Jul":"07","Aug":"08","Sep":"09","Oct":"10","Nov":"11","Dec":"12"}[$m] // "01";
  def ltrim: sub("''^'"\\\\s+\"; \"\");
  def rtrim: sub(\"\\\\s+"'$"; "");
  def trim: ltrim | rtrim;
  def normalize_pubdate($raw):
    ($raw // "" | gsub("'"\\\\s+\"; \" \") | trim) as "'$d
    | if ($d | test("''^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) then
        $d
      elif ($d | test("''^[0-9]{4}( [A-Za-z]{3}( [0-9]{1,2})?)?")) then
        ($d | capture("''^(?<lead>[0-9]{4}(?: [A-Za-z]{3}(?: [0-9]{1,2})?)?)").lead) as $lead
        | if ($lead | test("''^[0-9]{4} [A-Za-z]{3} [0-9]{1,2}$")) then
            ($lead | capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3}) (?<day>[0-9]{1,2})$")) as $c
            | ($c.y + "-" + month_num($c.m) + "-" + (($c.day | tonumber | tostring) | if length == 1 then "0" + . else . end))
          elif ($lead | test("''^[0-9]{4} [A-Za-z]{3}$")) then
            ($lead | capture("''^(?<y>[0-9]{4}) (?<m>[A-Za-z]{3})$")) as $c
            | ($c.y + "-" + month_num($c.m) + "-01")
          elif ($lead | test("''^[0-9]{4}$")) then
            ($lead + "-01-01")
          else
            ""
          end
      else
        ""
      end;
  .result as $r
  | [$r.uids[] as $u | {
      uid: $u,
      title: ($r[$u].title // ""),
      journal: ($r[$u].source // ""),
      published_date: normalize_pubdate($r[$u].pubdate),
      url: ("https://pubmed.ncbi.nlm.nih.gov/" + $u + "/")
    }]
'"' \""'$out_dir/esummary.json" > "$out_dir/meta.json"

# Parse abstracts from efetch XML (Step 3 output)
perl -0777 -ne '"'
  my "'$xml = $_;
  while ($xml =~ m|<PubmedArticle'"\\b.*?</PubmedArticle>|sg) {
    my "'$article = $&;
    my ($pmid) = $article =~ m|<PMID[''^>]*>('"\\d+)</PMID>|s;
    next unless "'$pmid;

    my @parts = ($article =~ m|<AbstractText'"\\b["'^>]*>(.*?)</AbstractText>|sg);
    for (@parts) {
      s/<[''^>]+>//g;
      s/&lt;/</g;
      s/&gt;/>/g;
      s/&amp;/&/g;
      s/&quot;/"/g;
      s/&apos;/'"'\"'\"'/g;
      s/\\s+/ /g;
      s/"'^'"\\s+|\\s+"'$//g;
    }
    my $abs = join(" ", grep { length($_) } @parts);
    $abs =~ s/'"\\t/ /g;
    "'$abs =~ s/'"\\r?\\n/ /g;
    print \""'$pmid'"\\t"'$abs'"\\n\";
  }
' \""'$out_dir/efetch.xml" > "$out_dir/abstracts.tsv"

# Build PMID -> abstract map
jq -Rn '"'
  reduce inputs as "'$line ({};
    ($line | capture("''^(?<id>[0-9]+)'"\\\\t(?<abs>.*)"'$")?) as $m
    | if $m then
        . + {($m.id): (if ($m.abs | gsub("''^'"\\\\s+|\\\\s+"'$"; "") | length) > 0 then $m.abs else "No abstract available in source." end)}
      else
        .
      end
  )
'"' \""'$out_dir/abstracts.tsv" > "$out_dir/abstract_map.json"

# Secondary filter: published_date in last 3 days (inclusive)
cutoff=$(date -j -f %Y-%m-%d "$today" -v-2d +%Y-%m-%d)

jq --arg today "$today" --arg cutoff "$cutoff" --slurpfile abs "$out_dir/abstract_map.json" '"'
  map(
    . + {
      summary: ((("'$abs[0][.uid]) // "") | if (gsub("''^'"\\\\s+|\\\\s+"'$"; "") | length) > 0 then . else "No abstract available in source." end),
      category: "Alzheimer",
      source: "pubmed",
      date: $today
    }
  )
  | map(select(.published_date != "" and .published_date >= $cutoff and .published_date <= $today))
  | sort_by(.url)
  | unique_by(.url)
  | map({title, summary, url, category, source, journal, published_date, date})
'"' \""'$out_dir/meta.json" > "$out_dir/new_articles.json"

# Merge with existing target if present, then dedupe by url
if [ -f "$target" ]; then
  jq --arg today "$today" --slurpfile new "$out_dir/new_articles.json" '"'
    {
      date: "'$today,
      articles: ((.articles // []) + ($new[0] // []))
    }
    | .articles |= (
        sort_by(.url)
        | unique_by(.url)
        | map(
            .summary = ((.summary // "") | if (gsub("''^'"\\\\s+|\\\\s+"'$"; "") | length) > 0 then . else "No abstract available in source." end)
            | .category = "Alzheimer"
            | .source = "pubmed"
            | .journal = (.journal // "")
          )
      )
  '"' \""'$target" > "$out_dir/final.json"
else
  jq --arg today "$today" --slurpfile new "$out_dir/new_articles.json" '"'
    {
      date: "'$today,
      articles: ($new[0] // [])
    }
  '"' > \""'$out_dir/final.json"
fi

mv "$out_dir/final.json" "$target"

