import json
import re
import xml.etree.ElementTree as ET
from datetime import date, timedelta
from pathlib import Path

TODAY_STR = '2026-03-03'
TODAY = date.fromisoformat(TODAY_STR)
RECENT_START = TODAY - timedelta(days=2)  # inclusive window: 2026-03-01..2026-03-03
CATEGORY = 'ADHD'
SOURCE = 'pubmed'
FALLBACK_SUMMARY = 'No abstract available in source.'

esummary_path = Path('.tmp/academic-search/adhd-esummary.json')
efet_path = Path('.tmp/academic-search/adhd-efetch.xml')
output_path = Path('data/2026-03-03-adhd.json')

month_map = {
    'jan': 1, 'january': 1,
    'feb': 2, 'february': 2,
    'mar': 3, 'march': 3,
    'apr': 4, 'april': 4,
    'may': 5,
    'jun': 6, 'june': 6,
    'jul': 7, 'july': 7,
    'aug': 8, 'august': 8,
    'sep': 9, 'sept': 9, 'september': 9,
    'oct': 10, 'october': 10,
    'nov': 11, 'november': 11,
    'dec': 12, 'december': 12,
}
season_map = {'spring': 3, 'summer': 6, 'fall': 9, 'autumn': 9, 'winter': 12}

def parse_pubdate(pubdate: str):
    if not pubdate:
        return None
    text = re.sub(r'\\s+', ' ', pubdate.strip())
    if not text:
        return None

    m = re.match(r'"'^('"\\d{4})/(\\d{2})/(\\d{2})"'$'"', text)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return date(y, mo, d)
        except ValueError:
            return None

    m = re.match(r'"'^('"\\d{4})"'$'"', text)
    if m:
        return date(int(m.group(1)), 1, 1)

    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]+)(?:\\s+([0-9]{1,2})(?:\\s*[-/]\\s*[0-9]{1,2})?)?"'$'"', text)
    if m:
        y = int(m.group(1))
        mon_token = m.group(2).lower()
        day_token = m.group(3)
        if mon_token in month_map:
            mo = month_map[mon_token]
        elif mon_token in season_map:
            mo = season_map[mon_token]
        else:
            return None
        day = int(day_token) if day_token else 1
        try:
            return date(y, mo, day)
        except ValueError:
            return None

    # Handle cases like \"2026 Feb-Mar\" by taking first month
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]+)\\s*[-/]\\s*[A-Za-z]+"'$'"', text)
    if m:
        y = int(m.group(1))
        mon_token = m.group(2).lower()
        mo = month_map.get(mon_token)
        if not mo:
            return None
        return date(y, mo, 1)

    # Fallback: extract year + first month token + first day token if present
    y_match = re.search(r'(\\d{4})', text)
    if not y_match:
        return None
    y = int(y_match.group(1))

    mon = None
    for token in re.findall(r'[A-Za-z]+', text):
        token_l = token.lower()
        if token_l in month_map:
            mon = month_map[token_l]
            break
        if token_l in season_map:
            mon = season_map[token_l]
            break

    day_match = re.search(r'\\b(\\d{1,2})\\b', text)
    d = int(day_match.group(1)) if day_match else 1
    if mon is None:
        mon = 1
        d = 1

    try:
        return date(y, mon, d)
    except ValueError:
        return None

# Load esummary
if esummary_path.exists():
    with esummary_path.open() as f:
        esummary = json.load(f)
else:
    esummary = {\"result\": {\"uids\": []}}

uids = esummary.get('result', {}).get('uids', []) or []

# Load efetch XML abstracts
abstract_by_pmid = {}
if efet_path.exists():
    tree = ET.parse(efet_path)
    root = tree.getroot()
    for article in root.findall('.//PubmedArticle'):
        pmid_node = article.find('.//MedlineCitation/PMID')
        if pmid_node is None or pmid_node.text is None:
            continue
        pmid = pmid_node.text.strip()
        abstract_nodes = article.findall('.//Abstract/AbstractText')
        parts = []
        for node in abstract_nodes:
            text = ''.join(node.itertext()).strip()
            if not text:
                continue
            label = node.attrib.get('Label')
            if label:
                parts.append(f\"{label}: {text}\")
            else:
                parts.append(text)
        summary = ' '.join(parts).strip()
        if not summary:
            summary = FALLBACK_SUMMARY
        abstract_by_pmid[pmid] = summary

new_articles = []
for uid in uids:
    rec = esummary.get('result', {}).get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    pubdate_raw = (rec.get('pubdate') or '').strip()
    parsed_date = parse_pubdate(pubdate_raw)
    if parsed_date is None:
        continue

    if not (RECENT_START <= parsed_date <= TODAY):
        continue

    url = f'https://pubmed.ncbi.nlm.nih.gov/{uid}/'
    summary = (abstract_by_pmid.get(uid) or '').strip() or FALLBACK_SUMMARY

    new_articles.append({
        'title': title,
        'summary': summary,
        'url': url,
        'category': CATEGORY,
        'source': SOURCE,
        'journal': journal,
        'published_date': parsed_date.isoformat(),
        'date': TODAY_STR,
    })

# Load existing and merge/dedupe by url
existing_articles = []
if output_path.exists():
    try:
        with output_path.open() as f:
            existing_data = json.load(f)
            if isinstance(existing_data, dict):
                existing_articles = existing_data.get('articles', []) or []
    except Exception:
        existing_articles = []

merged = []
seen = set()
for art in new_articles + existing_articles:
    if not isinstance(art, dict):
        continue
    url = art.get('url', '')
    if not url or url in seen:
        continue

    # Normalize required fields and backfill summary fallback
    normalized = {
        'title': (art.get('title') or '').strip(),
        'summary': (art.get('summary') or '').strip() or FALLBACK_SUMMARY,
        'url': url,
        'category': CATEGORY,
        'source': SOURCE,
        'journal': (art.get('journal') or '').strip(),
        'published_date': (art.get('published_date') or '').strip(),
        'date': TODAY_STR,
    }
    merged.append(normalized)
    seen.add(url)

output = {
    'date': TODAY_STR,
    'articles': merged,
}

output_path.parent.mkdir(parents=True, exist_ok=True)
with output_path.open('w') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)
    f.write('\\n')

print(f'Wrote {output_path} with {len(merged)} articles')
