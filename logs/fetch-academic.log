import json
import re
import sys
import xml.etree.ElementTree as ET
from datetime import date, datetime, timedelta
from pathlib import Path

esummary_path, efetch_path, out_path, today_str = sys.argv[1:]

today = datetime.strptime(today_str, "%Y-%m-%d").date()
start = today - timedelta(days=2)

month_map = {
    '"'jan':1,'january':1,'feb':2,'february':2,'mar':3,'march':3,'apr':4,'april':4,
    'may':5,'jun':6,'june':6,'jul':7,'july':7,'aug':8,'august':8,'sep':9,'sept':9,
    'september':9,'oct':10,'october':10,'nov':11,'november':11,'dec':12,'december':12,
}

def parse_pubdate(s: str):
    if not s:
        return None
    s = s.strip()
    # remove trailing punctuation and collapse spaces
    s = re.sub(r'\\s+', ' ', s.replace('.', ' ').strip())
    # split range like 2026 Jan-Feb
    s = re.split(r'[-/]', s)[0].strip()
    # pure year
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return date(int(m.group(1)), 1, 1)
    # year month
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = month_map.get(m.group(2).lower())
        if mon:
            return date(y, mon, 1)
    # year month day
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = month_map.get(m.group(2).lower()); d = int(m.group(3))
        if mon:
            return date(y, mon, d)
    # yyyy-mm-dd
    m = re.match(r'"'^('"\\d{4})-(\\d{2})-(\\d{2})"'$'"', s)
    if m:
        return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    # yyyy/mm/dd
    m = re.match(r'"'^('"\\d{4})/(\\d{1,2})/(\\d{1,2})"'$'"', s)
    if m:
        return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    return None

# Parse abstracts from efetch XML
abstract_by_pmid = {}
root = ET.parse(efetch_path).getroot()
for article in root.findall('.//PubmedArticle'):
    pmid_el = article.find('.//MedlineCitation/PMID')
    if pmid_el is None or pmid_el.text is None:
        continue
    pmid = pmid_el.text.strip()
    parts = []
    for ab in article.findall('.//Abstract/AbstractText'):
        label = ab.attrib.get('Label', '').strip()
        txt = ''.join(ab.itertext()).strip()
        if not txt:
            continue
        parts.append(f\"{label}: {txt}\" if label else txt)
    abstract_by_pmid[pmid] = '\\n'.join(parts).strip()

with open(esummary_path, 'r', encoding='utf-8') as f:
    s = json.load(f)

uids = s.get('result', {}).get('uids', [])
new_articles = []
for uid in uids:
    item = s['result'].get(uid, {})
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    pub = parse_pubdate((item.get('pubdate') or '').strip())
    if not pub:
        continue
    # secondary filter: published_date within recent 3 days
    if not (start <= pub <= today):
        continue

    summary = (abstract_by_pmid.get(uid) or '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    rec = {
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'ADHD',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub.isoformat(),
        'date': today_str,
    }
    new_articles.append(rec)

# merge with existing file then dedupe by url
out = Path(out_path)
existing = []
if out.exists():
    try:
        old = json.loads(out.read_text(encoding='utf-8'))
        existing = old.get('articles', []) if isinstance(old, dict) else []
    except Exception:
        existing = []

merged = []
seen = set()
for rec in new_articles + existing:
    url = rec.get('url', '')
    if not url or url in seen:
        continue
    seen.add(url)
    # normalize required keys and defaults
    merged.append({
        'title': rec.get('title', ''),
        'summary': rec.get('summary') or 'No abstract available in source.',
        'url': url,
        'category': 'ADHD',
        'source': rec.get('source', 'pubmed') or 'pubmed',
        'journal': rec.get('journal', ''),
        'published_date': rec.get('published_date', ''),
        'date': today_str,
    })

payload = {'date': today_str, 'articles': merged}
out.parent.mkdir(parents=True, exist_ok=True)
out.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')

print(json.dumps({'esummary_uids': len(uids), 'new_after_filter': len(new_articles), 'final_articles': len(merged)}, ensure_ascii=False))
