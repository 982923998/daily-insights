import json
import os
import re
import sys
import datetime as dt
import xml.etree.ElementTree as ET

TMPDIR = sys.argv[1]
TARGET = sys.argv[2]
TODAY_STR = \"2026-03-06\"
TODAY = dt.date.fromisoformat(TODAY_STR)
WINDOW_START = TODAY - dt.timedelta(days=2)  # 最近3天: today, today-1, today-2
FALLBACK_SUMMARY = \"No abstract available in source.\"

months = {
    \"jan\": 1, \"january\": 1,
    \"feb\": 2, \"february\": 2,
    \"mar\": 3, \"march\": 3,
    \"apr\": 4, \"april\": 4,
    \"may\": 5,
    \"jun\": 6, \"june\": 6,
    \"jul\": 7, \"july\": 7,
    \"aug\": 8, \"august\": 8,
    \"sep\": 9, \"sept\": 9, \"september\": 9,
    \"oct\": 10, \"october\": 10,
    \"nov\": 11, \"november\": 11,
    \"dec\": 12, \"december\": 12,
}

def valid_ymd(s: str) -> bool:
    return bool(re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", s or \"\"))

def safe_date(y, m=1, d=1):
    try:
        return dt.date(int(y), int(m), int(d))
    except Exception:
        return None

def normalize_pubdate(pubdate: str, sortpubdate: str = \"\"):
    s = (pubdate or \"\").strip()

    # direct YYYY-MM-DD
    m = re.search(r\"(\\d{4})-(\\d{1,2})-(\\d{1,2})\", s)
    if m:
        d = safe_date(m.group(1), m.group(2), m.group(3))
        if d:
            return d.isoformat()

    # direct YYYY/MM/DD
    m = re.search(r\"(\\d{4})/(\\d{1,2})/(\\d{1,2})\", s)
    if m:
        d = safe_date(m.group(1), m.group(2), m.group(3))
        if d:
            return d.isoformat()

    # textual: YYYY Mon DD | YYYY Mon
    m = re.search(r\"(\\d{4})\\s+([A-Za-z]{3,9})(?:\\s+(\\d{1,2}))?\", s)
    if m:
        y = int(m.group(1))
        mon = months.get(m.group(2).lower())
        day = int(m.group(3)) if m.group(3) else 1
        if mon:
            d = safe_date(y, mon, day)
            if d:
                return d.isoformat()

    # numeric YYYY-MM
    m = re.search(r\"(\\d{4})-(\\d{1,2})(?"'!-)", s)
    if m:
        d = safe_date(m.group(1), m.group(2), 1)
        if d:
            return d.isoformat()

    # year only
    m = re.search(r"'"\\b(\\d{4})\\b\", s)
    if m:
        d = safe_date(m.group(1), 1, 1)
        if d:
            return d.isoformat()

    # fallback sortpubdate: YYYY/MM/DD ...
    s2 = (sortpubdate or \"\").strip()
    m = re.search(r\"(\\d{4})/(\\d{1,2})/(\\d{1,2})\", s2)
    if m:
        d = safe_date(m.group(1), m.group(2), m.group(3))
        if d:
            return d.isoformat()

    return \"\"

def extract_abstracts(xml_path: str):
    abstracts = {}
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()
    except Exception:
        return abstracts

    for article in root.findall(\".//PubmedArticle\"):
        pmid_node = article.find(\".//MedlineCitation/PMID\")
        if pmid_node is None or pmid_node.text is None:
            continue
        pmid = pmid_node.text.strip()
        parts = []
        for node in article.findall(\".//Article/Abstract/AbstractText\"):
            text = \" \".join((t or \"\").strip() for t in node.itertext()).strip()
            label = (node.attrib.get(\"Label\") or \"\").strip()
            if text:
                if label and not text.lower().startswith(label.lower()):
                    parts.append(f\"{label}: {text}\")
                else:
                    parts.append(text)
        abstracts[pmid] = \" \".join(parts).strip()

    return abstracts

def normalize_record(rec):
    title = (rec.get(\"title\") or \"\").strip()
    summary = (rec.get(\"summary\") or \"\").strip() or FALLBACK_SUMMARY
    url = (rec.get(\"url\") or \"\").strip()
    journal = (rec.get(\"journal\") or \"\").strip()
    pub = (rec.get(\"published_date\") or \"\").strip()

    # 尝试规范已有记录日期
    if not valid_ymd(pub):
        pub = normalize_pubdate(pub, \"\")

    if not title or not url or not pub:
        return None

    return {
        \"title\": title,
        \"summary\": summary,
        \"url\": url,
        \"category\": \"Parkinson\",
        \"source\": \"pubmed\",
        \"journal\": journal,
        \"published_date\": pub,
        \"date\": TODAY_STR,
    }

with open(os.path.join(TMPDIR, \"esummary.json\"), \"r\", encoding=\"utf-8\") as f:
    esummary = json.load(f)

uids = esummary.get(\"result\", {}).get(\"uids\", [])
abstracts = extract_abstracts(os.path.join(TMPDIR, \"efetch.xml\"))

new_articles = []
for uid in uids:
    rec = esummary.get(\"result\", {}).get(str(uid), {})
    title = (rec.get(\"title\") or \"\").strip()
    journal = (rec.get(\"source\") or \"\").strip()
    pubdate = normalize_pubdate(rec.get(\"pubdate\", \"\"), rec.get(\"sortpubdate\", \"\"))

    if not title or not pubdate:
        continue

    try:
        d = dt.date.fromisoformat(pubdate)
    except Exception:
        continue

    # 二次过滤：published_date 仅保留最近3天
    if not (WINDOW_START <= d <= TODAY):
        continue

    url = f\"https://pubmed.ncbi.nlm.nih.gov/{uid}/\"
    summary = (abstracts.get(str(uid), \"\") or \"\").strip() or FALLBACK_SUMMARY

    new_articles.append({
        \"title\": title,
        \"summary\": summary,
        \"url\": url,
        \"category\": \"Parkinson\",
        \"source\": \"pubmed\",
        \"journal\": journal,
        \"published_date\": pubdate,
        \"date\": TODAY_STR,
    })

existing_articles = []
if os.path.exists(TARGET):
    try:
        with open(TARGET, \"r\", encoding=\"utf-8\") as f:
            old = json.load(f)
            if isinstance(old, dict) and isinstance(old.get(\"articles\"), list):
                existing_articles = old[\"articles\"]
    except Exception:
        existing_articles = []

merged = []
seen = set()

for rec in new_articles + existing_articles:
    normalized = normalize_record(rec) if rec in existing_articles else rec
    if normalized is None:
        continue
    url = normalized.get(\"url\", \"\")
    if not url or url in seen:
        continue
    seen.add(url)
    merged.append(normalized)

merged.sort(key=lambda x: (x.get(\"published_date\", \"\"), x.get(\"url\", \"\")), reverse=True)

output = {
    \"date\": TODAY_STR,
    \"articles\": merged,
}

with open(TARGET, \"w\", encoding=\"utf-8\") as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f\"esearch_count={len(esummary.get('result', {}).get('uids', []))}\")
print(f\"final_articles={len(merged)}\")
print(f\"written={TARGET}\")
PY

