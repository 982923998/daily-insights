        'url': u,
        'category': 'Autism',
        'source': art.get('source','pubmed') or 'pubmed',
        'journal': art.get('journal',''),
        'published_date': art.get('published_date',''),
        'date': '2026-03-21'
    })

final = {'date':'2026-03-21','articles':combined}
out_file.write_text(json.dumps(final, ensure_ascii=False, indent=2))
print(len(new_articles), len(combined))
