normalized = []
for art in merged_by_url.values():
    url = (art.get("url") or "").strip()
    if not url:
        continue
    published_date = (art.get("published_date") or "").strip()
    if not in_recent_three_days(published_date):
        continue

    normalized.append({
        "title": (art.get("title") or "").strip(),
        "summary": (art.get("summary") or "").strip() or "No abstract available in source.",
        "url": url,
        "category": "Autism",
        "source": (art.get("source") or "pubmed").strip() or "pubmed",
        "journal": (art.get("journal") or "").strip(),
        "published_date": published_date,
        "date": TODAY_STR,
    })

normalized.sort(key=lambda x: (x.get("published_date", ""), x.get("url", "")), reverse=True)

output = {"date": TODAY_STR, "articles": normalized}
os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
with open(OUT_PATH, "w", encoding="utf-8") as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f"new={len(new_articles)} merged_filtered={len(normalized)}")
