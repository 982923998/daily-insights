/bin/zsh -lc "set -euo pipefail
python3 - <<'PY'
import json
import os
import re
import datetime as dt
import xml.etree.ElementTree as ET

DATE_STR = '2026-03-12'
out_path = '/Users/chenmayao/Projects/daily-insights/data/2026-03-12-autism.json'

with open('/tmp/autism_esummary.json','r',encoding='utf-8') as f:
    esummary = json.load(f)
with open('/tmp/autism_efetch.xml','r',encoding='utf-8') as f:
    efetch_xml = f.read()

# Parse abstracts from efetch XML: PMID -> concatenated AbstractText
root = ET.fromstring(efetch_xml)
abstract_map = {}
for article in root.findall('.//PubmedArticle'):
    pmid_el = article.find('.//MedlineCitation/PMID')
    if pmid_el is None or not (pmid_el.text and pmid_el.text.strip()):
        continue
    pmid = pmid_el.text.strip()
    parts = []
    for ab in article.findall('.//Abstract/AbstractText'):
        text = ''.join(ab.itertext()).strip()
        if not text:
            continue
        label = ab.attrib.get('Label') or ab.attrib.get('NlmCategory')
        if label and label not in ('UNASSIGNED',):
            parts.append(f\"{label}: {text}\")
        else:
            parts.append(text)
    abstract_map[pmid] = ' '.join(parts).strip()

# Parse pubdate to YYYY-MM-DD; if year-month only => day 01; year only => Jan 01
def parse_pubdate(s: str):
    s = (s or '').strip()
    if not s:
        return None
    s = re.sub(r'\\s+', ' ', s)
    candidates = [
        ('%Y %b %d', None),
        ('%Y %B %d', None),
        ('%Y %b', 'month'),
        ('%Y %B', 'month'),
        ('%Y', 'year'),
    ]
    for fmt, kind in candidates:
        try:
            d = dt.datetime.strptime(s, fmt).date()
            if kind == 'month':
                d = d.replace(day=1)
            elif kind == 'year':
                d = d.replace(month=1, day=1)
            return d.isoformat()
        except ValueError:
            continue
    m = re.match(r'"'^('"\\d{4})-(\\d{2})-(\\d{2})"'$'"', s)
    if m:
        return s
    return None

uids = esummary.get('result', {}).get('uids', [])
new_articles = []
for uid in uids:
    rec = esummary['result'].get(uid, {})
    title = (rec.get('title') or '').strip()
    journal = (rec.get('source') or '').strip()
    pub_iso = parse_pubdate(rec.get('pubdate') or '')
    if not pub_iso:
        continue
    summary = abstract_map.get(uid, '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Autism',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_iso,
        'date': DATE_STR,
    })

# Secondary filter: keep only published_date in last 3 days (inclusive)
today = dt.date.fromisoformat(DATE_STR)
start = today - dt.timedelta(days=2)
filtered = []
for a in new_articles:
    try:
        pd = dt.date.fromisoformat(a['published_date'])
    except Exception:
        continue
    if start <= pd <= today:
        filtered.append(a)

# Read existing file if exists and merge dedupe by url
existing_articles = []
if os.path.exists(out_path):
    try:
        with open(out_path, 'r', encoding='utf-8') as f:
            existing = json.load(f)
        if isinstance(existing, dict) and isinstance(existing.get('articles'), list):
            existing_articles = existing['articles']
    except Exception:
        existing_articles = []

merged_by_url = {}
for item in existing_articles + filtered:
    url = item.get('url', '').strip()
    if not url:
        continue
    merged_by_url[url] = item

merged = sorted(merged_by_url.values(), key=lambda x: (x.get('published_date',''), x.get('url','')), reverse=True)

output = {
    'date': DATE_STR,
    'articles': merged,
}

os.makedirs(os.path.dirname(out_path), exist_ok=True)
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f'new_raw={len(new_articles)} filtered={len(filtered)} existing={len(existing_articles)} merged={len(merged)}')
