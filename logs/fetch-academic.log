    if ($line|length)==0 then .
    else
      ($line | capture("''^(?<id>[''^'"\\\\t]+)\\\\t(?<txt>.*)"'$")) as $m
      | . + {($m.id): $m.txt}
    end
  )
'"' < \""'$TMP_DIR/abstracts.tsv" > "$TMP_DIR/abstracts.json"

# Secondary filter: keep only published_date in last 3 days (2026-03-22 to 2026-03-24)
CUTOFF=$(date -j -v-2d -f %Y-%m-%d "$TODAY" +%Y-%m-%d)

