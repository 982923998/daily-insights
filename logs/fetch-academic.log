        }
    ]
  | map(select(.published_date >= "2026-03-10" and .published_date <= "2026-03-12"))
  | unique_by(.url)
'"' \""'$TMPDIR/esummary.json" "$TMPDIR/abstract_map.json" > "$TMPDIR/new_articles.json"

