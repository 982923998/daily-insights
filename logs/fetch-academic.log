exec
/bin/zsh -lc 'set -euo pipefail
WORKDIR=/Users/chenmayao/Projects/daily-insights
TMPDIR="$WORKDIR/.tmp_adhd_2026-03-12"

# Build abstracts as JSONL: {pmid, summary}
perl -MJSON::PP -0777 -ne '"'
  while(/<PubmedArticle>.*?<PMID["'^>]*>('"\\d+)<\\/PMID>.*?(<Abstract>.*?<\\/Abstract>)?.*?<\\/PubmedArticle>/sg){
    my "'$pmid=$1; my $absblk=$2 // ""; my $ab="";
    if ($absblk ne "") {
      while($absblk =~ /<AbstractText([''^>]*)>(.*?)<'"\\/AbstractText>/sg){
        my "'$attrs=$1 // ""; my $txt=$2 // "";
        my $label="";
        if($attrs =~ /Label="([''^"]+)"/){ $label=$1; }
        $txt =~ s/<[''^>]+>/ /g;
        $txt =~ s/&lt;/</g; $txt =~ s/&gt;/>/g; $txt =~ s/&amp;/&/g;
        $txt =~ s/'"\\s+/ /g; "'$txt =~ s/''^'"\\s+|\\s+"'$//g;
        next if $txt eq "";
        if($label ne ""){ $ab .= "$label: $txt "; } else { $ab .= "$txt "; }
      }
    }
    $ab =~ s/'"\\s+/ /g; "'$ab =~ s/''^'"\\s+|\\s+"'$//g;
    print encode_json({pmid=>$pmid, summary=>$ab}) . "'"\\n\";
  }
' \""'$TMPDIR/efetch.xml" > "$TMPDIR/abstracts.jsonl"

jq -s '"'map({key:.pmid, value:.summary})|from_entries' \""'$TMPDIR/abstracts.jsonl" > "$TMPDIR/abstract_map.json"

