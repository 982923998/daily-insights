exec
/bin/zsh -lc "python3 - <<'PY'
import json
import os
import re
import xml.etree.ElementTree as ET
from datetime import date, timedelta, datetime

base = '/Users/chenmayao/Projects/daily-insights'
esummary_path = f'{base}/.tmp/depression_esummary.json'
efet_path = f'{base}/.tmp/depression_efetch.xml'
out_path = f'{base}/data/2026-03-12-depression.json'

today_str = '2026-03-12'
today = datetime.strptime(today_str, '%Y-%m-%d').date()
window_start = today - timedelta(days=2)

month_map = {
    'jan':1,'january':1,
    'feb':2,'february':2,
    'mar':3,'march':3,
    'apr':4,'april':4,
    'may':5,
    'jun':6,'june':6,
    'jul':7,'july':7,
    'aug':8,'august':8,
    'sep':9,'sept':9,'september':9,
    'oct':10,'october':10,
    'nov':11,'november':11,
    'dec':12,'december':12,
}

def normalize_pubdate(s: str):
    if not s:
        return ''
    s = s.strip()
    m = re.search(r'(\\d{4})-(\\d{2})-(\\d{2})', s)
    if m:
        return f\"{int(m.group(1)):04d}-{int(m.group(2)):02d}-{int(m.group(3)):02d}\"
    m = re.search(r'(\\d{4})\\/(\\d{2})\\/(\\d{2})', s)
    if m:
        return f\"{int(m.group(1)):04d}-{int(m.group(2)):02d}-{int(m.group(3)):02d}\"

    cleaned = re.sub(r'[,;]', ' ', s)
    parts = cleaned.split()

    year = None
    for p in parts:
        if re.fullmatch(r'\\d{4}', p):
            year = int(p)
            break
    if year is None:
        return ''

    month = None
    day = None

    for i,p in enumerate(parts):
        key = p.lower().strip('.').strip()
        if key in month_map:
            month = month_map[key]
            if i+1 < len(parts):
                d = re.sub(r'\\D','',parts[i+1])
                if d:
                    dv = int(d)
                    if 1 <= dv <= 31:
                        day = dv
            break

    if month is None:
        for i,p in enumerate(parts):
            if re.fullmatch(r'\\d{1,2}', p):
                mm = int(p)
                if 1 <= mm <= 12:
                    month = mm
                    if i+1 < len(parts) and re.fullmatch(r'\\d{1,2}', parts[i+1]):
                        dv = int(parts[i+1])
                        if 1 <= dv <= 31:
                            day = dv
                    break

    if month is None:
        month = 1
    if day is None:
        day = 1

    try:
        d = date(year, month, day)
    except ValueError:
        return ''
    return d.strftime('%Y-%m-%d')

# Parse abstracts from efetch XML: PMID -> summary
abstract_by_pmid = {}
if os.path.exists(efet_path) and os.path.getsize(efet_path) > 0:
    tree = ET.parse(efet_path)
    root = tree.getroot()
    for art in root.findall('.//PubmedArticle'):
        pmid_elem = art.find('.//MedlineCitation/PMID')
        if pmid_elem is None or pmid_elem.text is None:
            continue
        pmid = pmid_elem.text.strip()
        abs_nodes = art.findall('.//MedlineCitation/Article/Abstract/AbstractText')
        chunks = []
        for node in abs_nodes:
            txt = ''.join(node.itertext()).strip()
            label = node.attrib.get('Label', '').strip()
            if txt:
                chunks.append(f\"{label}: {txt}\" if label else txt)
        abstract_by_pmid[pmid] = ' '.join(chunks).strip()

# Parse esummary metadata
articles_new = []
if os.path.exists(esummary_path) and os.path.getsize(esummary_path) > 0:
    summary = json.load(open(esummary_path, 'r', encoding='utf-8'))
    result = summary.get('result', {})
    uids = result.get('uids', [])
    for uid in uids:
        item = result.get(uid, {})
        title = (item.get('title') or '').strip()
        journal = (item.get('source') or '').strip()
        pubdate_raw = (item.get('pubdate') or '').strip()
        published_date = normalize_pubdate(pubdate_raw)

        if not published_date:
            continue
        try:
            pd = datetime.strptime(published_date, '%Y-%m-%d').date()
        except ValueError:
            continue
        # Secondary filter: keep only recent 3 days by published_date
        if not (window_start <= pd <= today):
            continue

        summary_text = abstract_by_pmid.get(uid, '').strip() or 'No abstract available in source.'

        articles_new.append({
            'title': title,
            'summary': summary_text,
            'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
            'category': 'Depression',
            'source': 'pubmed',
            'journal': journal,
            'published_date': published_date,
            'date': today_str,
        })

# Load existing and merge by url
existing_articles = []
if os.path.exists(out_path):
    try:
        existing = json.load(open(out_path, 'r', encoding='utf-8'))
        if isinstance(existing, dict):
            existing_articles = existing.get('articles', []) or []
    except Exception:
        existing_articles = []

merged = []
seen = set()
for art in existing_articles + articles_new:
    url = art.get('url', '') if isinstance(art, dict) else ''
    if not url or url in seen:
        continue
    seen.add(url)
    # Ensure mandatory fields and defaults
    merged.append({
        'title': art.get('title', '') if isinstance(art, dict) else '',
        'summary': (art.get('summary') if isinstance(art, dict) else '') or 'No abstract available in source.',
        'url': url,
        'category': 'Depression',
        'source': 'pubmed',
        'journal': (art.get('journal', '') if isinstance(art, dict) else '') or '',
        'published_date': art.get('published_date', '') if isinstance(art, dict) else '',
        'date': today_str,
    })

# Optional stable ordering by published_date desc then url
merged.sort(key=lambda x: (x.get('published_date',''), x.get('url','')), reverse=True)

out = {
    'date': today_str,
    'articles': merged
}

os.makedirs(os.path.dirname(out_path), exist_ok=True)
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(f'written={out_path}')
print(f'new_articles_after_filter={len(articles_new)}')
print(f'merged_articles={len(merged)}')
print(f'window={window_start}..{today}')
