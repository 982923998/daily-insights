' /tmp/autism_efetch.xml > /tmp/autism_abstracts.json

# Build candidate articles from esummary + abstracts
jq -r '.result.uids[]' /tmp/autism_esummary.json | while read -r PMID; do
  TITLE="'$(jq -r --arg id "$PMID" '"'.result["'$id].title // ""'"' /tmp/autism_esummary.json)
  JOURNAL="'$(jq -r --arg id "$PMID" '"'.result["'$id].source // ""'"' /tmp/autism_esummary.json)
  PUBRAW="'$(jq -r --arg id "$PMID" '"'.result["'$id].pubdate // ""'"' /tmp/autism_esummary.json)
  SUMMARY="'$(jq -r --arg id "$PMID" '"'.["'$id] // ""'"' /tmp/autism_abstracts.json)

  # Normalize pubdate to YYYY-MM-DD
  NORM="'$(awk -v s="$PUBRAW" '"'
    function mon(m){
      if(m==\"Jan\")return\"01\"; if(m==\"Feb\")return\"02\"; if(m==\"Mar\")return\"03\"; if(m==\"Apr\")return\"04\";
      if(m==\"May\")return\"05\"; if(m==\"Jun\")return\"06\"; if(m==\"Jul\")return\"07\"; if(m==\"Aug\")return\"08\";
      if(m==\"Sep\")return\"09\"; if(m==\"Oct\")return\"10\"; if(m==\"Nov\")return\"11\"; if(m==\"Dec\")return\"12\";
      return\"01\"
    }
    BEGIN{
      gsub(/"'^ +| +$/, "", s)
      n=split(s,a,/ +/)
      if (n>=3 && a[1] ~ /''^[0-9]{4}$/) {
        d=a[3]; if (length(d)==1) d="0" d;
        print a[1] "-" mon(a[2]) "-" d;
      } else if (n==2 && a[1] ~ /''^[0-9]{4}$/) {
        print a[1] "-" mon(a[2]) "-01";
      } else if (n==1 && a[1] ~ /''^[0-9]{4}$/) {
        print a[1] "-01-01";
      } else {
        print "";
      }
    }
  '"')

  if [ -z \""'$SUMMARY" ] || [ "$SUMMARY" = "null" ]; then
    SUMMARY="No abstract available in source."
  fi

  jq -n '"\\
    --arg title \""'$TITLE" '"\\
    --arg summary \""'$SUMMARY" '"\\
    --arg url \"https://pubmed.ncbi.nlm.nih.gov/"'${PMID}/" '"\\
    --arg category \"Autism\" \\
    --arg source \"pubmed\" \\
    --arg journal \""'$JOURNAL" '"\\
    --arg published_date \""'$NORM" '"\\
    --arg date \""'$TODAY" '"\\
    '{title:"'$title,summary:$summary,url:$url,category:$category,source:$source,journal:$journal,published_date:$published_date,date:$date}'"'
done | jq -s '.' > /tmp/autism_candidates.json

# Secondary date filter: keep only published_date within last 3 days inclusive [TODAY-2, TODAY]
START="'$(date -v-2d -j -f "%Y-%m-%d" "$TODAY" +"%Y-%m-%d" 2>/dev/null || gdate -d "$TODAY -2 days" +"%Y-%m-%d")
jq --arg start "$START" --arg end "$TODAY" '"'
  map(select(.published_date "'!= "" and .published_date >= $start and .published_date <= $end))
  | unique_by(.url)
'"' /tmp/autism_candidates.json > /tmp/autism_filtered.json

# Merge with existing file if present, then dedupe by url
if [ -f \""'$OUT" ]; then
  if jq empty "$OUT" >/dev/null 2>&1; then
    jq -n --arg date "$TODAY" '"\\
      --slurpfile old \""'$OUT" '"\\
      --slurpfile new /tmp/autism_filtered.json '
      {
        date: "'$date,
        articles: (((($old[0].articles // []) + ($new[0] // [])) | unique_by(.url)))
      }
    '"' > /tmp/autism_merged.json
  else
    jq -n --arg date \""'$TODAY" --slurpfile new /tmp/autism_filtered.json '"'{date:"'$date,articles:($new[0] // [])}'"' > /tmp/autism_merged.json
  fi
else
  jq -n --arg date \""'$TODAY" --slurpfile new /tmp/autism_filtered.json '"'{date:"'$date,articles:($new[0] // [])}'"' > /tmp/autism_merged.json
fi

mv /tmp/autism_merged.json \""'$OUT"

