    if m:
        y, mo, d = map(int, m.groups())
        try:
            return date(y, mo, d).isoformat()
        except ValueError:
            return ""

    m = re.match(r"''^('"\\\\d{4})[-/](\\\\d{1,2})"'$", s)
    if m:
        y, mo = map(int, m.groups())
        try:
            return date(y, mo, 1).isoformat()
        except ValueError:
            return ""

    m = re.match(r"''^('"\\\\d{4})\\\\s+([A-Za-z]{3,9})(?:\\\\s+(\\\\d{1,2}))?"'$", s)
    if m:
        y = int(m.group(1))
        mon = m.group(2)[:3].lower()
        day = int(m.group(3)) if m.group(3) else 1
        mo = MONTHS.get(mon)
        if not mo:
            return ""
        try:
            return date(y, mo, day).isoformat()
        except ValueError:
            return ""

    m = re.match(r"''^('"\\\\d{4})\\\\s+([A-Za-z]{3})[-/][A-Za-z]{3}"'$", s)
    if m:
        y = int(m.group(1))
        mo = MONTHS.get(m.group(2).lower())
        if not mo:
