    def mon2num("'$m):
      if $m=="Jan" then "01" elif $m=="Feb" then "02" elif $m=="Mar" then "03" elif $m=="Apr" then "04"
      elif $m=="May" then "05" elif $m=="Jun" then "06" elif $m=="Jul" then "07" elif $m=="Aug" then "08"
      elif $m=="Sep" then "09" elif $m=="Oct" then "10" elif $m=="Nov" then "11" elif $m=="Dec" then "12"
      else null end;
    def norm_date:
