python3 - <<'"'PY'
import json, re, html
from datetime import datetime, timedelta
from pathlib import Path
import xml.etree.ElementTree as ET

tmp = Path(\"\"\"/tmp/depression_search_"'$$""")
out = Path("""/Users/chenmayao/Projects/daily-insights/data/2026-03-24-depression.json""")
today = datetime.strptime("2026-03-24", "%Y-%m-%d").date()
min_date = today - timedelta(days=2)

# Load esummary
with open(tmp / "esummary.json", "r", encoding="utf-8") as f:
    esum = json.load(f)

# Parse abstracts from efetch XML by PMID
abstract_by_pmid = {}
xml_text = (tmp / "efetch.xml").read_text(encoding="utf-8", errors="ignore")
try:
    root = ET.fromstring(xml_text)
    for art in root.findall('"'.//PubmedArticle'):
        pmid_el = art.find('.//MedlineCitation/PMID')
        if pmid_el is None or not (pmid_el.text or '').strip():
            continue
        pmid = pmid_el.text.strip()
        abs_nodes = art.findall('.//Abstract/AbstractText')
        parts = []
        for n in abs_nodes:
            txt = ''.join(n.itertext()).strip()
            label = (n.attrib.get('Label') or '').strip()
            if txt:
                parts.append(f\"{label}: {txt}\" if label else txt)
        summary = ' '.join(parts).strip()
        abstract_by_pmid[pmid] = re.sub(r'\\s+', ' ', summary)
except ET.ParseError:
    pass

month_map = {
    'jan':1,'feb':2,'mar':3,'apr':4,'may':5,'jun':6,
    'jul':7,'aug':8,'sep':9,'oct':10,'nov':11,'dec':12
}

def normalize_pubdate(s: str):
    if not s:
        return None
    s = s.strip()
    s = s.replace('.', ' ')
    s = re.sub(r'\\s+', ' ', s)
    s = s.replace('/', ' ')
    s = s.split(';')[0].strip()
    s = s.split('(')[0].strip()

    # YYYY-MM-DD
    m = re.match(r'"'^('"\\d{4})-(\\d{2})-(\\d{2})"'$'"', s)
    if m:
        y, mo, d = map(int, m.groups())
        try:
            return datetime(y, mo, d).date()
        except ValueError:
            return None

    # YYYY Mon DD or YYYY Mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})(?:\\s+(\\d{1,2}))?', s)
    if m:
        y = int(m.group(1))
        mon_txt = m.group(2)[:3].lower()
        mo = month_map.get(mon_txt)
        d = int(m.group(3)) if m.group(3) else 1
        if mo:
            try:
                return datetime(y, mo, d).date()
            except ValueError:
                return None

    # YYYY
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        return datetime(int(m.group(1)), 1, 1).date()

    return None

articles = []
res = esum.get('result', {}) if isinstance(esum, dict) else {}
for uid in res.get('uids', []):
    item = res.get(uid, {})
    title = (item.get('title') or '').strip()
    journal = (item.get('source') or '').strip()
    pub_raw = (item.get('pubdate') or '').strip()
    pub_dt = normalize_pubdate(pub_raw)
    if pub_dt is None:
        continue

    # 二次过滤：仅保留最近3天（包含今天）
    if not (min_date <= pub_dt <= today):
        continue

    summary = abstract_by_pmid.get(str(uid), '').strip()
    if not summary:
        summary = 'No abstract available in source.'

    articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Depression',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_dt.strftime('%Y-%m-%d'),
        'date': '2026-03-24'
    })

# 先按 url 去重（新数据内部）
seen = set()
new_unique = []
for a in articles:
    u = a.get('url', '')
    if u and u not in seen:
        seen.add(u)
        new_unique.append(a)

# 与已有文件合并去重
existing = {'date': '2026-03-24', 'articles': []}
if out.exists():
    try:
        existing = json.loads(out.read_text(encoding='utf-8'))
    except Exception:
        existing = {'date': '2026-03-24', 'articles': []}

combined = []
seen2 = set()
for a in (existing.get('articles', []) + new_unique):
    u = a.get('url', '')
    if not u or u in seen2:
        continue
    # 补齐必需字段
    a.setdefault('title', '')
    a['summary'] = (a.get('summary') or '').strip() or 'No abstract available in source.'
    a['category'] = 'Depression'
    a['source'] = 'pubmed'
    a['journal'] = a.get('journal', '') or ''
    a['published_date'] = (a.get('published_date') or '')
    a['date'] = '2026-03-24'
    seen2.add(u)
    combined.append(a)

payload = {
    'date': '2026-03-24',
    'articles': combined
}
out.parent.mkdir(parents=True, exist_ok=True)
out.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')

print(f\"pmid_count={len(res.get('uids', [])) if isinstance(res, dict) else 0}\")
print(f\"new_filtered_count={len(new_unique)}\")
print(f\"final_count={len(combined)}\")
PY

