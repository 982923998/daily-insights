        elif ($d|test("''^'"\\\\d{4} [A-Za-z]{3}"'$")) then
          ($d|capture("''^(?<y>'"\\\\d{4}) (?<m>[A-Za-z]{3})"'$")) as $c
          | ($c.y + "-" + mon2num($c.m) + "-01")
        elif ($d|test("''^'"\\\\d{4}"'$")) then ($d + "-01-01")
        elif ($d|test("'"\\\\d{4} [A-Za-z]{3} \\\\d{1,2}\")) then
          ("'$d|capture("(?<y>'"\\\\d{4}) (?<m>[A-Za-z]{3}) (?<day>\\\\d{1,2})\")) as "'$c
          | ($c.y + "-" + mon2num($c.m) + "-" + ($c.day|tonumber|tostring|if length==1 then "0"+. else . end))
        else null end;
    ($abs[0] | map({key: .pmid, value: .summary}) | from_entries) as $absmap
    | .result as $r
    | [.uids[] as $id |
        ($r[$id]) as $it |
        ($it.pubdate | norm_date) as $pd |
        select($pd != null and $pd >= $start and $pd <= $end) |
        {
