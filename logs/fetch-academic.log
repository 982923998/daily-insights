import json, re, datetime, os
from xml.etree import ElementTree as ET

DATE_TODAY = datetime.date(2026,3,21)
WINDOW_START = DATE_TODAY - datetime.timedelta(days=3)
TARGET = '/Users/chenmayao/Projects/daily-insights/data/2026-03-21-pd.json'

with open('/tmp/pd_esummary.json','r',encoding='utf-8') as f:
    es = json.load(f)

# Parse abstracts from efetch XML by PMID
with open('/tmp/pd_efetch.xml','r',encoding='utf-8') as f:
    xml_text = f.read()
root = ET.fromstring(xml_text)
abstract_map = {}
for article in root.findall('.//PubmedArticle'):
    pmid_node = article.find('.//MedlineCitation/PMID')
    if pmid_node is None or not (pmid_node.text and pmid_node.text.strip()):
        continue
    pmid = pmid_node.text.strip()
    texts = []
    for at in article.findall('.//Abstract/AbstractText'):
        t = ''.join(at.itertext()).strip()
        if t:
            label = at.attrib.get('Label','').strip()
            if label:
                texts.append(f'{label}: {t}')
            else:
                texts.append(t)
    abstract_map[pmid] = ' '.join(texts).strip()

month_map = {
    'jan':1,'january':1,'feb':2,'february':2,'mar':3,'march':3,'apr':4,'april':4,
    'may':5,'jun':6,'june':6,'jul':7,'july':7,'aug':8,'august':8,'sep':9,'sept':9,'september':9,
    'oct':10,'october':10,'nov':11,'november':11,'dec':12,'december':12,
}

def parse_pubdate(pubdate: str):
    s = (pubdate or '').strip()
    if not s:
        return None
    s = re.sub(r'\\s+', ' ', s)
    # YYYY Mon DD
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})\\s+(\\d{1,2})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = month_map.get(m.group(2).lower()); d = int(m.group(3))
        if mon:
            try: return datetime.date(y, mon, d)
            except: return None
    # YYYY Mon
    m = re.match(r'"'^('"\\d{4})\\s+([A-Za-z]{3,9})"'$'"', s)
    if m:
        y = int(m.group(1)); mon = month_map.get(m.group(2).lower())
        if mon:
            try: return datetime.date(y, mon, 1)
            except: return None
    # YYYY-MM-DD or YYYY/MM/DD
    m = re.match(r'"'^('"\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})"'$'"', s)
    if m:
        try: return datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
        except: return None
    # YYYY-MM or YYYY/MM
    m = re.match(r'"'^('"\\d{4})[-/](\\d{1,2})"'$'"', s)
    if m:
        try: return datetime.date(int(m.group(1)), int(m.group(2)), 1)
        except: return None
    # YYYY only
    m = re.match(r'"'^('"\\d{4})"'$'"', s)
    if m:
        try: return datetime.date(int(m.group(1)), 1, 1)
        except: return None
    return None

result = es.get('result', {})
uids = result.get('uids', [])
new_articles = []
for uid in uids:
    it = result.get(uid, {})
    title = (it.get('title') or '').strip()
    journal = (it.get('source') or '').strip()
    pubdate_raw = (it.get('pubdate') or '').strip()
    pub_date = parse_pubdate(pubdate_raw)
    if pub_date is None:
        continue
    # 二次过滤：仅保留最近3天 published_date
    if not (WINDOW_START <= pub_date <= DATE_TODAY):
        continue
    summary = abstract_map.get(uid, '').strip() or 'No abstract available in source.'
    new_articles.append({
        'title': title,
        'summary': summary,
        'url': f'https://pubmed.ncbi.nlm.nih.gov/{uid}/',
        'category': 'Parkinson',
        'source': 'pubmed',
        'journal': journal,
        'published_date': pub_date.isoformat(),
        'date': DATE_TODAY.isoformat(),
    })

# 按url去重（新数据内部）
seen = set(); dedup_new = []
for a in new_articles:
    u = a.get('url','')
    if u and u not in seen:
        seen.add(u)
        dedup_new.append(a)

# 合并已有文件并去重
existing_articles = []
if os.path.exists(TARGET):
    try:
        with open(TARGET,'r',encoding='utf-8') as f:
            old = json.load(f)
            if isinstance(old, dict) and isinstance(old.get('articles'), list):
                existing_articles = old['articles']
    except Exception:
        existing_articles = []

merged = []
seen = set()
for a in dedup_new + existing_articles:
    u = a.get('url','') if isinstance(a, dict) else ''
    if not u or u in seen:
        continue
    seen.add(u)
    # ensure required fields with defaults
    aa = {
        'title': a.get('title','') if isinstance(a, dict) else '',
        'summary': a.get('summary','') if isinstance(a, dict) else '',
        'url': u,
        'category': 'Parkinson',
        'source': a.get('source','pubmed') if isinstance(a, dict) else 'pubmed',
        'journal': a.get('journal','') if isinstance(a, dict) else '',
        'published_date': a.get('published_date','') if isinstance(a, dict) else '',
        'date': DATE_TODAY.isoformat(),
    }
    if not aa['summary']:
        aa['summary'] = 'No abstract available in source.'
    if aa['source'] "'!= '"'pubmed':
        aa['source'] = 'pubmed'
    merged.append(aa)

out = {'date': DATE_TODAY.isoformat(), 'articles': merged}
os.makedirs(os.path.dirname(TARGET), exist_ok=True)
with open(TARGET,'w',encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(f'new_filtered={len(dedup_new)}')
print(f'existing={len(existing_articles)}')
print(f'written={len(merged)}')
