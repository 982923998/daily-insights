        label = (abs_node.attrib.get("Label") or "").strip()
        if label and not text.lower().startswith(label.lower() + ":"):
            parts.append(f"{label}: {text}")
        else:
            parts.append(text)
    if parts:
        abstract_by_pmid[pmid] = " ".join(parts)

result = esummary.get("result", {})
uids = result.get("uids", []) or []
new_articles = []
