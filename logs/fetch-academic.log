            existing = json.load(f)
        if isinstance(existing, dict) and isinstance(existing.get("articles"), list):
            existing_articles = existing["articles"]
    except Exception:
        existing_articles = []

merged_by_url = {}
for art in existing_articles:
    if not isinstance(art, dict):
        continue
    url = (art.get("url") or "").strip()
    if not url:
        continue
    merged_by_url[url] = art

for art in new_articles:
    merged_by_url[art["url"]] = art

merged_articles = list(merged_by_url.values())

# 清理字段，保证 summary 非空
normalized = []
for art in merged_articles:
    summary = (art.get("summary") or "").strip() or "No abstract available in source."
    normalized.append({
        "title": (art.get("title") or "").strip(),
        "summary": summary,
        "url": (art.get("url") or "").strip(),
